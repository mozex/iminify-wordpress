msgstr "Kuva lähtee automaattisesti %s."

#: includes/admin/class-media-view.php:909
#: includes/admin/class-media-view.php:910
msgid "Alt text: being written."
msgstr "Vaihtoehtoinen teksti: kirjoitetaan."

#: includes/admin/class-media-view.php:911
msgid "Alt text: written by Iminify."
msgstr "Vaihtoehtoinen teksti: Iminifyn kirjoittama."

#: includes/admin/class-media-view.php:912
msgid "Alt text: yours was kept."
msgstr "Vaihtoehtoinen teksti: omasi säilytettiin."

#: includes/admin/class-media-view.php:913
msgid "Alt text: Iminify couldn't write one for this image."
msgstr "Vaihtoehtoinen teksti: Iminify ei pystynyt kirjoittamaan sitä tälle kuvalle."

#: includes/admin/class-media-view.php:914
msgid "Alt text: not written, as the day's AI alt texts were used up."
msgstr "Vaihtoehtoinen teksti: ei kirjoitettu, koska päivittäiset tekoälyn vaihtoehtoiset tekstit oli käytetty loppuun."

#: includes/admin/class-media-view.php:940
msgid "This image carries Content Credentials, a signed record of where it came from, and its files keep them."
msgstr "Tässä kuvassa on Content Credentials -tiedot, allekirjoitettu tieto sen alkuperästä, ja sen tiedostot säilyttävät ne."

#: includes/admin/class-media-view.php:942
msgid "This image carried Content Credentials, a signed record of where it came from. The files and copies Iminify wrote leave them out, since a new file breaks their signature, and the original kept as a backup still has them."
msgstr "Tässä kuvassa oli Content Credentials -tiedot, allekirjoitettu tieto sen alkuperästä. Iminifyn kirjoittamista tiedostoista ja kopioista ne puuttuvat, koska uusi tiedosto rikkoo niiden allekirjoituksen. Varmuuskopiona säilytetyssä alkuperäisessä ne ovat yhä tallessa."

#: includes/admin/class-media-view.php:944
msgid "This image carried Content Credentials, a signed record of where it came from. The files and copies Iminify wrote leave them out, since a new file breaks their signature."
msgstr "Tässä kuvassa oli Content Credentials -tiedot, allekirjoitettu tieto sen alkuperästä. Iminifyn kirjoittamista tiedostoista ja kopioista ne puuttuvat, koska uusi tiedosto rikkoo niiden allekirjoituksen."

#: includes/admin/class-media-view.php:948
msgid "They say generative AI made it, wholly or in part."
msgstr "Niiden mukaan kuva on kokonaan tai osittain generatiivisen tekoälyn tekemä."

#: includes/admin/class-media-view.php:983
#: includes/admin/class-media-view.php:1003
msgid "WebP"
msgstr "WebP"

#: includes/admin/class-media-view.php:984
#: includes/admin/class-media-view.php:1004
msgid "AVIF"
msgstr "AVIF"

