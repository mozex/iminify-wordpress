#, php-format
msgid "Level: %s"
msgstr "Taso: %s"

#: includes/admin/class-media-view.php:1088
msgid "Size"
msgstr "Koko"

#: includes/admin/class-media-view.php:1089
msgid "Before"
msgstr "Ennen"

#: includes/admin/class-media-view.php:1090
msgid "After"
msgstr "Jälkeen"

#: includes/admin/class-media-view.php:1091
msgid "Copies"
msgstr "Kopiot"

#: includes/admin/class-media-view.php:1137
#: assets/build/audit.js:11
#: assets/build/bulk.js:25
#: assets/build/settings.js:37
msgid "Write alt text with AI"
msgstr "Kirjoita vaihtoehtoinen teksti tekoälyllä"

#: includes/admin/class-media-view.php:1137
msgid "Send a small copy of this image to write its alt text? It counts as one of your AI alt texts for the day."
msgstr "Lähetetäänkö tästä kuvasta pieni kopio vaihtoehtoisen tekstin kirjoittamista varten? Se lasketaan yhdeksi päivittäisistä tekoälyn vaihtoehtoisista teksteistäsi."

#: includes/admin/class-media-view.php:1137
msgid "Write alt text"
msgstr "Kirjoita vaihtoehtoinen teksti"

#: includes/admin/class-media-view.php:1156
msgid "Optimize again from the original at"
msgstr "Optimoi uudelleen alkuperäisestä tasolla"

#: includes/admin/class-media-view.php:1184
msgid "Connect the site to Iminify to optimize this image."
msgstr "Yhdistä sivusto Iminifyhin, niin voit optimoida tämän kuvan."

#: includes/admin/class-media-view.php:1186
msgid "No original of this image was kept, so it can't be optimized again or restored."
msgstr "Tästä kuvasta ei säilytetty alkuperäistä, joten sitä ei voi optimoida uudelleen eikä palauttaa."

#: includes/admin/class-media-view.php:1188
msgid "Optimize again at"
msgstr "Optimoi uudelleen tasolla"

#: includes/admin/class-media-view.php:1188
msgid "Optimize at"
msgstr "Optimoi tasolla"

#: includes/admin/class-media-view.php:1205
msgid "Make what it lacks"
msgstr "Tee puuttuvat tiedostot"

#: includes/admin/class-media-view.php:1214
msgid "This image has changed since Iminify optimized it, so there's nothing to restore."
msgstr "Tämä kuva on muuttunut sen jälkeen, kun Iminify optimoi sen, joten palautettavaa ei ole."

#: includes/admin/class-media-view.php:1221
msgid "Delete the copies"
msgstr "Poista kopiot"

#: includes/admin/class-media-view.php:1221
msgid "Delete this image's WebP and AVIF copies? Its pages go back to serving the JPEG or PNG."
msgstr "Poistetaanko tämän kuvan WebP- ja AVIF-kopiot? Sivuilla tarjotaan sen jälkeen taas JPEG- tai PNG-tiedosto."

#: includes/admin/class-media-view.php:1286
#: assets/build/bulk.js:23
msgid "Make the missing formats"
msgstr "Tee puuttuvat muodot"

#: includes/admin/class-media-view.php:1290
#: assets/build/bulk.js:24
msgid "Make the missing sizes"
msgstr "Tee puuttuvat koot"

#: includes/admin/class-media-view.php:1301
msgid "Send this image again to make what it lacks? This counts as one more image, and its other files stay as they are unless Iminify makes them smaller."
msgstr "Lähetetäänkö tämä kuva uudelleen, jotta siltä puuttuvat tiedostot tehdään? Se lasketaan yhdeksi kuvaksi lisää, ja sen muut tiedostot pysyvät ennallaan, ellei Iminify saa niitä pienemmiksi."

#: includes/admin/class-media-view.php:1309
msgid "Optimize this image again? Iminify makes its files again from its original, keeping their format and names, and this counts as one more image."
msgstr "Optimoidaanko tämä kuva uudelleen? Iminify tekee sen tiedostot uudelleen alkuperäisestä ja säilyttää niiden muodon ja nimet, ja tämä lasketaan yhdeksi kuvaksi lisää."

#: includes/admin/class-media-view.php:1312
msgid "Optimize this image again? Its original goes back first, and this counts as one more image."
msgstr "Optimoidaanko tämä kuva uudelleen? Sen alkuperäinen palautetaan ensin, ja tämä lasketaan yhdeksi kuvaksi lisää."

#: includes/admin/class-media-view.php:1319
msgid "Restore the original of this image? WordPress makes its sizes again, and its WebP and AVIF copies are deleted."
msgstr "Palautetaanko tämän kuvan alkuperäinen? WordPress tekee sen koot uudelleen, ja sen WebP- ja AVIF-kopiot poistetaan."

#. translators: %s: another image optimizer's name, such as Image Optimizer by Elementor.
#: includes/admin/class-media-view.php:1334
#, php-format
msgid "Optimize this image again from the original %s kept? Iminify makes its files again from it, keeping their format and names so your posts still link to them, and keeps its own backup of the original. This counts as one more image."
msgstr "Optimoidaanko tämä kuva uudelleen alkuperäisestä, jonka lisäosa %s säilytti? Iminify tekee sen tiedostot uudelleen siitä ja säilyttää niiden muodon ja nimet, jotta artikkelisi linkittävät yhä niihin, ja ottaa alkuperäisestä oman varmuuskopionsa. Tämä lasketaan yhdeksi kuvaksi lisää."

#. translators: %s: another image optimizer's name, such as Imagify.
#: includes/admin/class-media-view.php:1341
#, php-format
msgid "Optimize this image again from the original %s kept? The original goes back first and WordPress makes its sizes again, then Iminify optimizes it and keeps its own backup of the original. This counts as one more image."
msgstr "Optimoidaanko tämä kuva uudelleen alkuperäisestä, jonka lisäosa %s säilytti? Alkuperäinen palautetaan ensin ja WordPress tekee sen koot uudelleen, minkä jälkeen Iminify optimoi sen ja ottaa alkuperäisestä oman varmuuskopionsa. Tämä lasketaan yhdeksi kuvaksi lisää."

#. translators: %s: another image optimizer's name, such as Imagify.
#: includes/admin/class-media-view.php:1356
#, php-format
msgid "Restore the original of this image from what %s kept? WordPress makes its sizes again, and that plugin's backups and copies stay where they are."
msgstr "Palautetaanko tämän kuvan alkuperäinen siitä, minkä lisäosa %s säilytti? WordPress tekee sen koot uudelleen, ja kyseisen lisäosan varmuuskopiot ja kopiot jäävät paikoilleen."

#: includes/admin/class-notice.php:132
msgid "Iminify disconnected this site, so new uploads aren't optimized."
msgstr "Iminify katkaisi tämän sivuston yhteyden, joten uusia siirrettyjä kuvia ei optimoida."

#: includes/admin/class-notice.php:133
msgid "Connect it again"
msgstr "Yhdistä uudelleen"

#: includes/admin/class-notice.php:137
msgid "Iminify Image Optimizer is ready. Connect it to your Iminify account to start optimizing your images."
msgstr "Iminify Image Optimizer on valmis. Yhdistä se Iminify-tiliisi, niin voit alkaa optimoida kuviasi."

#: includes/admin/class-notice.php:138
#: assets/build/settings.js:9
msgid "Connect"
msgstr "Yhdistä"

#: includes/admin/class-notice.php:150
#: includes/admin/class-notice.php:183
msgid "Open the Iminify settings"
msgstr "Avaa Iminify-asetukset"

#: includes/admin/class-page-header.php:42
#: assets/build/audit.js:2
#: assets/build/bulk.js:2
#: assets/build/folders.js:1
#: assets/build/settings.js:37
msgid "Connected"
