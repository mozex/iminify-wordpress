msgstr "Lượt chạy đang chờ kết nối của trang web này với Iminify, và sẽ tiếp tục trong nền khi kết nối hoạt động."

#: includes/class-cli.php:628
msgid "The run goes on in the background once it stops."
msgstr "Lượt chạy sẽ tiếp tục trong nền khi plugin đó ngừng hoạt động."

#. translators: %s: the date and time the next batch opens.
#: includes/class-cli.php:639
#, php-format
