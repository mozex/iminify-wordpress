#: assets/build/settings.js:9
msgid "An upload counts as one image"
msgstr "Mỗi ảnh tải lên tính là một ảnh"

#: assets/build/settings.js:9
msgid "The sizes WordPress made of it and its WebP and AVIF copies come with it as files, never as more images."
msgstr "Các kích thước mà WordPress tạo từ ảnh và các bản chuyển đổi WebP và AVIF của ảnh đi kèm dưới dạng tệp, không bao giờ tính thêm ảnh."

#: assets/build/settings.js:9
msgid "Your originals stay on this site"
msgstr "Bản gốc của bạn ở lại trên trang web này"

#: assets/build/settings.js:9
msgid "A backup of each one is kept in the uploads folder, so any image can be put back as it was."
msgstr "Bản sao lưu của mỗi ảnh được giữ trong thư mục tải lên, nên ảnh nào cũng có thể được đưa về như cũ."

#: assets/build/settings.js:9
msgid "Your library goes when you say so"
msgstr "Thư viện của bạn chỉ được xử lý khi bạn muốn"

#: assets/build/settings.js:9
msgid "Images already in the media library wait until you start them under Media, Bulk Optimization."
msgstr "Các ảnh đã có trong thư viện media sẽ chờ cho đến khi bạn bắt đầu tại Thư viện, Tối ưu hóa hàng loạt."

#: assets/build/settings.js:9
msgid "Once you connect"
msgstr "Sau khi bạn kết nối"

#: assets/build/settings.js:9
msgid "Connect with the network's key"
msgstr "Kết nối bằng khóa của mạng"

#: assets/build/settings.js:9
msgid "Connect with a site key"
msgstr "Kết nối bằng khóa trang web"

#: assets/build/settings.js:9
msgid "Network key"
msgstr "Khóa mạng"

#: assets/build/settings.js:9
msgid "Site key"
msgstr "Khóa trang web"

#: assets/build/settings.js:9
msgid "Connect with this key"
msgstr "Kết nối bằng khóa này"

#: assets/build/settings.js:9
msgid "becomes"
msgstr "đổi thành"

#: assets/build/settings.js:9
msgid "no change"
msgstr "không thay đổi"

#. translators: %s: another image optimizer's name.
#: assets/build/settings.js:10
#, js-format
msgid "%s’s settings"
msgstr "Cài đặt của %s"

#. translators: %s: another image optimizer's name.
#: assets/build/settings.js:11
#, js-format
msgid "Iminify found %s’s settings on this site. It can set this site’s settings to match them, as far as Iminify has the same settings: the compression level, the maximum width, metadata, WebP and AVIF copies, the sizes and backups. You see what changes before anything does."
msgstr "Iminify tìm thấy cài đặt của %s trên trang web này. Iminify có thể đặt cài đặt của trang web này cho khớp với chúng, trong phạm vi Iminify có cùng cài đặt: mức nén, chiều rộng tối đa, siêu dữ liệu, bản chuyển đổi WebP và AVIF, các kích thước và bản sao lưu. Bạn sẽ thấy những gì thay đổi trước khi có bất kỳ thay đổi nào."

#. translators: %s: another image optimizer's name.
#: assets/build/settings.js:12
#, js-format
msgid "Use %s’s settings"
msgstr "Dùng cài đặt của %s"

#: assets/build/settings.js:12
msgid "No thanks"
msgstr "Không, cảm ơn"

#. translators: %s: another image optimizer's name.
#: assets/build/settings.js:13
#, js-format
msgid "This site already uses what %s’s settings match."
msgstr "Trang web này đã dùng những gì tương ứng với cài đặt của %s."

#. translators: %s: another image optimizer's name.
#: assets/build/settings.js:14
#, js-format
msgid "From %s’s settings, Iminify would set these. Nothing changes until you use them, and using them replaces the changes you haven’t saved in the settings below."
msgstr "Từ cài đặt của %s, Iminify sẽ đặt những giá trị sau. Không có gì thay đổi cho đến khi bạn dùng chúng, và việc dùng chúng sẽ thay thế các thay đổi bạn chưa lưu trong phần cài đặt bên dưới."

#. translators: %s: another image optimizer's name.
#: assets/build/settings.js:15
#, js-format
msgid "From %s’s settings, Iminify would set these. Nothing changes until you use them."
msgstr "Từ cài đặt của %s, Iminify sẽ đặt những giá trị sau. Không có gì thay đổi cho đến khi bạn dùng chúng."

#. translators: %s: another image optimizer's name.
#: assets/build/settings.js:16
#, js-format
msgid "None of %s’s settings has a match in Iminify, so this site keeps its own."
msgstr "Không có cài đặt nào của %s tương ứng trong Iminify, nên trang web này giữ cài đặt của riêng mình."

#: assets/build/settings.js:16
msgid "Use these settings"
msgstr "Dùng các cài đặt này"

#: assets/build/settings.js:16
msgid "OK"
msgstr "Đồng ý"

#: assets/build/settings.js:16
msgid "Open the network's Iminify settings"
msgstr "Mở cài đặt Iminify của mạng"

#: assets/build/settings.js:16
msgid "The network's connection"
msgstr "Kết nối của mạng"

#: assets/build/settings.js:16
msgid "This is the network's main site, so it uses the network's connection to Iminify. A super admin connects and disconnects the network in the network admin."
msgstr "Đây là trang web chính của mạng, nên trang web dùng kết nối của mạng với Iminify. Quản trị viên cấp cao kết nối và ngắt kết nối mạng trong trang Quản trị mạng."

#: assets/build/settings.js:16
msgid "This is the network's main site, so it uses the network's connection to Iminify, which isn't made yet. A super admin connects the network in the network admin, and every site joins it by itself."
msgstr "Đây là trang web chính của mạng, nên trang web dùng kết nối của mạng với Iminify, nhưng kết nối này chưa được thiết lập. Quản trị viên cấp cao kết nối mạng trong trang Quản trị mạng, và mỗi trang web sẽ tự tham gia."

#: assets/build/settings.js:16
msgid "The network's sites"
msgstr "Các trang web trong mạng"

#: assets/build/settings.js:16
msgid "This key was made for a single site, so the network's sites can't join with it. Disconnect, then connect the network again, or make a key under Settings, Sites on iminify.com with This is a multisite network ticked."
msgstr "Khóa này được tạo cho một trang web đơn lẻ, nên các trang web trong mạng không thể tham gia bằng khóa này. Hãy ngắt kết nối, rồi kết nối lại mạng, hoặc tạo một khóa trong Settings, Sites trên iminify.com với tùy chọn This is a multisite network được đánh dấu."

#: assets/build/settings.js:16
msgid "Each site of the network joins by itself the first time it needs Iminify, with a key of its own, and starts with the main site's settings. Each counts as a site of its own on your account. A site disconnected on its own page, or under Settings, Sites on iminify.com, doesn't join again by itself."
msgstr "Mỗi trang web trong mạng tự tham gia vào lần đầu tiên cần đến Iminify, với khóa riêng, và bắt đầu với cài đặt của trang web chính. Mỗi trang web được tính là một trang web riêng trong tài khoản của bạn. Trang web bị ngắt kết nối trên trang cài đặt của chính nó, hoặc trong Settings, Sites trên iminify.com, sẽ không tự tham gia lại."

#: assets/build/settings.js:16
msgid "Each site's settings are on its own Settings, Iminify page. The images in themes and other folders are the main site's to optimize, once for the whole network."
msgstr "Cài đặt của mỗi trang web nằm ở trang Cài đặt, Iminify của trang web đó. Ảnh trong giao diện và các thư mục khác do trang web chính tối ưu hóa, một lần cho toàn bộ mạng."

#: assets/build/settings.js:16
msgid "The main site's settings"
msgstr "Cài đặt của trang web chính"

#: assets/build/settings.js:16
msgid "The main site's other folders"
msgstr "Thư mục khác của trang web chính"

#: assets/build/settings.js:16
msgid "How a network connects"
msgstr "Cách mạng được kết nối"

#: assets/build/settings.js:16
#: assets/build/settings.js:17
msgid "Join the network"
msgstr "Tham gia mạng"

#. translators: %s: the network's name.
#: assets/build/settings.js:17
#, js-format
msgid "%s is connected to Iminify. This site can join it with a key of its own, and counts as a site of its own on the account."
msgstr "%s đã được kết nối với Iminify. Trang web này có thể tham gia mạng đó bằng khóa riêng, và được tính là một trang web riêng trong tài khoản."

#: assets/build/settings.js:17
msgid "In WordPress’s rewrite rules:"
msgstr "Trong các quy tắc viết lại của WordPress:"

#: assets/build/settings.js:17
msgid "In <file />:"
msgstr "Trong <file />:"

#. translators: %s: another image optimizer's name.
#: assets/build/settings.js:18
#, js-format
msgid "Take %s’s rule out of WordPress’s rewrite rules? Every other rule stays."
msgstr "Gỡ quy tắc của %s khỏi các quy tắc viết lại của WordPress? Mọi quy tắc khác vẫn được giữ."

#. translators: %s: another image optimizer's name.
#: assets/build/settings.js:19
#, js-format
msgid "Remove %s’s lines from this file? Everything else in it stays as it is. Nginx keeps them until it is reloaded, so reload it afterwards."
msgstr "Xóa các dòng của %s khỏi tệp này? Mọi nội dung khác trong tệp vẫn giữ nguyên. Nginx vẫn giữ các dòng này cho đến khi được tải lại, nên hãy tải lại Nginx sau đó."

#. translators: %s: another image optimizer's name.
#: assets/build/settings.js:20
#, js-format
msgid "Remove %s’s lines from this file? Everything else in it stays as it is."
msgstr "Xóa các dòng của %s khỏi tệp này? Mọi nội dung khác trong tệp vẫn giữ nguyên."

#. translators: %s: the first line of another plugin's block, such as "# BEGIN EWWWIO".
#: assets/build/settings.js:21
#, js-format
msgid "<file /> holds the line %s, but the block it starts has no end of its own, or runs across another block, so the plugin leaves the file alone. Remove the block’s lines by hand."
msgstr "<file /> chứa dòng %s, nhưng khối mà dòng này mở đầu không có dòng kết thúc riêng, hoặc chồng lên một khối khác, nên plugin không động đến tệp. Hãy xóa các dòng của khối đó thủ công."

#: assets/build/settings.js:21
msgid "The plugin can’t write to <file />. Remove these lines from it by hand, then reload Nginx."
msgstr "Plugin không thể ghi vào <file />. Hãy xóa các dòng này khỏi tệp thủ công, rồi tải lại Nginx."

#: assets/build/settings.js:21
msgid "The plugin can’t write to <file />. Remove these lines from it by hand."
msgstr "Plugin không thể ghi vào <file />. Hãy xóa các dòng này khỏi tệp thủ công."

#: assets/build/settings.js:21
msgid "Every site of the network shares these lines, so someone who can manage the network removes them, from the network admin’s Iminify settings."
msgstr "Mọi trang web trong mạng dùng chung các dòng này, nên người có quyền quản lý mạng sẽ xóa chúng, từ cài đặt Iminify trong trang Quản trị mạng."

#: assets/build/settings.js:21
msgid "Every site of the network shares these lines, so a super admin removes them, on this page."
msgstr "Mọi trang web trong mạng dùng chung các dòng này, nên quản trị viên cấp cao sẽ xóa chúng, trên trang này."

#. translators: %s: another image optimizer's name.
#: assets/build/settings.js:22
#, js-format
msgid "%s’s rewrite rule"
msgstr "Quy tắc viết lại của %s"

#. translators: %s: another image optimizer's name.
#: assets/build/settings.js:23
#, js-format
msgid "%s’s rules"
msgstr "Các quy tắc của %s"

#: assets/build/settings.js:23
msgid "Rules another optimizer left"
msgstr "Quy tắc do plugin tối ưu hóa khác để lại"

#: assets/build/settings.js:23
msgid "The rules another optimizer left are gone."
msgstr "Các quy tắc do plugin tối ưu hóa khác để lại đã được xóa."

#: assets/build/settings.js:23
msgid "An image optimizer you had before left these rules behind when it was switched off. Iminify never removes another plugin’s rules by itself."
msgstr "Một plugin tối ưu hóa ảnh bạn dùng trước đây đã để lại các quy tắc này khi bị tắt. Iminify không bao giờ tự xóa quy tắc của plugin khác."

#. translators: %d: how many images.
#: assets/build/settings.js:24
#, js-format
msgid "%d image is being optimized."
msgid_plural "%d images are being optimized."
msgstr[0] "%d ảnh đang được tối ưu hóa."

#. translators: %d: how many images.
#: assets/build/settings.js:25
#, js-format
msgid "%d image is waiting for the next batch."
msgid_plural "%d images are waiting for the next batch."
msgstr[0] "%d ảnh đang chờ đợt tiếp theo."

#. translators: %d: how many images.
#: assets/build/settings.js:26
#, js-format
msgid "%d image is waiting for the site to be connected. It goes out by itself once it is."
msgid_plural "%d images are waiting for the site to be connected. They go out by themselves once it is."
msgstr[0] "%d ảnh đang chờ trang web được kết nối. Ảnh sẽ tự động được gửi đi khi trang web đã kết nối."

#. translators: %s: the date and time the next batch opens.
#: assets/build/settings.js:27
#, js-format
msgid "The next batch opens on %s. New uploads go first, by themselves."
msgstr "Đợt tiếp theo mở vào %s. Ảnh mới tải lên sẽ tự động được gửi trước."

#: assets/build/settings.js:27
msgid "Queue"
msgstr "Hàng đợi"

#: assets/build/settings.js:27
msgid "The server is low on disk space, so Iminify has stopped optimizing images here. Free some up, then optimize the images marked \"Not optimized\"."
msgstr "Máy chủ sắp hết dung lượng ổ đĩa, nên Iminify đã ngừng tối ưu hóa ảnh tại đây. Hãy giải phóng bớt dung lượng, rồi tối ưu hóa các ảnh được đánh dấu \"Chưa tối ưu hóa\"."

#: assets/build/settings.js:27
msgid "Your server answered with an error once the rules were in, so the plugin took them out again and your images load as before. Ask your host whether .htaccess files may set rewrite rules and file types, or choose picture tags."
msgstr "Máy chủ của bạn trả về lỗi sau khi các quy tắc được thêm vào, nên plugin đã gỡ chúng ra và ảnh của bạn tải như trước. Hãy hỏi nhà cung cấp hosting xem tệp .htaccess có được phép đặt quy tắc viết lại và kiểu tệp không, hoặc chọn thẻ picture."

#. translators: %s: the date and time of the last check.
#: assets/build/settings.js:28
#, js-format
msgid "Your server sends the WebP and AVIF copies. Checked %s."
msgstr "Máy chủ của bạn đang phân phát các bản chuyển đổi WebP và AVIF. Kiểm tra lần cuối: %s."

#. translators: %s: the date and time of the last check.
#: assets/build/settings.js:30
#, js-format
msgid "Your server still sends the originals: something answers for images before these rules are read, often Nginx in front of Apache. Add the Nginx lines below to its configuration, or choose picture tags. Checked %s."
msgstr "Máy chủ của bạn vẫn phân phát bản gốc: một thành phần nào đó phản hồi yêu cầu ảnh trước khi các quy tắc này được đọc, thường là Nginx đứng trước Apache. Hãy thêm các dòng Nginx bên dưới vào cấu hình của Nginx, hoặc chọn thẻ picture. Kiểm tra lần cuối: %s."

#. translators: %s: the date and time of the last check.
#: assets/build/settings.js:32
#, js-format
msgid "Your server still sends the originals. Add the lines below to its configuration and reload Nginx, then save again. Checked %s."
msgstr "Máy chủ của bạn vẫn phân phát bản gốc. Hãy thêm các dòng bên dưới vào cấu hình của máy chủ và tải lại Nginx, rồi lưu lại lần nữa. Kiểm tra lần cuối: %s."

#. translators: %s: the date and time of the last check.
#: assets/build/settings.js:34
#, js-format
msgid "Cloudflare answered with the original, so a visitor may never get a copy through these rules. Choose picture tags, which work behind Cloudflare. Checked %s."
msgstr "Cloudflare đã phản hồi bằng bản gốc, nên khách truy cập có thể không bao giờ nhận được bản chuyển đổi qua các quy tắc này. Hãy chọn thẻ picture, cách này hoạt động phía sau Cloudflare. Kiểm tra lần cuối: %s."

#. translators: %s: the date and time of the last check.
#: assets/build/settings.js:35
#, js-format
msgid "The plugin couldn't ask your site for an image to see whether the rules work, which happens when a site can't reach its own address. Open one of your images with a browser's developer tools: its type should read image/avif or image/webp. Tried %s."
msgstr "Plugin không thể yêu cầu một ảnh từ trang web của bạn để xem các quy tắc có hoạt động không, điều này xảy ra khi trang web không truy cập được địa chỉ của chính nó. Hãy mở một ảnh của bạn bằng công cụ dành cho nhà phát triển của trình duyệt: kiểu của ảnh phải là image/avif hoặc image/webp. Lần thử gần nhất: %s."

#: assets/build/settings.js:35
msgid "The rules are in <file />."
msgstr "Các quy tắc nằm trong <file />."

#. translators: <file /> is the file's path, <begin /> and <end /> the first and last lines of the plugin's block in it (such as "# BEGIN Iminify"), <closing /> the line </IfModule>.
#: assets/build/settings.js:36
msgid "<file /> holds the line <begin /> without its <end /> line, so the plugin leaves the file alone. Put the line <end /> back after the block’s last <closing />, or delete every line of the block, then save again."
msgstr "<file /> chứa dòng <begin /> nhưng thiếu dòng <end />, nên plugin không động đến tệp. Hãy đặt lại dòng <end /> sau dòng <closing /> cuối cùng của khối, hoặc xóa mọi dòng của khối, rồi lưu lại lần nữa."

#: assets/build/settings.js:36
msgid "Your uploads folder isn't inside the folder that holds the site's .htaccess file, so no rule there can name it. Choose picture tags."
msgstr "Thư mục tải lên của bạn không nằm trong thư mục chứa tệp .htaccess của trang web, nên không quy tắc nào ở đó có thể trỏ tới thư mục này. Hãy chọn thẻ picture."

#: assets/build/settings.js:36
msgid "There’s no <file /> yet. Create it with these lines, then save again."
msgstr "Chưa có <file />. Hãy tạo tệp với các dòng này, rồi lưu lại lần nữa."

#: assets/build/settings.js:36
msgid "<file /> doesn’t turn on rewriting, so the plugin leaves it alone. If your server reads rewrite rules there, paste these lines into it, then save again."
msgstr "<file /> không bật tính năng viết lại (rewrite), nên plugin không động đến tệp. Nếu máy chủ của bạn đọc quy tắc viết lại ở đó, hãy dán các dòng này vào tệp, rồi lưu lại lần nữa."

#: assets/build/settings.js:36
msgid "The plugin can’t write to <file />. Paste these lines into it, above the rules WordPress gave the network, then save again."
msgstr "Plugin không thể ghi vào <file />. Hãy dán các dòng này vào tệp, phía trên các quy tắc mà WordPress đã cung cấp cho mạng, rồi lưu lại lần nữa."

#: assets/build/settings.js:36
msgid "The plugin can’t write to <file />. Paste these lines at its end, then save again."
msgstr "Plugin không thể ghi vào <file />. Hãy dán các dòng này vào cuối tệp, rồi lưu lại lần nữa."

#: assets/build/settings.js:36
msgid "Your server reads neither .htaccess files nor Nginx's configuration, so the plugin has no rules to give it. Choose picture tags."
msgstr "Máy chủ của bạn không đọc tệp .htaccess lẫn cấu hình của Nginx, nên plugin không có quy tắc nào để cung cấp. Hãy chọn thẻ picture."

#: assets/build/settings.js:36
msgid "Your site runs on Nginx, which doesn't read .htaccess. Put the first lines at the top of the site's server block, before any if or rewrite, and the location above any other location for images, then reload Nginx. Copy into the location any expires, Cache-Control or add_header lines your images need, since its add_header replaces the server block's:"
msgstr "Trang web của bạn chạy trên Nginx, vốn không đọc .htaccess. Hãy đặt các dòng đầu tiên ở đầu khối server của trang web, trước mọi lệnh if hoặc rewrite, và đặt khối location phía trên mọi location khác dành cho ảnh, rồi tải lại Nginx. Hãy sao chép vào location mọi dòng expires, Cache-Control hoặc add_header mà ảnh của bạn cần, vì add_header của location sẽ thay thế add_header của khối server:"

#: assets/build/settings.js:36
msgid "For Nginx, put the first lines at the top of the site's server block, before any if or rewrite, and the location above any other location for images, then reload Nginx. Copy into the location any expires, Cache-Control or add_header lines your images need, since its add_header replaces the server block's:"
msgstr "Với Nginx, hãy đặt các dòng đầu tiên ở đầu khối server của trang web, trước mọi lệnh if hoặc rewrite, và đặt khối location phía trên mọi location khác dành cho ảnh, rồi tải lại Nginx. Hãy sao chép vào location mọi dòng expires, Cache-Control hoặc add_header mà ảnh của bạn cần, vì add_header của location sẽ thay thế add_header của khối server:"

#. translators: %s: the folders the rules cover, separated by commas.
#: assets/build/settings.js:37
#, js-format
msgid "They cover: %s."
msgstr "Các quy tắc áp dụng cho: %s."

#: assets/build/settings.js:37
msgid "They serve any WebP or AVIF copy named after an image beside it, so a copy another optimizer left there is served too until Iminify makes its own. Iminify never deletes another plugin’s copies."
msgstr "Các quy tắc phân phát bất kỳ bản chuyển đổi WebP hoặc AVIF nào được đặt tên theo một ảnh và nằm cạnh ảnh đó, nên bản chuyển đổi do plugin tối ưu hóa khác để lại ở đó cũng được phân phát cho đến khi Iminify tự tạo bản chuyển đổi. Iminify không bao giờ xóa bản chuyển đổi của plugin khác."

#: assets/build/settings.js:37
msgid "Cloudflare answers for your site. It keeps one version of each image whatever the browser reads, so a browser that can't show AVIF could get the AVIF copy. Choose picture tags, which work behind any CDN."
msgstr "Cloudflare đang phản hồi thay cho trang web của bạn. Cloudflare giữ một phiên bản của mỗi ảnh bất kể trình duyệt đọc được định dạng nào, nên trình duyệt không hiển thị được AVIF có thể nhận bản chuyển đổi AVIF. Hãy chọn thẻ picture, cách này hoạt động phía sau mọi CDN."

#: assets/build/settings.js:37
msgid "WP Offload Media serves your images from its bucket, which these rules never reach, so those keep their originals. With its “Remove Local Media” on, the rules serve nothing."
msgstr "WP Offload Media phân phát ảnh của bạn từ bucket của plugin, nơi các quy tắc này không bao giờ chạm tới, nên các ảnh đó vẫn dùng bản gốc. Khi bật “Remove Local Media” của plugin, các quy tắc không phân phát gì cả."

#: assets/build/settings.js:37
msgid "Also reaches the images in raw HTML, page builders and your theme's own markup, the backgrounds set in the page itself, and the images in the folders you chose, by reading each page as it's sent. A background set in a stylesheet file keeps its original. A page your cache hasn't kept takes a little longer."
msgstr "Còn áp dụng cho ảnh trong HTML thuần, trình dựng trang và mã HTML riêng của giao diện, ảnh nền đặt ngay trong trang, và ảnh trong các thư mục bạn đã chọn, bằng cách đọc từng trang khi trang được gửi đi. Ảnh nền đặt trong tệp CSS vẫn dùng bản gốc. Trang chưa được bộ nhớ đệm lưu sẽ tải lâu hơn một chút."

#: assets/build/settings.js:37
msgid "Your pages stay as they are, and your server sends the WebP or AVIF copy in place of the image to each browser that reads it. That reaches every image in the uploads folder and the folders you chose, backgrounds in stylesheet files too. Needs rules in your server’s configuration, written for you on Apache, and behind a CDN, one that keeps a version of each image per format."
msgstr "Các trang của bạn giữ nguyên, và máy chủ của bạn gửi bản chuyển đổi WebP hoặc AVIF thay cho ảnh tới mỗi trình duyệt đọc được định dạng đó. Cách này áp dụng cho mọi ảnh trong thư mục tải lên và các thư mục bạn đã chọn, kể cả ảnh nền trong tệp CSS. Cần có quy tắc trong cấu hình máy chủ của bạn, được viết sẵn cho bạn trên Apache, và nếu dùng CDN thì CDN phải giữ một phiên bản của mỗi ảnh cho từng định dạng."

#: assets/build/settings.js:37
msgid "Your pages stay as they are: the copies are made, but no page names them."
msgstr "Các trang của bạn giữ nguyên: các bản chuyển đổi vẫn được tạo, nhưng không trang nào dùng đến."

#: assets/build/settings.js:37
msgid "For the images in your posts and those your theme shows through WordPress. Each page is the same for every visitor, so page caches and CDNs keep working, and a browser that reads neither format gets the original."
msgstr "Dành cho ảnh trong bài viết của bạn và những ảnh giao diện hiển thị thông qua WordPress. Mỗi trang giống nhau với mọi khách truy cập, nên bộ nhớ đệm trang và CDN vẫn hoạt động bình thường, và trình duyệt không đọc được định dạng nào trong hai định dạng sẽ nhận bản gốc."

#: assets/build/settings.js:37
msgid "Optimization"
msgstr "Tối ưu hóa"

#: assets/build/settings.js:37
msgid "These settings are kept with the site on iminify.com, which applies them to every image the site sends."
msgstr "Các cài đặt này được lưu cùng trang web trên iminify.com, nơi áp dụng chúng cho mọi ảnh mà trang web gửi đến."

#: assets/build/settings.js:37
msgid "Send each image to Iminify as it is uploaded."
msgstr "Gửi mỗi ảnh tới Iminify ngay khi được tải lên."

#: assets/build/settings.js:37
msgid "A WebP copy of every size, served to browsers that read it. A copy larger than its image isn't kept."
msgstr "Một bản chuyển đổi WebP cho mỗi kích thước, được phân phát tới các trình duyệt đọc được định dạng này. Bản chuyển đổi nào lớn hơn ảnh của nó sẽ không được giữ."

#: assets/build/settings.js:37
msgid "An AVIF copy of every size too: usually smaller than WebP, and slower to make."
msgstr "Thêm một bản chuyển đổi AVIF cho mỗi kích thước: thường nhỏ hơn WebP, và tạo chậm hơn."

#: assets/build/settings.js:37
msgid "Any width"
msgstr "Chiều rộng bất kỳ"

#: assets/build/settings.js:37
msgid "Shrinks a wider main image to this width. Leave it empty to keep each image's width."
msgstr "Ảnh chính rộng hơn sẽ được thu nhỏ về chiều rộng này. Để trống để giữ nguyên chiều rộng của từng ảnh."

#: assets/build/settings.js:37
msgid "Fits the main image under this size. Leave it empty for no limit."
msgstr "Giảm dung lượng ảnh chính xuống dưới giá trị này. Để trống nếu không muốn giới hạn."

#: assets/build/settings.js:37
msgid "Keeps each image's EXIF data, such as the camera and the place it was taken. Off removes it."
msgstr "Giữ dữ liệu EXIF của mỗi ảnh, chẳng hạn máy ảnh và địa điểm chụp. Tắt sẽ xóa dữ liệu này."

#: assets/build/settings.js:37
msgid "Describes each image that has no alt text. An alt text you wrote is never replaced. A small copy of the image goes to Anthropic's AI, and each one counts against your AI alt texts for the day."
msgstr "Mô tả mỗi ảnh chưa có văn bản thay thế. Văn bản thay thế do bạn viết sẽ không bao giờ bị ghi đè. Một bản thu nhỏ của ảnh được gửi tới AI của Anthropic, và mỗi ảnh tính vào số lượt văn bản thay thế AI trong ngày của bạn."

#: assets/build/settings.js:37
msgid "Language of the alt text"
msgstr "Ngôn ngữ của văn bản thay thế"

#: assets/build/settings.js:37
msgid "Optimize every size"
msgstr "Tối ưu hóa mọi kích thước"

#: assets/build/settings.js:37
msgid "Every size WordPress makes of an upload. Turn it off to pick the sizes."
msgstr "Mọi kích thước mà WordPress tạo từ một ảnh tải lên. Tắt để chọn từng kích thước."

#: assets/build/settings.js:37
msgid "On this site"
msgstr "Trên trang web này"

#: assets/build/settings.js:37
msgid "Kept in the uploads folder under iminify-backup, so any image can be restored as it was."
msgstr "Được giữ trong thư mục iminify-backup bên trong thư mục tải lên, nên ảnh nào cũng có thể được khôi phục như cũ."

#: assets/build/settings.js:37
msgid "WebP and AVIF on your pages"
msgstr "WebP và AVIF trên các trang của bạn"

#: assets/build/settings.js:37
msgid "Serve them with picture tags"
msgstr "Phân phát bằng thẻ picture"

#: assets/build/settings.js:37
msgid "Serve them on the whole page"
msgstr "Phân phát trên toàn trang"

#: assets/build/settings.js:37
msgid "Serve them through server rules"
msgstr "Phân phát qua quy tắc máy chủ"

#: assets/build/settings.js:37
msgid "Don't change the pages"
msgstr "Không thay đổi các trang"

#: assets/build/settings.js:37
msgid "Add the width, height and alt text images lack"
msgstr "Bổ sung chiều rộng, chiều cao và văn bản thay thế mà ảnh còn thiếu"

#: assets/build/settings.js:37
msgid "Where a page’s markup leaves them out of an image from your media library, the plugin adds its width and height, so the page doesn’t jump as it loads, and the alt text it has in the library, as each page is sent. An alt text left empty on purpose stays empty."
msgstr "Khi mã HTML của một trang thiếu các thông tin này ở một ảnh từ thư viện media, plugin sẽ bổ sung chiều rộng và chiều cao của ảnh, để trang không bị giật khi tải, cùng văn bản thay thế mà ảnh có trong thư viện, khi mỗi trang được gửi đi. Văn bản thay thế được cố ý để trống sẽ vẫn để trống."

#: assets/build/settings.js:37
msgid "When you delete the plugin"
msgstr "Khi bạn xóa plugin"

#: assets/build/settings.js:37
msgid "Also delete the WebP and AVIF copies"
msgstr "Đồng thời xóa các bản chuyển đổi WebP và AVIF"

#: assets/build/settings.js:37
msgid "A page your cache kept with picture tags would show a broken image until the cache is cleared."
msgstr "Trang mà bộ nhớ đệm đã lưu cùng thẻ picture sẽ hiển thị ảnh bị hỏng cho đến khi bộ nhớ đệm được xóa."

#: assets/build/settings.js:37
msgid "Also delete the backups"
msgstr "Đồng thời xóa các bản sao lưu"

#: assets/build/settings.js:37
msgid "They're the only originals of the images Iminify optimized, so those images can't be restored afterwards. With the copies deleted too, installing the plugin again would optimize those images a second time."
msgstr "Đây là bản gốc duy nhất của các ảnh mà Iminify đã tối ưu hóa, nên sau đó không thể khôi phục các ảnh đó. Nếu xóa cả các bản chuyển đổi, việc cài lại plugin sẽ tối ưu hóa các ảnh đó lần thứ hai."

#: assets/build/settings.js:37
msgid "Save changes"
msgstr "Lưu thay đổi"

#: assets/build/settings.js:37
msgid "Unsaved changes"
msgstr "Thay đổi chưa lưu"

#: assets/build/settings.js:37
msgid "Needs attention"
msgstr "Cần chú ý"

#: assets/build/settings.js:37
msgid "The network is connected."
msgstr "Mạng đã được kết nối."

#: assets/build/settings.js:37
msgid "The site is connected."
msgstr "Trang web đã được kết nối."

#: assets/build/settings.js:37
msgid "The connection wasn't approved in time, or was turned down. Press Connect the network to try again."
msgstr "Kết nối không được phê duyệt kịp thời, hoặc đã bị từ chối. Hãy nhấn Kết nối mạng để thử lại."

#: assets/build/settings.js:37
msgid "The connection wasn't approved in time, or was turned down. Press Connect to try again."
msgstr "Kết nối không được phê duyệt kịp thời, hoặc đã bị từ chối. Hãy nhấn Kết nối để thử lại."

#: assets/build/settings.js:37
msgid "The network is disconnected here, but its key couldn't be stopped on Iminify. Disconnect it under Settings, Sites on iminify.com too."
msgstr "Mạng đã được ngắt kết nối tại đây, nhưng không thể thu hồi khóa của mạng trên Iminify. Hãy ngắt kết nối mạng trong Settings, Sites trên iminify.com nữa."

#: assets/build/settings.js:37
msgid "The site is disconnected here, but its key couldn't be stopped on Iminify. Disconnect it under Settings, Sites on iminify.com too."
msgstr "Trang web đã được ngắt kết nối tại đây, nhưng không thể thu hồi khóa của trang web trên Iminify. Hãy ngắt kết nối trang web trong Settings, Sites trên iminify.com nữa."

#: assets/build/settings.js:37
msgid "The site joined the network."
msgstr "Trang web đã tham gia mạng."

#: assets/build/settings.js:37
msgid "Move the connection here"
msgstr "Chuyển kết nối về đây"

#: assets/build/settings.js:37
msgid "Connect this copy as its own site"
msgstr "Kết nối bản sao này như một trang web riêng"

#. translators: %s: another image optimizer's name.
#: assets/build/settings.js:38
#, js-format
msgid "This site now uses %s’s settings."
msgstr "Trang web này hiện dùng cài đặt của %s."

#: assets/build/settings.js:38
msgid "The lines are removed. Reload Nginx so it stops serving them."
msgstr "Đã xóa các dòng. Hãy tải lại Nginx để Nginx ngừng áp dụng chúng."

#: assets/build/settings.js:38
msgid "The lines are removed."
msgstr "Đã xóa các dòng."

#: assets/build/settings.js:38
msgid "Settings saved."
msgstr "Đã lưu mọi cài đặt."

#: assets/build/settings.js:38
msgid "The images waiting are on their way."
msgstr "Các ảnh đang chờ đang được gửi đi."

#: assets/build/settings.js:38
msgid "Your account's images for the day are still used up."
msgstr "Tài khoản của bạn vẫn hết lượt ảnh trong ngày."

#: assets/build/settings.js:38
msgid "Iminify disconnected the network, so new uploads on its sites aren't optimized. Connect it again to carry on."
msgstr "Iminify đã ngắt kết nối mạng, nên ảnh mới tải lên trên các trang web trong mạng không được tối ưu hóa. Hãy kết nối lại để tiếp tục."

#: assets/build/settings.js:38
msgid "Iminify disconnected the network, so new uploads aren't optimized. A super admin connects it again in the network admin."
msgstr "Iminify đã ngắt kết nối mạng, nên ảnh mới tải lên không được tối ưu hóa. Quản trị viên cấp cao cần kết nối lại mạng trong trang Quản trị mạng."

#: assets/build/settings.js:38
msgid "Iminify disconnected this site, so new uploads aren't optimized. Join the network again, or connect the site on its own, to carry on."
msgstr "Iminify đã ngắt kết nối trang web này, nên ảnh mới tải lên không được tối ưu hóa. Hãy tham gia lại mạng, hoặc kết nối riêng trang web, để tiếp tục."

#: assets/build/settings.js:38
msgid "Iminify disconnected this site, so new uploads aren't optimized. Connect it again to carry on."
msgstr "Iminify đã ngắt kết nối trang web này, nên ảnh mới tải lên không được tối ưu hóa. Hãy kết nối lại để tiếp tục."
