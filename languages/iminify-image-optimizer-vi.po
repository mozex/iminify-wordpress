#: includes/class-cli.php:428
msgid "No bulk run is going."
msgstr "Không có lượt chạy hàng loạt nào đang diễn ra."

#: includes/class-cli.php:432
msgid "Stopped."
msgstr "Đã dừng."

#: includes/class-cli.php:497
msgid "The run goes on in the background. See how far it got with: wp iminify status"
msgstr "Lượt chạy tiếp tục trong nền. Xem tiến độ bằng lệnh: wp iminify status"

#: includes/class-cli.php:518
msgid "Bulk run"
msgstr "Chạy hàng loạt"

#. translators: %s: the date and time the alt texts come back.
#: includes/class-cli.php:612
#, php-format
msgid "The account's AI alt texts for the day are used up. The run goes on in the background when they come back on %s."
msgstr "Tài khoản đã dùng hết lượt văn bản thay thế AI trong ngày. Lượt chạy sẽ tiếp tục trong nền khi có lượt mới vào %s."

#: includes/class-cli.php:620
#: includes/class-cli.php:647
