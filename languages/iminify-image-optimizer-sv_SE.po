msgstr "Skanna"

#. translators: %s: how many seconds are left before the next scan.
#: assets/build/audit.js:3
#, js-format
msgid "You can scan again in %s second."
msgid_plural "You can scan again in %s seconds."
msgstr[0] "Du kan skanna igen om %s sekund."
msgstr[1] "Du kan skanna igen om %s sekunder."

#. translators: %s: how many page scans the account used today.
#: assets/build/audit.js:4
#, js-format
msgid "%s page scan used today. Each audit counts as one."
msgid_plural "%s page scans used today. Each audit counts as one."
msgstr[0] "%s sidskanning använd idag. Varje granskning räknas som en."
msgstr[1] "%s sidskanningar använda idag. Varje granskning räknas som en."

#. translators: 1: how many page scans are left today, 2: how many the account has a day.
#: assets/build/audit.js:5
#, js-format
msgid "%1$s of %2$s page scan left today. Each audit counts as one."
msgid_plural "%1$s of %2$s page scans left today. Each audit counts as one."
msgstr[0] "%1$s av %2$s sidskanning kvar idag. Varje granskning räknas som en."
msgstr[1] "%1$s av %2$s sidskanningar kvar idag. Varje granskning räknas som en."

#. translators: %s: the date and time more page scans come.
#: assets/build/audit.js:6
#, js-format
msgid "Your page scans for today are used up. More come on %s."
msgstr "Dina sidskanningar för idag är slut. Fler kommer den %s."

#: assets/build/audit.js:6
msgid "Your page scans for today are used up."
msgstr "Dina sidskanningar för idag är slut."

#: assets/build/audit.js:6
msgid "Recent audits"
msgstr "Senaste granskningar"

#: assets/build/audit.js:6
msgid "Images on the page"
msgstr "Bilder på sidan"

#: assets/build/audit.js:6
msgid "Choose a page and press Scan. Iminify lists every image on it, each beside the image in your library it is, with what is worth fixing."
msgstr "Välj en sida och tryck på Skanna. Iminify listar varje bild på den, var och en bredvid motsvarande bild i ditt bibliotek, med det som är värt att åtgärda."

#: assets/build/audit.js:6
msgid "Iminify is opening the page and measuring its images. This usually takes less than a minute, and the page shows them as soon as they’re in."
msgstr "Iminify öppnar sidan och mäter dess bilder. Det tar oftast mindre än en minut, och sidan visar dem så snart de är klara."

#: assets/build/audit.js:6
msgid "The page showed no images."
msgstr "Sidan visade inga bilder."

#. translators: 1: how many images the page showed, 2: how many of them have something to fix.
#: assets/build/audit.js:7
#, js-format
msgid "%1$s image on the page, %2$s with something to fix."
msgid_plural "%1$s images on the page, %2$s with something to fix."
msgstr[0] "%1$s bild på sidan, %2$s med något att åtgärda."
msgstr[1] "%1$s bilder på sidan, %2$s med något att åtgärda."

#: assets/build/audit.js:7
msgid "Nothing to fix: every image on this page is sized, loaded and described well."
msgstr "Inget att åtgärda: varje bild på den här sidan har rätt storlek, läses in rätt och har en beskrivning."

#: assets/build/audit.js:7
msgid "Hide the images with nothing to fix"
msgstr "Dölj bilderna som inte har något att åtgärda"

#. translators: %s: how many images have nothing to fix.
#: assets/build/audit.js:8
#, js-format
msgid "Show %s image with nothing to fix"
msgid_plural "Show %s images with nothing to fix"
msgstr[0] "Visa %s bild utan något att åtgärda"
msgstr[1] "Visa %s bilder utan något att åtgärda"

#. translators: %s: how many images.
#: assets/build/audit.js:9
#, js-format
msgid "%s image from your media library is on this page without its width and height, or without the alt text it has in the library. The plugin can add what’s missing to your pages as they’re sent, from the library."
msgid_plural "%s images from your media library are on this page without their width and height, or without the alt text they have in the library. The plugin can add what’s missing to your pages as they’re sent, from the library."
msgstr[0] "%s bild från ditt mediabibliotek finns på den här sidan utan sin bredd och höjd, eller utan den alt-text den har i biblioteket. Tillägget kan lägga till det som saknas på dina sidor när de skickas, från biblioteket."
msgstr[1] "%s bilder från ditt mediabibliotek finns på den här sidan utan sin bredd och höjd, eller utan den alt-text de har i biblioteket. Tillägget kan lägga till det som saknas på dina sidor när de skickas, från biblioteket."

#: assets/build/audit.js:9
msgid "Fill them in on every page"
msgstr "Fyll i dem på alla sidor"

#: assets/build/audit.js:9
msgid "Someone who can change the plugin’s settings can turn this on."
msgstr "Någon som kan ändra tilläggets inställningar kan slå på det här."

#. translators: 1: a size's name, such as "Medium", 2: its width in pixels, 3: its height in pixels.
#: assets/build/audit.js:10
#, js-format
msgid "Use the %1$s size (%2$s × %3$s) where this image is placed. The page’s editor doesn’t hold it: your theme, a template or a widget shows it, and the size is chosen there."
msgstr "Använd storleken %1$s (%2$s × %3$s) där den här bilden är placerad. Sidans redigerare innehåller den inte: ditt tema, en mall eller en widget visar den, och storleken väljs där."

#. translators: 1: a size's name, such as "Medium", 2: its width in pixels, 3: its height in pixels.
#: assets/build/audit.js:11
#, js-format
msgid "Use the %1$s size (%2$s × %3$s) here: in the editor, select the image and choose it under Resolution."
msgstr "Använd storleken %1$s (%2$s × %3$s) här: markera bilden i redigeraren och välj storleken under Upplösning."

#: assets/build/audit.js:11
msgid "Edit the page"
msgstr "Redigera sidan"

#: assets/build/audit.js:11
msgid "The plugin adds them as the page is sent. Scan again to see it."
msgstr "Tillägget lägger till dem när sidan skickas. Skanna igen för att se det."

#: assets/build/audit.js:11
msgid "Iminify is writing the image’s alt text. Scan again once it’s in."
msgstr "Iminify skriver bildens alt-text. Skanna igen när den är klar."

#: assets/build/audit.js:11
msgid "Iminify can write it once AI alt text is on for this site."
msgstr "Iminify kan skriva den när AI-alt-text är påslagen för den här webbplatsen."

#: assets/build/audit.js:11
msgid "Turn it on in the settings"
msgstr "Slå på det i inställningarna"

