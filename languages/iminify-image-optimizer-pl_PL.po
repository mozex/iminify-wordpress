#: assets/build/bulk.js:29
#, php-format,js-format
msgid "%s image was left as the other plugin made it: its original is gone, too large to send, or only that plugin can put it back. Its panel in the media library says which."
msgid_plural "%s images were left as the other plugins made them: their originals are gone, too large to send, or only those plugins can put them back. Their panels in the media library say which."
msgstr[0] "Pozostawiono %s obrazek w postaci nadanej przez inną wtyczkę: jego oryginału nie ma, jest za duży do wysłania albo tylko tamta wtyczka może go przywrócić. Jego panel w bibliotece mediów wyjaśnia, który to przypadek."
msgstr[1] "Pozostawiono %s obrazki w postaci nadanej przez inne wtyczki: ich oryginałów nie ma, są za duże do wysłania albo tylko tamte wtyczki mogą je przywrócić. Ich panele w bibliotece mediów wyjaśniają, który to przypadek."
msgstr[2] "Pozostawiono %s obrazków w postaci nadanej przez inne wtyczki: ich oryginałów nie ma, są za duże do wysłania albo tylko tamte wtyczki mogą je przywrócić. Ich panele w bibliotece mediów wyjaśniają, który to przypadek."

