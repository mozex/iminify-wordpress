msgstr[1] "%1$s gambar di laman, %2$s perlu diperbaiki."

#: assets/build/audit.js:7
msgid "Nothing to fix: every image on this page is sized, loaded and described well."
msgstr "Tidak ada yang perlu diperbaiki: setiap gambar di laman ini sudah tepat ukurannya, cara pemuatannya, dan deskripsinya."

#: assets/build/audit.js:7
