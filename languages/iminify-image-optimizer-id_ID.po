#. translators: %s: the date and time more page scans come.
#: assets/build/audit.js:6
#, js-format
msgid "Your page scans for today are used up. More come on %s."
msgstr "Kuota pemindaian laman Anda hari ini sudah habis. Kuota baru tersedia pada %s."

#: assets/build/audit.js:6
msgid "Your page scans for today are used up."
msgstr "Kuota pemindaian laman Anda hari ini sudah habis."

#: assets/build/audit.js:6
msgid "Recent audits"
msgstr "Audit terbaru"

#: assets/build/audit.js:6
msgid "Images on the page"
msgstr "Gambar di laman"

#: assets/build/audit.js:6
msgid "Choose a page and press Scan. Iminify lists every image on it, each beside the image in your library it is, with what is worth fixing."
msgstr "Pilih laman lalu tekan Pindai. Iminify menampilkan setiap gambar di dalamnya, masing-masing di samping gambar yang sesuai di pustaka Anda, beserta hal yang perlu diperbaiki."

#: assets/build/audit.js:6
msgid "Iminify is opening the page and measuring its images. This usually takes less than a minute, and the page shows them as soon as they’re in."
msgstr "Iminify sedang membuka laman dan mengukur gambarnya. Biasanya ini memakan waktu kurang dari satu menit, dan laman ini menampilkan gambar-gambar itu begitu hasilnya masuk."

#: assets/build/audit.js:6
