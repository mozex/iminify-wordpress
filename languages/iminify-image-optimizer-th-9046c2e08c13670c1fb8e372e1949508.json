.":["\u0e2a\u0e48\u0e07\u0e2a\u0e33\u0e40\u0e19\u0e32\u0e02\u0e19\u0e32\u0e14\u0e22\u0e48\u0e2d\u0e02\u0e2d\u0e07\u0e23\u0e39\u0e1b\u0e20\u0e32\u0e1e\u0e40\u0e2b\u0e25\u0e48\u0e32\u0e19\u0e35\u0e49\u0e41\u0e15\u0e48\u0e25\u0e30\u0e23\u0e39\u0e1b\u0e40\u0e1e\u0e37\u0e48\u0e2d\u0e40\u0e02\u0e35\u0e22\u0e19\u0e02\u0e49\u0e2d\u0e04\u0e27\u0e32\u0e21 Alt \u0e2b\u0e23\u0e37\u0e2d\u0e44\u0e21\u0e48? \u0e41\u0e15\u0e48\u0e25\u0e30\u0e23\u0e39\u0e1b\u0e19\u0e31\u0e1a\u0e40\u0e1b\u0e47\u0e19 1 \u0e43\u0e19\u0e02\u0e49\u0e2d\u0e04\u0e27\u0e32\u0e21 Alt \u0e08\u0e32\u0e01 AI \u0e1b\u0e23\u0e30\u0e08\u0e33\u0e27\u0e31\u0e19\u0e02\u0e2d\u0e07\u0e04\u0e38\u0e13 \u0e41\u0e25\u0e30\u0e02\u0e49\u0e2d\u0e04\u0e27\u0e32\u0e21 Alt \u0e17\u0e35\u0e48\u0e21\u0e35\u0e1c\u0e39\u0e49\u0e40\u0e02\u0e35\u0e22\u0e19\u0e44\u0e27\u0e49\u0e08\u0e30\u0e44\u0e21\u0e48\u0e16\u0e39\u0e01\u0e41\u0e17\u0e19\u0e17\u0e35\u0e48"],"%s AI alt text left today.":["\u0e27\u0e31\u0e19\u0e19\u0e35\u0e49\u0e40\u0e2b\u0e25\u0e37\u0e2d\u0e02\u0e49\u0e2d\u0e04\u0e27\u0e32\u0e21 Alt \u0e08\u0e32\u0e01 AI %s \u0e23\u0e32\u0e22\u0e01\u0e32\u0e23"],"Send these images again to make what they lack? Each counts as one more image, and keeps its other files unless Iminify makes them smaller.":["\u0e2a\u0e48\u0e07\u0e23\u0e39\u0e1b\u0e20\u0e32\u0e1e\u0e40\u0e2b\u0e25\u0e48\u0e32\u0e19\u0e35\u0e49\u0e2d\u0e35\u0e01\u0e04\u0e23\u0e31\u0e49\u0e07\u0e40\u0e1e\u0e37\u0e48\u0e2d\u0e2a\u0e23\u0e49\u0e32\u0e07\u0e2a\u0e48\u0e27\u0e19\u0e17\u0e35\u0e48\u0e02\u0e32\u0e14\u0e2b\u0e23\u0e37\u0e2d\u0e44\u0e21\u0e48? \u0e41\u0e15\u0e48\u0e25\u0e30\u0e23\u0e39\u0e1b\u0e19\u0e31\u0e1a\u0e40\u0e1b\u0e47\u0e19\u0e23\u0e39\u0e1b\u0e20\u0e32\u0e1e\u0e40\u0e1e\u0e34\u0e48\u0e21\u0e2d\u0e35\u0e01 1 \u0e23\u0e39\u0e1b \u0e41\u0e25\u0e30\u0e44\u0e1f\u0e25\u0e4c\u0e2d\u0e37\u0e48\u0e19\u0e02\u0e2d\u0e07\u0e23\u0e39\u0e1b\u0e08\u0e30\u0e04\u0e07\u0e40\u0e14\u0e34\u0e21 \u0e40\u0e27\u0e49\u0e19\u0e41\u0e15\u0e48 Iminify \u0e08\u0e30\u0e17\u0e33\u0e43\u0e2b\u0e49\u0e40\u0e25\u0e47\u0e01\u0e25\u0e07\u0e44\u0e14\u0e49"],"Optimize them again from their originals":["\u0e40\u0e1e\u0e34\u0e48\u0e21\u0e1b\u0e23\u0e30\u0e2a\u0e34\u0e17\u0e18\u0e34\u0e20\u0e32\u0e1e\u0e2d\u0e35\u0e01\u0e04\u0e23\u0e31\u0e49\u0e07\u0e08\u0e32\u0e01\u0e15\u0e49\u0e19\u0e09\u0e1a\u0e31\u0e1a"],"%s image another plugin optimized kept its original. Iminify can optimize it again from that original and keep its own backup of it. The original goes back first, unless the image was converted to WebP or AVIF: then its files are made again in that format, under the same names.":["\u0e23\u0e39\u0e1b\u0e20\u0e32\u0e1e %s \u0e23\u0e39\u0e1b\u0e17\u0e35\u0e48\u0e1b\u0e25\u0e31\u0e4a\u0e01\u0e2d\u0e34\u0e19\u0e2d\u0e37\u0e48\u0e19\u0e40\u0e1e\u0e34\u0e48\u0e21\u0e1b\u0e23\u0e30\u0e2a\u0e34\u0e17\u0e18\u0e34\u0e20\u0e32\u0e1e\u0e44\u0e27\u0e49\u0e22\u0e31\u0e07\u0e40\u0e01\u0e47\u0e1a\u0e15\u0e49\u0e19\u0e09\u0e1a\u0e31\u0e1a\u0e44\u0e27\u0e49 Iminify \u0e2a\u0e32\u0e21\u0e32\u0e23\u0e16\u0e40\u0e1e\u0e34\u0e48\u0e21\u0e1b\u0e23\u0e30\u0e2a\u0e34\u0e17\u0e18\u0e34\u0e20\u0e32\u0e1e\u0e2d\u0e35\u0e01\u0e04\u0e23\u0e31\u0e49\u0e07\u0e08\u0e32\u0e01\u0e15\u0e49\u0e19\u0e09\u0e1a\u0e31\u0e1a \u0e41\u0e25\u0e30\u0e40\u0e01\u0e47\u0e1a\u0e44\u0e1f\u0e25\u0e4c\u0e2a\u0e33\u0e23\u0e2d\u0e07\u0e02\u0e2d\u0e07\u0e15\u0e49\u0e19\u0e09\u0e1a\u0e31\u0e1a\u0e44\u0e27\u0e49\u0e40\u0e2d\u0e07 \u0e15\u0e49\u0e19\u0e09\u0e1a\u0e31\u0e1a\u0e08\u0e30\u0e16\u0e39\u0e01\u0e19\u0e33\u0e01\u0e25\u0e31\u0e1a\u0e21\u0e32\u0e01\u0e48\u0e2d\u0e19 \u0e40\u0e27\u0e49\u0e19\u0e41\u0e15\u0e48\u0e23\u0e39\u0e1b\u0e16\u0e39\u0e01\u0e41\u0e1b\u0e25\u0e07\u0e40\u0e1b\u0e47\u0e19 WebP \u0e2b\u0e23\u0e37\u0e2d AVIF: \u0e43\u0e19\u0e01\u0e23\u0e13\u0e35\u0e19\u0e31\u0e49\u0e19\u0e44\u0e1f\u0e25\u0e4c\u0e02\u0e2d\u0e07\u0e23\u0e39\u0e1b\u0e08\u0e30\u0e16\u0e39\u0e01\u0e2a\u0e23\u0e49\u0e32\u0e07\u0e43\u0e2b\u0e21\u0e48\u0e43\u0e19\u0e23\u0e39\u0e1b\u0e41\u0e1a\u0e1a\u0e19\u0e31\u0e49\u0e19\u0e42\u0e14\u0e22\u0e43\u0e0a\u0e49\u0e0a\u0e37\u0e48\u0e2d\u0e40\u0e14\u0e34\u0e21"],"Optimize these images again from their originals? Each counts as one more image, and one whose original only its plugin can put back is left as it is.":["\u0e40\u0e1e\u0e34\u0e48\u0e21\u0e1b\u0e23\u0e30\u0e2a\u0e34\u0e17\u0e18\u0e34\u0e20\u0e32\u0e1e\u0e23\u0e39\u0e1b\u0e20\u0e32\u0e1e\u0e40\u0e2b\u0e25\u0e48\u0e32\u0e19\u0e35\u0e49\u0e2d\u0e35\u0e01\u0e04\u0e23\u0e31\u0e49\u0e07\u0e08\u0e32\u0e01\u0e15\u0e49\u0e19\u0e09\u0e1a\u0e31\u0e1a\u0e2b\u0e23\u0e37\u0e2d\u0e44\u0e21\u0e48? \u0e41\u0e15\u0e48\u0e25\u0e30\u0e23\u0e39\u0e1b\u0e19\u0e31\u0e1a\u0e40\u0e1b\u0e47\u0e19\u0e23\u0e39\u0e1b\u0e20\u0e32\u0e1e\u0e40\u0e1e\u0e34\u0e48\u0e21\u0e2d\u0e35\u0e01 1 \u0e23\u0e39\u0e1b \u0e41\u0e25\u0e30\u0e23\u0e39\u0e1b\u0e17\u0e35\u0e48\u0e21\u0e35\u0e40\u0e1e\u0e35\u0e22\u0e07\u0e1b\u0e25\u0e31\u0e4a\u0e01\u0e2d\u0e34\u0e19\u0e02\u0e2d\u0e07\u0e23\u0e39\u0e1b\u0e19\u0e31\u0e49\u0e19\u0e17\u0e35\u0e48\u0e19\u0e33\u0e15\u0e49\u0e19\u0e09\u0e1a\u0e31\u0e1a\u0e01\u0e25\u0e31\u0e1a\u0e21\u0e32\u0e44\u0e14\u0e49\u0e08\u0e30\u0e16\u0e39\u0e01\u0e1b\u0e25\u0e48\u0e2d\u0e22\u0e44\u0e27\u0e49\u0e15\u0e32\u0e21\u0e40\u0e14\u0e34\u0e21"],"LiteSpeed Cache is active. Whenever WordPress makes an image's sizes again (Regenerate Thumbnails, or replacing an image), it deletes the WebP and AVIF copies beside it and puts back the old files it kept of an image it optimized, so Iminify reads that image as changed. \"Remove Original Image Backups\", under LiteSpeed Cache, Image Optimization, stops it putting old files back.":["LiteSpeed Cache \u0e40\u0e1b\u0e34\u0e14\u0e43\u0e0a\u0e49\u0e07\u0e32\u0e19\u0e2d\u0e22\u0e39\u0e48 \u0e17\u0e38\u0e01\u0e04\u0e23\u0e31\u0e49\u0e07\u0e17\u0e35\u0e48 WordPress \u0e2a\u0e23\u0e49\u0e32\u0e07\u0e02\u0e19\u0e32\u0e14\u0e15\u0e48\u0e32\u0e07\u0e46 \u0e02\u0e2d\u0e07\u0e23\u0e39\u0e1b\u0e43\u0e2b\u0e21\u0e48 (Regenerate Thumbnails \u0e2b\u0e23\u0e37\u0e2d\u0e01\u0e32\u0e23\u0e41\u0e17\u0e19\u0e17\u0e35\u0e48\u0e23\u0e39\u0e1b) LiteSpeed Cache \u0e08\u0e30\u0e25\u0e1a\u0e40\u0e27\u0e2d\u0e23\u0e4c\u0e0a\u0e31\u0e19 WebP \u0e41\u0e25\u0e30 AVIF \u0e17\u0e35\u0e48\u0e2d\u0e22\u0e39\u0e48\u0e02\u0e49\u0e32\u0e07\u0e23\u0e39\u0e1b \u0e41\u0e25\u0e30\u0e19\u0e33\u0e44\u0e1f\u0e25\u0e4c\u0e40\u0e01\u0e48\u0e32\u0e17\u0e35\u0e48\u0e40\u0e01\u0e47\u0e1a\u0e44\u0e27\u0e49\u0e02\u0e2d\u0e07\u0e23\u0e39\u0e1b\u0e17\u0e35\u0e48\u0e15\u0e19\u0e40\u0e1e\u0e34\u0e48\u0e21\u0e1b\u0e23\u0e30\u0e2a\u0e34\u0e17\u0e18\u0e34\u0e20\u0e32\u0e1e\u0e01\u0e25\u0e31\u0e1a\u0e21\u0e32 Iminify \u0e08\u0e36\u0e07\u0e21\u0e2d\u0e07\u0e27\u0e48\u0e32\u0e23\u0e39\u0e1b\u0e19\u0e31\u0e49\u0e19\u0e40\u0e1b\u0e25\u0e35\u0e48\u0e22\u0e19\u0e44\u0e1b \u201cRemove Original Image Backups\u201d \u0e17\u0e35\u0e48 LiteSpeed Cache, Image Optimization \u0e08\u0e30\u0e2b\u0e22\u0e38\u0e14\u0e44\u0e21\u0e48\u0e43\u0e2b\u0e49\u0e19\u0e33\u0e44\u0e1f\u0e25\u0e4c\u0e40\u0e01\u0e48\u0e32\u0e01\u0e25\u0e31\u0e1a\u0e21\u0e32"],"In the background":["\u0e43\u0e19\u0e40\u0e1a\u0e37\u0e49\u0e2d\u0e07\u0e2b\u0e25\u0e31\u0e07"],"So you can leave this page.":["\u0e04\u0e38\u0e13\u0e08\u0e36\u0e07\u0e2d\u0e2d\u0e01\u0e08\u0e32\u0e01\u0e2b\u0e19\u0e49\u0e32\u0e19\u0e35\u0e49\u0e44\u0e14\u0e49"],"While this page is open":["\u0e02\u0e13\u0e30\u0e17\u0e35\u0e48\u0e2b\u0e19\u0e49\u0e32\u0e19\u0e35\u0e49\u0e40\u0e1b\u0e34\u0e14\u0e2d\u0e22\u0e39\u0e48"],"For a host whose scheduled tasks don't run.":["\u0e2a\u0e33\u0e2b\u0e23\u0e31\u0e1a\u0e42\u0e2e\u0e2a\u0e15\u0e4c\u0e17\u0e35\u0e48\u0e07\u0e32\u0e19\u0e17\u0e35\u0e48\u0e15\u0e31\u0e49\u0e07\u0e40\u0e27\u0e25\u0e32\u0e44\u0e27\u0e49\u0e44\u0e21\u0e48\u0e17\u0e33\u0e07\u0e32\u0e19"],"Run it":["\u0e40\u0e23\u0e34\u0e48\u0e21\u0e17\u0e33\u0e07\u0e32\u0e19"],"Your plan":["\u0e41\u0e1e\u0e47\u0e01\u0e40\u0e01\u0e08\u0e02\u0e2d\u0e07\u0e04\u0e38\u0e13"],"all today":["\u0e17\u0e31\u0e49\u0e07\u0e2b\u0e21\u0e14\u0e20\u0e32\u0e22\u0e43\u0e19\u0e27\u0e31\u0e19\u0e19\u0e35\u0e49"],"about %d day":["\u0e1b\u0e23\u0e30\u0e21\u0e32\u0e13 %d \u0e27\u0e31\u0e19"],"Your plan's daily images cover them all today.":["\u0e08\u0e33\u0e19\u0e27\u0e19\u0e23\u0e39\u0e1b\u0e20\u0e32\u0e1e\u0e1b\u0e23\u0e30\u0e08\u0e33\u0e27\u0e31\u0e19\u0e02\u0e2d\u0e07\u0e41\u0e1e\u0e47\u0e01\u0e40\u0e01\u0e08\u0e04\u0e38\u0e13\u0e40\u0e1e\u0e35\u0e22\u0e07\u0e1e\u0e2d\u0e2a\u0e33\u0e2b\u0e23\u0e31\u0e1a\u0e17\u0e31\u0e49\u0e07\u0e2b\u0e21\u0e14\u0e20\u0e32\u0e22\u0e43\u0e19\u0e27\u0e31\u0e19\u0e19\u0e35\u0e49"],"The run goes on by itself each day.":["\u0e07\u0e32\u0e19\u0e08\u0e30\u0e17\u0e33\u0e15\u0e48\u0e2d\u0e40\u0e2d\u0e07\u0e17\u0e38\u0e01\u0e27\u0e31\u0e19"],"See the plans":["\u0e14\u0e39\u0e41\u0e1e\u0e47\u0e01\u0e40\u0e01\u0e08"],"Other folders":["\u0e42\u0e1f\u0e25\u0e40\u0e14\u0e2d\u0e23\u0e4c\u0e2d\u0e37\u0e48\u0e19"],"Optimize the images in your theme and other folders outside the media library, where they are, with a backup of each.":["\u0e40\u0e1e\u0e34\u0e48\u0e21\u0e1b\u0e23\u0e30\u0e2a\u0e34\u0e17\u0e18\u0e34\u0e20\u0e32\u0e1e\u0e23\u0e39\u0e1b\u0e20\u0e32\u0e1e\u0e43\u0e19\u0e18\u0e35\u0e21\u0e02\u0e2d\u0e07\u0e04\u0e38\u0e13\u0e41\u0e25\u0e30\u0e42\u0e1f\u0e25\u0e40\u0e14\u0e2d\u0e23\u0e4c\u0e2d\u0e37\u0e48\u0e19\u0e17\u0e35\u0e48\u0e2d\u0e22\u0e39\u0e48\u0e19\u0e2d\u0e01\u0e04\u0e25\u0e31\u0e07\u0e2a\u0e37\u0e48\u0e2d \u0e13 \u0e15\u0e33\u0e41\u0e2b\u0e19\u0e48\u0e07\u0e40\u0e14\u0e34\u0e21 \u0e1e\u0e23\u0e49\u0e2d\u0e21\u0e44\u0e1f\u0e25\u0e4c\u0e2a\u0e33\u0e23\u0e2d\u0e07\u0e02\u0e2d\u0e07\u0e41\u0e15\u0e48\u0e25\u0e30\u0e23\u0e39\u0e1b"],"%1$s image in your folders: %2$s optimized, %3$s not yet.":["\u0e23\u0e39\u0e1b\u0e20\u0e32\u0e1e\u0e43\u0e19\u0e42\u0e1f\u0e25\u0e40\u0e14\u0e2d\u0e23\u0e4c\u0e02\u0e2d\u0e07\u0e04\u0e38\u0e13 %1$s \u0e23\u0e39\u0e1b: \u0e40\u0e1e\u0e34\u0e48\u0e21\u0e1b\u0e23\u0e30\u0e2a\u0e34\u0e17\u0e18\u0e34\u0e20\u0e32\u0e1e\u0e41\u0e25\u0e49\u0e27 %2$s \u0e23\u0e39\u0e1b \u0e22\u0e31\u0e07\u0e44\u0e21\u0e48\u0e4