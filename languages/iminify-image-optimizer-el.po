msgstr "Αυτός ο φάκελος δεν είναι στη λίστα."

#: includes/admin/class-folders-controller.php:191
#: includes/folders/class-restorer.php:95
msgid "That image isn't in the list."
msgstr "Αυτή η εικόνα δεν είναι στη λίστα."

#: includes/admin/class-folders-page.php:46
#: includes/admin/class-folders-page.php:47
#: includes/admin/class-folders-page.php:84
msgid "Other Folders"
msgstr "Άλλοι φάκελοι"

#: includes/admin/class-folders-page.php:84
msgid "The images in your theme and other folders outside the media library."
msgstr "Οι εικόνες του θέματός σας και άλλων φακέλων εκτός της βιβλιοθήκης πολυμέσων."

#: includes/admin/class-media-controller.php:205
msgid "This image has no original on the site to compare it with."
msgstr "Αυτή η εικόνα δεν έχει πρωτότυπο στον ιστότοπο για να συγκριθεί."

#: includes/admin/class-media-view.php:183
msgid "Original"
msgstr "Πρωτότυπο"

#: includes/admin/class-media-view.php:210
#: includes/admin/class-media-view.php:335
msgid "Compare with the original"
msgstr "Σύγκριση με το πρωτότυπο"

#: includes/admin/class-media-view.php:211
msgid "Close"
msgstr "Κλείσιμο"

#: includes/admin/class-media-view.php:212
msgid "How much of the original shows"
msgstr "Πόσο από το πρωτότυπο φαίνεται"

#: includes/admin/class-media-view.php:213
msgid "The optimized file to compare"
msgstr "Το βελτιστοποιημένο αρχείο για σύγκριση"

#: includes/admin/class-media-view.php:214
msgid "This image couldn't be loaded from the site."
msgstr "Δεν ήταν δυνατή η φόρτωση αυτής της εικόνας από τον ιστότοπο."

#: includes/admin/class-media-view.php:216
msgid "Drag the line, or use the arrow keys, to see more of the original on one side and of the optimized file on the other."
msgstr "Σύρετε τη γραμμή ή χρησιμοποιήστε τα πλήκτρα βέλους για να δείτε περισσότερο από το πρωτότυπο στη μία πλευρά και από το βελτιστοποιημένο αρχείο στην άλλη."

#. translators: %s: the compression level with what it does, such as "Smart: a balance between quality and size".
#: includes/admin/class-media-view.php:219
#, php-format
msgid "Optimized at %s. Drag the line, or use the arrow keys, to see more of the original on one side and of the optimized file on the other."
msgstr "Βελτιστοποιήθηκε με επίπεδο %s. Σύρετε τη γραμμή ή χρησιμοποιήστε τα πλήκτρα βέλους για να δείτε περισσότερο από το πρωτότυπο στη μία πλευρά και από το βελτιστοποιημένο αρχείο στην άλλη."

#. translators: 1: what the file is, such as Original or WebP, 2: its size, such as 1.2 MB.
#: includes/admin/class-media-view.php:248
#, php-format
msgid "%1$s, %2$s"
msgstr "%1$s, %2$s"

#. translators: 1: what the file is and its size, such as "WebP, 340 KB", 2: how much smaller it is than the original, such as 72%.
#: includes/admin/class-media-view.php:256
#, php-format
msgid "%1$s, %2$s smaller"
msgstr "%1$s, %2$s μικρότερο"

#: includes/admin/class-media-view.php:278
#: includes/admin/class-media-view.php:839
#: assets/build/audit.js:11
#: assets/build/folders.js:8
