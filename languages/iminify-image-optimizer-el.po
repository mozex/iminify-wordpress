msgstr "(ανοίγει σε μία νέα καρτέλα)"

#: assets/build/audit.js:2
#: assets/build/bulk.js:2
#: assets/build/folders.js:1
#: assets/build/settings.js:2
msgid "Loading…"
msgstr "Φόρτωση…"

#: assets/build/audit.js:2
#: assets/build/bulk.js:2
#: assets/build/folders.js:1
#: assets/build/settings.js:2
#: assets/build/settings.js:38
msgid "Try again"
msgstr "Δοκιμάστε ξανά"

#: assets/build/audit.js:2
#: assets/build/folders.js:1
#: assets/build/settings.js:2
msgid "Dismiss"
msgstr "Απόρριψη"

#: assets/build/audit.js:2
msgid "Iminify is scanning the page."
msgstr "Το Iminify σαρώνει τη σελίδα."

#: assets/build/audit.js:2
msgid "Your pages now get the missing width, height and alt text as they’re sent. Scan the page again to see it."
msgstr "Οι σελίδες σας λαμβάνουν πλέον το πλάτος, το ύψος και το εναλλακτικό κείμενο που λείπουν καθώς στέλνονται. Σαρώστε ξανά τη σελίδα για να το δείτε."

#: assets/build/audit.js:2
msgid "Every page, every week"
msgstr "Κάθε σελίδα, κάθε εβδομάδα"

#: assets/build/audit.js:2
msgid "A weekly check audits every page in your site's sitemap once a week, compresses the images that are new or changed, and emails you what it found. You set it up on iminify.com from a crawl of your site, where you can see which plans include it."
msgstr "Ένας εβδομαδιαίος έλεγχος εξετάζει κάθε σελίδα στον χάρτη (sitemap) του ιστότοπού σας μία φορά την εβδομάδα, συμπιέζει τις εικόνες που είναι νέες ή άλλαξαν και σας στέλνει με email τα ευρήματα. Τον ρυθμίζετε στο iminify.com από μια ανίχνευση του ιστότοπού σας, όπου μπορείτε να δείτε ποια πακέτα τον περιλαμβάνουν."

#: assets/build/audit.js:2
msgid "Set up a weekly check"
msgstr "Ρύθμιση εβδομαδιαίου ελέγχου"

#: assets/build/audit.js:2
msgid "Couldn't read the page"
msgstr "Αδυναμία ανάγνωσης της σελίδας"

#: assets/build/audit.js:2
msgid "Waiting to scan"
msgstr "Αναμονή σάρωσης"

#: assets/build/audit.js:2
msgid "Scanning"
msgstr "Σαρώνεται"

#: assets/build/audit.js:2
msgid "Done"
msgstr "Ολοκληρώθηκε"

#: assets/build/audit.js:2
msgid "No images"
msgstr "Χωρίς εικόνες"

#: assets/build/audit.js:2
#: assets/build/bulk.js:7
msgid "Stopped"
msgstr "Διακόπηκε"

#: assets/build/audit.js:2
msgctxt "the status of a page audit"
msgid "Failed"
msgstr "Απέτυχε"

#: assets/build/audit.js:2
msgid "Iminify disconnected this site, so its pages can’t be audited. Connect it again to carry on."
msgstr "Το Iminify αποσύνδεσε αυτόν τον ιστότοπο, οπότε δεν μπορεί να γίνει έλεγχος των σελίδων του. Συνδέστε τον ξανά για να συνεχίσετε."

#: assets/build/audit.js:2
msgid "Connect this site to Iminify to audit its pages."
msgstr "Συνδέστε αυτόν τον ιστότοπο με το Iminify για να ελέγξετε τις σελίδες του."

#: assets/build/audit.js:2
#: assets/build/bulk.js:17
msgid "Go to the settings"
msgstr "Μετάβαση στις ρυθμίσεις"

#: assets/build/audit.js:2
msgid "Scan a page"
msgstr "Σάρωση σελίδας"

#: assets/build/audit.js:2
msgid "Iminify opens the page as a visitor would and measures every image it shows."
msgstr "Το Iminify ανοίγει τη σελίδα όπως θα την άνοιγε ένας επισκέπτης και μετρά κάθε εικόνα που εμφανίζει."

#: assets/build/audit.js:2
msgid "Page"
msgstr "Σελίδα"

#: assets/build/audit.js:2
msgid "Another address on this site"
msgstr "Άλλη διεύθυνση σε αυτόν τον ιστότοπο"

#: assets/build/audit.js:2
msgid "Address"
msgstr "Διεύθυνση"

#: assets/build/audit.js:2
msgid "Scan"
msgstr "Σάρωση"

#. translators: %s: how many seconds are left before the next scan.
#: assets/build/audit.js:3
#, js-format
msgid "You can scan again in %s second."
msgid_plural "You can scan again in %s seconds."
msgstr[0] "Μπορείτε να σαρώσετε ξανά σε %s δευτερόλεπτο."
msgstr[1] "Μπορείτε να σαρώσετε ξανά σε %s δευτερόλεπτα."

#. translators: %s: how many page scans the account used today.
#: assets/build/audit.js:4
#, js-format
msgid "%s page scan used today. Each audit counts as one."
msgid_plural "%s page scans used today. Each audit counts as one."
msgstr[0] "Χρησιμοποιήθηκε σήμερα %s σάρωση σελίδας. Κάθε έλεγχος μετράει ως μία."
msgstr[1] "Χρησιμοποιήθηκαν σήμερα %s σαρώσεις σελίδων. Κάθε έλεγχος μετράει ως μία."

#. translators: 1: how many page scans are left today, 2: how many the account has a day.
#: assets/build/audit.js:5
#, js-format
msgid "%1$s of %2$s page scan left today. Each audit counts as one."
msgid_plural "%1$s of %2$s page scans left today. Each audit counts as one."
msgstr[0] "Σαρώσεις σελίδων που απομένουν σήμερα: %1$s από %2$s. Κάθε έλεγχος μετράει ως μία."
msgstr[1] "Σαρώσεις σελίδων που απομένουν σήμερα: %1$s από %2$s. Κάθε έλεγχος μετράει ως μία."

#. translators: %s: the date and time more page scans come.
#: assets/build/audit.js:6
#, js-format
msgid "Your page scans for today are used up. More come on %s."
msgstr "Οι σαρώσεις σελίδων σας για σήμερα εξαντλήθηκαν. Νέες έρχονται στις %s."

#: assets/build/audit.js:6
msgid "Your page scans for today are used up."
msgstr "Οι σαρώσεις σελίδων σας για σήμερα εξαντλήθηκαν."

#: assets/build/audit.js:6
msgid "Recent audits"
msgstr "Πρόσφατοι έλεγχοι"

#: assets/build/audit.js:6
msgid "Images on the page"
msgstr "Εικόνες στη σελίδα"

#: assets/build/audit.js:6
msgid "Choose a page and press Scan. Iminify lists every image on it, each beside the image in your library it is, with what is worth fixing."
msgstr "Επιλέξτε μια σελίδα και πατήστε «Σάρωση». Το Iminify παραθέτει κάθε εικόνα της, καθεμία δίπλα στην αντίστοιχη εικόνα της βιβλιοθήκης σας, μαζί με ό,τι αξίζει να διορθωθεί."

#: assets/build/audit.js:6
msgid "Iminify is opening the page and measuring its images. This usually takes less than a minute, and the page shows them as soon as they’re in."
msgstr "Το Iminify ανοίγει τη σελίδα και μετρά τις εικόνες της. Αυτό συνήθως διαρκεί λιγότερο από ένα λεπτό, και η σελίδα τις εμφανίζει μόλις είναι έτοιμες."

#: assets/build/audit.js:6
msgid "The page showed no images."
msgstr "Η σελίδα δεν εμφάνισε εικόνες."

#. translators: 1: how many images the page showed, 2: how many of them have something to fix.
#: assets/build/audit.js:7
#, js-format
msgid "%1$s image on the page, %2$s with something to fix."
msgid_plural "%1$s images on the page, %2$s with something to fix."
msgstr[0] "%1$s εικόνα στη σελίδα, %2$s με κάτι προς διόρθωση."
msgstr[1] "%1$s εικόνες στη σελίδα, %2$s με κάτι προς διόρθωση."

#: assets/build/audit.js:7
msgid "Nothing to fix: every image on this page is sized, loaded and described well."
