msgstr "Zu den Einstellungen"

#: assets/build/audit.js:2
msgid "Scan a page"
msgstr "Seite scannen"

#: assets/build/audit.js:2
msgid "Iminify opens the page as a visitor would and measures every image it shows."
msgstr "Iminify öffnet die Seite wie ein Besucher und misst jedes angezeigte Bild."

#: assets/build/audit.js:2
msgid "Page"
msgstr "Seite"

#: assets/build/audit.js:2
