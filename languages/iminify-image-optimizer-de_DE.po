#: assets/build/settings.js:37
msgid "Write alt text with AI"
msgstr "Alternativtext mit KI schreiben"

#: includes/admin/class-media-view.php:1139
msgid "Send a small copy of this image to write its alt text? It counts as one of your AI alt texts for the day."
msgstr "Eine verkleinerte Version dieses Bildes senden, um seinen Alternativtext zu schreiben? Das zählt als einer deiner KI-Alternativtexte für heute."

#: includes/admin/class-media-view.php:1139
msgid "Write alt text"
msgstr "Alternativtext schreiben"

#: includes/admin/class-media-view.php:1158
msgid "Optimize again from the original at"
msgstr "Erneut aus dem Original optimieren mit"

#: includes/admin/class-media-view.php:1186
msgid "Connect the site to Iminify to optimize this image."
msgstr "Verbinde die Website mit Iminify, um dieses Bild zu optimieren."

#: includes/admin/class-media-view.php:1188
msgid "No original of this image was kept, so it can't be optimized again or restored."
msgstr "Von diesem Bild wurde kein Original behalten, daher kann es weder erneut optimiert noch wiederhergestellt werden."

#: includes/admin/class-media-view.php:1190
msgid "Optimize again at"
msgstr "Erneut optimieren mit"

#: includes/admin/class-media-view.php:1190
msgid "Optimize at"
msgstr "Optimieren mit"

#: includes/admin/class-media-view.php:1207
msgid "Make what it lacks"
msgstr "Fehlendes erstellen"

#: includes/admin/class-media-view.php:1216
msgid "This image has changed since Iminify optimized it, so there's nothing to restore."
msgstr "Dieses Bild wurde geändert, seit Iminify es optimiert hat, daher gibt es nichts wiederherzustellen."

#: includes/admin/class-media-view.php:1223
msgid "Delete the copies"
msgstr "Kopien löschen"

#: includes/admin/class-media-view.php:1223
msgid "Delete this image's WebP and AVIF copies? Its pages go back to serving the JPEG or PNG."
msgstr "Die WebP- und AVIF-Kopien dieses Bildes löschen? Seine Seiten liefern dann wieder das JPEG oder PNG aus."

#: includes/admin/class-media-view.php:1288
#: assets/build/bulk.js:23
msgid "Make the missing formats"
msgstr "Fehlende Formate erstellen"

#: includes/admin/class-media-view.php:1292
#: assets/build/bulk.js:24
msgid "Make the missing sizes"
msgstr "Fehlende Größen erstellen"

#: includes/admin/class-media-view.php:1303
msgid "Send this image again to make what it lacks? This counts as one more image, and its other files stay as they are unless Iminify makes them smaller."
msgstr "Dieses Bild erneut senden, um das Fehlende zu erstellen? Das zählt als ein weiteres Bild, und seine übrigen Dateien bleiben unverändert, sofern Iminify sie nicht verkleinert."

#: includes/admin/class-media-view.php:1311
msgid "Optimize this image again? Iminify makes its files again from its original, keeping their format and names, and this counts as one more image."
msgstr "Dieses Bild erneut optimieren? Iminify erstellt seine Dateien aus dem Original neu, mit gleichem Format und gleichen Namen, und das zählt als ein weiteres Bild."

#: includes/admin/class-media-view.php:1314
msgid "Optimize this image again? Its original goes back first, and this counts as one more image."
msgstr "Dieses Bild erneut optimieren? Zuerst wird sein Original wieder eingesetzt, und das zählt als ein weiteres Bild."

#: includes/admin/class-media-view.php:1321
msgid "Restore the original of this image? WordPress makes its sizes again, and its WebP and AVIF copies are deleted."
msgstr "Das Original dieses Bildes wiederherstellen? WordPress erstellt seine Größen neu, und seine WebP- und AVIF-Kopien werden gelöscht."

#. translators: %s: another image optimizer's name, such as Image Optimizer by Elementor.
#: includes/admin/class-media-view.php:1336
#, php-format
msgid "Optimize this image again from the original %s kept? Iminify makes its files again from it, keeping their format and names so your posts still link to them, and keeps its own backup of the original. This counts as one more image."
msgstr "Dieses Bild erneut aus dem Original optimieren, das %s behalten hat? Iminify erstellt seine Dateien daraus neu, mit gleichem Format und gleichen Namen, damit deine Beiträge weiterhin darauf verlinken, und behält ein eigenes Backup des Originals. Das zählt als ein weiteres Bild."

#. translators: %s: another image optimizer's name, such as Imagify.
#: includes/admin/class-media-view.php:1343
#, php-format
msgid "Optimize this image again from the original %s kept? The original goes back first and WordPress makes its sizes again, then Iminify optimizes it and keeps its own backup of the original. This counts as one more image."
msgstr "Dieses Bild erneut aus dem Original optimieren, das %s behalten hat? Zuerst wird das Original wieder eingesetzt und WordPress erstellt seine Größen neu, dann optimiert Iminify es und behält ein eigenes Backup des Originals. Das zählt als ein weiteres Bild."

#. translators: %s: another image optimizer's name, such as Imagify.
#: includes/admin/class-media-view.php:1358
#, php-format
msgid "Restore the original of this image from what %s kept? WordPress makes its sizes again, and that plugin's backups and copies stay where they are."
msgstr "Das Original dieses Bildes aus dem wiederherstellen, was %s behalten hat? WordPress erstellt seine Größen neu, und die Backups und Kopien dieses Plugins bleiben, wo sie sind."

#: includes/admin/class-notice.php:132
msgid "Iminify disconnected this site, so new uploads aren't optimized."
msgstr "Iminify hat die Verbindung dieser Website getrennt, daher werden neue Uploads nicht optimiert."

#: includes/admin/class-notice.php:133
msgid "Connect it again"
msgstr "Erneut verbinden"

#: includes/admin/class-notice.php:137
msgid "Iminify Image Optimizer is ready. Connect it to your Iminify account to start optimizing your images."
msgstr "Iminify Image Optimizer ist bereit. Verbinde es mit deinem Iminify-Konto, um deine Bilder zu optimieren."

#: includes/admin/class-notice.php:138
#: assets/build/settings.js:9
msgid "Connect"
msgstr "Verbinden"

#: includes/admin/class-notice.php:150
#: includes/admin/class-notice.php:183
msgid "Open the Iminify settings"
msgstr "Iminify-Einstellungen öffnen"

