#, php-format
msgid "Optimized at %s. Drag the line, or use the arrow keys, to see more of the original on one side and of the optimized file on the other."
msgstr "Оптимизировано (%s). Перетаскивайте линию или используйте клавиши со стрелками, чтобы видеть больше оригинала с одной стороны и оптимизированного файла с другой."

#. translators: 1: what the file is, such as Original or WebP, 2: its size, such as 1.2 MB.
#: includes/admin/class-media-view.php:246
#, php-format
msgid "%1$s, %2$s"
msgstr "%1$s, %2$s"

#. translators: 1: what the file is and its size, such as "WebP, 340 KB", 2: how much smaller it is than the original, such as 72%.
#: includes/admin/class-media-view.php:254
#, php-format
msgid "%1$s, %2$s smaller"
msgstr "%1$s, на %2$s меньше"

