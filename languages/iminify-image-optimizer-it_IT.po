#: assets/build/folders.js:1
#: assets/build/settings.js:2
msgid "Dismiss"
msgstr "Ignora"

#: assets/build/audit.js:2
msgid "Iminify is scanning the page."
msgstr "Iminify sta scansionando la pagina."

#: assets/build/audit.js:2
msgid "Your pages now get the missing width, height and alt text as they’re sent. Scan the page again to see it."
msgstr "Ora le tue pagine ricevono larghezza, altezza e testo alternativo mancanti mentre vengono servite. Scansiona di nuovo la pagina per vederlo."

#: assets/build/audit.js:2
msgid "Every page, every week"
msgstr "Ogni pagina, ogni settimana"

#: assets/build/audit.js:2
msgid "A weekly check audits every page in your site's sitemap once a week, compresses the images that are new or changed, and emails you what it found. You set it up on iminify.com from a crawl of your site, where you can see which plans include it."
msgstr "Un controllo settimanale analizza una volta a settimana ogni pagina della sitemap del tuo sito, comprime le immagini nuove o cambiate e ti invia per email ciò che ha trovato. Lo configuri su iminify.com partendo da una scansione completa del tuo sito, e lì puoi vedere quali piani lo includono."

#: assets/build/audit.js:2
msgid "Set up a weekly check"
msgstr "Configura un controllo settimanale"

#: assets/build/audit.js:2
msgid "Couldn't read the page"
msgstr "Pagina non leggibile"

#: assets/build/audit.js:2
msgid "Waiting to scan"
msgstr "In attesa di scansione"

#: assets/build/audit.js:2
msgid "Scanning"
msgstr "Scansione in corso"

#: assets/build/audit.js:2
msgid "Done"
msgstr "Completata"

#: assets/build/audit.js:2
msgid "No images"
msgstr "Nessuna immagine"

#: assets/build/audit.js:2
#: assets/build/bulk.js:7
msgid "Stopped"
msgstr "Interrotta"

#: assets/build/audit.js:2
msgctxt "the status of a page audit"
msgid "Failed"
msgstr "Non riuscita"

#: assets/build/audit.js:2
msgid "Iminify disconnected this site, so its pages can’t be audited. Connect it again to carry on."
msgstr "Iminify ha scollegato questo sito, quindi le sue pagine non possono essere analizzate. Collegalo di nuovo per continuare."

#: assets/build/audit.js:2
msgid "Connect this site to Iminify to audit its pages."
msgstr "Collega questo sito a Iminify per analizzarne le pagine."

#: assets/build/audit.js:2
#: assets/build/bulk.js:17
msgid "Go to the settings"
msgstr "Vai alle impostazioni"

#: assets/build/audit.js:2
msgid "Scan a page"
msgstr "Scansiona una pagina"

#: assets/build/audit.js:2
msgid "Iminify opens the page as a visitor would and measures every image it shows."
msgstr "Iminify apre la pagina come farebbe un visitatore e misura ogni immagine che mostra."

#: assets/build/audit.js:2
msgid "Page"
msgstr "Pagina"

#: assets/build/audit.js:2
msgid "Another address on this site"
msgstr "Un altro indirizzo di questo sito"

#: assets/build/audit.js:2
msgid "Address"
msgstr "Indirizzo"

#: assets/build/audit.js:2
msgid "Scan"
msgstr "Scansiona"

#. translators: %s: how many seconds are left before the next scan.
#: assets/build/audit.js:3
#, js-format
msgid "You can scan again in %s second."
msgid_plural "You can scan again in %s seconds."
msgstr[0] "Puoi scansionare di nuovo tra %s secondo."
msgstr[1] "Puoi scansionare di nuovo tra %s secondi."

#. translators: %s: how many page scans the account used today.
#: assets/build/audit.js:4
#, js-format
msgid "%s page scan used today. Each audit counts as one."
msgid_plural "%s page scans used today. Each audit counts as one."
msgstr[0] "%s scansione di pagina usata oggi. Ogni analisi conta come una."
msgstr[1] "%s scansioni di pagine usate oggi. Ogni analisi conta come una."

#. translators: 1: how many page scans are left today, 2: how many the account has a day.
#: assets/build/audit.js:5
#, js-format
msgid "%1$s of %2$s page scan left today. Each audit counts as one."
msgid_plural "%1$s of %2$s page scans left today. Each audit counts as one."
msgstr[0] "Scansioni di pagine rimaste oggi: %1$s su %2$s. Ogni analisi conta come una."
msgstr[1] "Scansioni di pagine rimaste oggi: %1$s su %2$s. Ogni analisi conta come una."

#. translators: %s: the date and time more page scans come.
#: assets/build/audit.js:6
#, js-format
msgid "Your page scans for today are used up. More come on %s."
msgstr "Le tue scansioni di pagine di oggi sono esaurite. Altre saranno disponibili il %s."

#: assets/build/audit.js:6
msgid "Your page scans for today are used up."
msgstr "Le tue scansioni di pagine di oggi sono esaurite."

#: assets/build/audit.js:6
msgid "Recent audits"
msgstr "Analisi recenti"

#: assets/build/audit.js:6
msgid "Images on the page"
msgstr "Immagini nella pagina"

#: assets/build/audit.js:6
msgid "Choose a page and press Scan. Iminify lists every image on it, each beside the image in your library it is, with what is worth fixing."
msgstr "Scegli una pagina e premi Scansiona. Iminify elenca ogni immagine presente, ciascuna accanto all'immagine della tua libreria a cui corrisponde, con ciò che vale la pena correggere."

#: assets/build/audit.js:6
msgid "Iminify is opening the page and measuring its images. This usually takes less than a minute, and the page shows them as soon as they’re in."
msgstr "Iminify sta aprendo la pagina e misurando le sue immagini. Di solito ci vuole meno di un minuto, e la pagina le mostra non appena sono pronte."

#: assets/build/audit.js:6
msgid "The page showed no images."
msgstr "La pagina non ha mostrato alcuna immagine."

#. translators: 1: how many images the page showed, 2: how many of them have something to fix.
#: assets/build/audit.js:7
#, js-format
msgid "%1$s image on the page, %2$s with something to fix."
msgid_plural "%1$s images on the page, %2$s with something to fix."
msgstr[0] "%1$s immagine nella pagina, %2$s con qualcosa da correggere."
msgstr[1] "%1$s immagini nella pagina, %2$s con qualcosa da correggere."

#: assets/build/audit.js:7
msgid "Nothing to fix: every image on this page is sized, loaded and described well."
msgstr "Niente da correggere: ogni immagine di questa pagina è dimensionata, caricata e descritta bene."

#: assets/build/audit.js:7
msgid "Hide the images with nothing to fix"
msgstr "Nascondi le immagini senza nulla da correggere"

#. translators: %s: how many images have nothing to fix.
#: assets/build/audit.js:8
#, js-format
msgid "Show %s image with nothing to fix"
msgid_plural "Show %s images with nothing to fix"
msgstr[0] "Mostra %s immagine senza nulla da correggere"
msgstr[1] "Mostra %s immagini senza nulla da correggere"

#. translators: %s: how many images.
#: assets/build/audit.js:9
#, js-format
msgid "%s image from your media library is on this page without its width and height, or without the alt text it has in the library. The plugin can add what’s missing to your pages as they’re sent, from the library."
msgid_plural "%s images from your media library are on this page without their width and height, or without the alt text they have in the library. The plugin can add what’s missing to your pages as they’re sent, from the library."
msgstr[0] "%s immagine della tua libreria media si trova in questa pagina senza larghezza e altezza, o senza il testo alternativo che ha nella libreria. Il plugin può aggiungere ciò che manca alle tue pagine mentre vengono servite, prendendolo dalla libreria."
msgstr[1] "%s immagini della tua libreria media si trovano in questa pagina senza larghezza e altezza, o senza il testo alternativo che hanno nella libreria. Il plugin può aggiungere ciò che manca alle tue pagine mentre vengono servite, prendendolo dalla libreria."

#: assets/build/audit.js:9
msgid "Fill them in on every page"
msgstr "Aggiungili in ogni pagina"

#: assets/build/audit.js:9
msgid "Someone who can change the plugin’s settings can turn this on."
msgstr "Può attivarlo chi può modificare le impostazioni del plugin."

#. translators: 1: a size's name, such as "Medium", 2: its width in pixels, 3: its height in pixels.
#: assets/build/audit.js:10
#, js-format
msgid "Use the %1$s size (%2$s × %3$s) where this image is placed. The page’s editor doesn’t hold it: your theme, a template or a widget shows it, and the size is chosen there."
msgstr "Usa la dimensione %1$s (%2$s × %3$s) dove si trova questa immagine. L'editor della pagina non la contiene: la mostra il tuo tema, un template o un widget, ed è lì che si sceglie la dimensione."

#. translators: 1: a size's name, such as "Medium", 2: its width in pixels, 3: its height in pixels.
#: assets/build/audit.js:11
#, js-format
msgid "Use the %1$s size (%2$s × %3$s) here: in the editor, select the image and choose it under Resolution."
msgstr "Usa qui la dimensione %1$s (%2$s × %3$s): nell'editor, seleziona l'immagine e sceglila in Risoluzione."

#: assets/build/audit.js:11
msgid "Edit the page"
msgstr "Modifica la pagina"

#: assets/build/audit.js:11
msgid "The plugin adds them as the page is sent. Scan again to see it."
msgstr "Il plugin li aggiunge mentre la pagina viene servita. Scansiona di nuovo per vederlo."

#: assets/build/audit.js:11
msgid "Iminify is writing the image’s alt text. Scan again once it’s in."
msgstr "Iminify sta scrivendo il testo alternativo dell'immagine. Scansiona di nuovo quando sarà pronto."

#: assets/build/audit.js:11
msgid "Iminify can write it once AI alt text is on for this site."
