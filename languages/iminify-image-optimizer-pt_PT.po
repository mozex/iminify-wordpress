#, js-format
msgid "%s is connected to Iminify. This site can join it with a key of its own, and counts as a site of its own on the account."
msgstr "A rede %s está ligada ao Iminify. Este site pode aderir a ela com uma chave própria, e conta como um site independente na conta."

#: assets/build/settings.js:17
msgid "In WordPress’s rewrite rules:"
msgstr "Nas regras de reescrita do WordPress:"

#: assets/build/settings.js:17
msgid "In <file />:"
msgstr "Em <file />:"

#. translators: %s: another image optimizer's name.
#: assets/build/settings.js:18
#, js-format
msgid "Take %s’s rule out of WordPress’s rewrite rules? Every other rule stays."
msgstr "Retirar a regra de %s das regras de reescrita do WordPress? Todas as outras regras ficam."

#. translators: %s: another image optimizer's name.
#: assets/build/settings.js:19
#, js-format
msgid "Remove %s’s lines from this file? Everything else in it stays as it is. Nginx keeps them until it is reloaded, so reload it afterwards."
msgstr "Remover as linhas de %s deste ficheiro? Tudo o resto fica como está. O Nginx mantém-nas até ser recarregado, por isso recarregue-o depois."

#. translators: %s: another image optimizer's name.
#: assets/build/settings.js:20
#, js-format
msgid "Remove %s’s lines from this file? Everything else in it stays as it is."
msgstr "Remover as linhas de %s deste ficheiro? Tudo o resto fica como está."

#. translators: %s: the first line of another plugin's block, such as "# BEGIN EWWWIO".
#: assets/build/settings.js:21
#, js-format
msgid "<file /> holds the line %s, but the block it starts has no end of its own, or runs across another block, so the plugin leaves the file alone. Remove the block’s lines by hand."
msgstr "<file /> contém a linha %s, mas o bloco que ela inicia não tem um fim próprio, ou atravessa outro bloco, por isso o plugin não mexe no ficheiro. Remova as linhas do bloco manualmente."

#: assets/build/settings.js:21
msgid "The plugin can’t write to <file />. Remove these lines from it by hand, then reload Nginx."
msgstr "O plugin não consegue escrever em <file />. Remova estas linhas manualmente e depois recarregue o Nginx."

#: assets/build/settings.js:21
msgid "The plugin can’t write to <file />. Remove these lines from it by hand."
msgstr "O plugin não consegue escrever em <file />. Remova estas linhas manualmente."

#: assets/build/settings.js:21
msgid "Every site of the network shares these lines, so someone who can manage the network removes them, from the network admin’s Iminify settings."
msgstr "Todos os sites da rede partilham estas linhas, por isso é alguém que pode gerir a rede quem as remove, nas definições do Iminify da administração da rede."

#: assets/build/settings.js:21
msgid "Every site of the network shares these lines, so a super admin removes them, on this page."
msgstr "Todos os sites da rede partilham estas linhas, por isso é um super administrador quem as remove, nesta página."

#. translators: %s: another image optimizer's name.
#: assets/build/settings.js:22
#, js-format
msgid "%s’s rewrite rule"
msgstr "Regra de reescrita de %s"

#. translators: %s: another image optimizer's name.
#: assets/build/settings.js:23
#, js-format
msgid "%s’s rules"
msgstr "Regras de %s"

#: assets/build/settings.js:23
msgid "Rules another optimizer left"
msgstr "Regras deixadas por outro optimizador"

#: assets/build/settings.js:23
msgid "The rules another optimizer left are gone."
msgstr "As regras deixadas por outro optimizador foram removidas."

#: assets/build/settings.js:23
msgid "An image optimizer you had before left these rules behind when it was switched off. Iminify never removes another plugin’s rules by itself."
msgstr "Um optimizador de imagens que usava antes deixou estas regras para trás quando foi desactivado. O Iminify nunca remove por si próprio as regras de outro plugin."

#. translators: %d: how many images.
#: assets/build/settings.js:24
#, js-format
msgid "%d image is being optimized."
msgid_plural "%d images are being optimized."
msgstr[0] "%d imagem está a ser optimizada."
msgstr[1] "%d imagens estão a ser optimizadas."

#. translators: %d: how many images.
#: assets/build/settings.js:25
#, js-format
msgid "%d image is waiting for the next batch."
msgid_plural "%d images are waiting for the next batch."
msgstr[0] "%d imagem está à espera do próximo lote."
msgstr[1] "%d imagens estão à espera do próximo lote."

#. translators: %d: how many images.
#: assets/build/settings.js:26
#, js-format
msgid "%d image is waiting for the site to be connected. It goes out by itself once it is."
msgid_plural "%d images are waiting for the site to be connected. They go out by themselves once it is."
msgstr[0] "%d imagem está à espera de que o site seja ligado. É enviada automaticamente assim que for."
msgstr[1] "%d imagens estão à espera de que o site seja ligado. São enviadas automaticamente assim que for."

#. translators: %s: the date and time the next batch opens.
#: assets/build/settings.js:27
#, js-format
msgid "The next batch opens on %s. New uploads go first, by themselves."
msgstr "O próximo lote abre a %s. Os novos carregamentos vão primeiro, automaticamente."

#: assets/build/settings.js:27
msgid "Queue"
msgstr "Fila"

#: assets/build/settings.js:27
msgid "The server is low on disk space, so Iminify has stopped optimizing images here. Free some up, then optimize the images marked \"Not optimized\"."
msgstr "O servidor tem pouco espaço em disco, por isso o Iminify deixou de optimizar imagens aqui. Liberte algum espaço e depois optimize as imagens marcadas como “Não optimizada”."

#: assets/build/settings.js:27
msgid "Your server answered with an error once the rules were in, so the plugin took them out again and your images load as before. Ask your host whether .htaccess files may set rewrite rules and file types, or choose picture tags."
msgstr "O seu servidor respondeu com um erro depois de as regras serem colocadas, por isso o plugin voltou a retirá-las e as suas imagens carregam como antes. Pergunte ao seu fornecedor de alojamento se os ficheiros .htaccess podem definir regras de reescrita e tipos de ficheiro, ou escolha as etiquetas picture."

#. translators: %s: the date and time of the last check.
#: assets/build/settings.js:28
#, js-format
msgid "Your server sends the WebP and AVIF copies. Checked %s."
msgstr "O seu servidor envia as cópias WebP e AVIF. Verificado a %s."

#. translators: %s: the date and time of the last check.
#: assets/build/settings.js:30
#, js-format
msgid "Your server still sends the originals: something answers for images before these rules are read, often Nginx in front of Apache. Add the Nginx lines below to its configuration, or choose picture tags. Checked %s."
msgstr "O seu servidor ainda envia os originais: algo responde pelas imagens antes de estas regras serem lidas, muitas vezes o Nginx à frente do Apache. Adicione as linhas do Nginx abaixo à configuração dele, ou escolha as etiquetas picture. Verificado a %s."

#. translators: %s: the date and time of the last check.
#: assets/build/settings.js:32
#, js-format
msgid "Your server still sends the originals. Add the lines below to its configuration and reload Nginx, then save again. Checked %s."
msgstr "O seu servidor ainda envia os originais. Adicione as linhas abaixo à configuração dele e recarregue o Nginx, depois guarde de novo. Verificado a %s."

#. translators: %s: the date and time of the last check.
#: assets/build/settings.js:34
#, js-format
msgid "Cloudflare answered with the original, so a visitor may never get a copy through these rules. Choose picture tags, which work behind Cloudflare. Checked %s."
msgstr "A Cloudflare respondeu com o original, por isso um visitante pode nunca receber uma cópia através destas regras. Escolha as etiquetas picture, que funcionam por trás da Cloudflare. Verificado a %s."

#. translators: %s: the date and time of the last check.
#: assets/build/settings.js:35
#, js-format
msgid "The plugin couldn't ask your site for an image to see whether the rules work, which happens when a site can't reach its own address. Open one of your images with a browser's developer tools: its type should read image/avif or image/webp. Tried %s."
msgstr "O plugin não conseguiu pedir uma imagem ao seu site para ver se as regras funcionam, o que acontece quando um site não consegue aceder ao seu próprio endereço. Abra uma das suas imagens com as ferramentas de programador de um navegador: o tipo deve ser image/avif ou image/webp. Última tentativa a %s."

#: assets/build/settings.js:35
msgid "The rules are in <file />."
msgstr "As regras estão em <file />."

#. translators: <file /> is the file's path, <begin /> and <end /> the first and last lines of the plugin's block in it (such as "# BEGIN Iminify"), <closing /> the line </IfModule>.
#: assets/build/settings.js:36
msgid "<file /> holds the line <begin /> without its <end /> line, so the plugin leaves the file alone. Put the line <end /> back after the block’s last <closing />, or delete every line of the block, then save again."
msgstr "<file /> contém a linha <begin /> sem a respectiva linha <end />, por isso o plugin não mexe no ficheiro. Volte a colocar a linha <end /> a seguir à última linha <closing /> do bloco, ou elimine todas as linhas do bloco, e depois guarde de novo."

#: assets/build/settings.js:36
msgid "Your uploads folder isn't inside the folder that holds the site's .htaccess file, so no rule there can name it. Choose picture tags."
msgstr "A sua pasta de carregamentos não está dentro da pasta que contém o ficheiro .htaccess do site, por isso nenhuma regra nesse ficheiro a pode indicar. Escolha as etiquetas picture."

#: assets/build/settings.js:36
msgid "There’s no <file /> yet. Create it with these lines, then save again."
msgstr "Ainda não existe <file />. Crie-o com estas linhas e depois guarde de novo."

#: assets/build/settings.js:36
msgid "<file /> doesn’t turn on rewriting, so the plugin leaves it alone. If your server reads rewrite rules there, paste these lines into it, then save again."
msgstr "<file /> não activa a reescrita, por isso o plugin não lhe mexe. Se o seu servidor lê regras de reescrita nesse ficheiro, cole nele estas linhas e depois guarde de novo."

#: assets/build/settings.js:36
msgid "The plugin can’t write to <file />. Paste these lines into it, above the rules WordPress gave the network, then save again."
msgstr "O plugin não consegue escrever em <file />. Cole nele estas linhas, acima das regras que o WordPress indicou para a rede, e depois guarde de novo."

#: assets/build/settings.js:36
msgid "The plugin can’t write to <file />. Paste these lines at its end, then save again."
msgstr "O plugin não consegue escrever em <file />. Cole estas linhas no fim do ficheiro e depois guarde de novo."

#: assets/build/settings.js:36
msgid "Your server reads neither .htaccess files nor Nginx's configuration, so the plugin has no rules to give it. Choose picture tags."
msgstr "O seu servidor não lê ficheiros .htaccess nem a configuração do Nginx, por isso o plugin não tem regras para lhe dar. Escolha as etiquetas picture."

#: assets/build/settings.js:36
msgid "Your site runs on Nginx, which doesn't read .htaccess. Put the first lines at the top of the site's server block, before any if or rewrite, and the location above any other location for images, then reload Nginx. Copy into the location any expires, Cache-Control or add_header lines your images need, since its add_header replaces the server block's:"
msgstr "O seu site corre em Nginx, que não lê .htaccess. Coloque as primeiras linhas no topo do bloco server do site, antes de qualquer if ou rewrite, e o location acima de qualquer outro location para imagens, e depois recarregue o Nginx. Copie para o location as linhas expires, Cache-Control ou add_header de que as suas imagens precisem, porque o add_header dele substitui o do bloco server:"

#: assets/build/settings.js:36
msgid "For Nginx, put the first lines at the top of the site's server block, before any if or rewrite, and the location above any other location for images, then reload Nginx. Copy into the location any expires, Cache-Control or add_header lines your images need, since its add_header replaces the server block's:"
msgstr "Para o Nginx, coloque as primeiras linhas no topo do bloco server do site, antes de qualquer if ou rewrite, e o location acima de qualquer outro location para imagens, e depois recarregue o Nginx. Copie para o location as linhas expires, Cache-Control ou add_header de que as suas imagens precisem, porque o add_header dele substitui o do bloco server:"

#. translators: %s: the folders the rules cover, separated by commas.
#: assets/build/settings.js:37
#, js-format
msgid "They cover: %s."
msgstr "Abrangem: %s."

#: assets/build/settings.js:37
msgid "They serve any WebP or AVIF copy named after an image beside it, so a copy another optimizer left there is served too until Iminify makes its own. Iminify never deletes another plugin’s copies."
msgstr "Servem qualquer cópia WebP ou AVIF com o nome de uma imagem ao lado dela, por isso uma cópia que outro optimizador lá deixou também é servida até o Iminify fazer a sua. O Iminify nunca elimina as cópias de outro plugin."

#: assets/build/settings.js:37
msgid "Cloudflare answers for your site. It keeps one version of each image whatever the browser reads, so a browser that can't show AVIF could get the AVIF copy. Choose picture tags, which work behind any CDN."
msgstr "A Cloudflare responde pelo seu site. Guarda uma única versão de cada imagem, seja qual for o navegador, por isso um navegador que não consegue mostrar AVIF pode receber a cópia AVIF. Escolha as etiquetas picture, que funcionam por trás de qualquer CDN."

#: assets/build/settings.js:37
msgid "WP Offload Media serves your images from its bucket, which these rules never reach, so those keep their originals. With its “Remove Local Media” on, the rules serve nothing."
msgstr "O WP Offload Media serve as suas imagens a partir do bucket dele, que estas regras nunca alcançam, por isso essas imagens mantêm os originais. Com a opção “Remove Local Media” activa, as regras não servem nada."

#: assets/build/settings.js:37
msgid "Also reaches the images in raw HTML, page builders and your theme's own markup, the backgrounds set in the page itself, and the images in the folders you chose, by reading each page as it's sent. A background set in a stylesheet file keeps its original. A page your cache hasn't kept takes a little longer."
msgstr "Também alcança as imagens em HTML puro, em construtores de páginas e no código do próprio tema, os fundos definidos na própria página e as imagens das pastas que escolheu, lendo cada página à medida que é enviada. Um fundo definido num ficheiro de folha de estilos mantém o original. Uma página que a sua cache não guardou demora um pouco mais."

#: assets/build/settings.js:37
msgid "Your pages stay as they are, and your server sends the WebP or AVIF copy in place of the image to each browser that reads it. That reaches every image in the uploads folder and the folders you chose, backgrounds in stylesheet files too. Needs rules in your server’s configuration, written for you on Apache, and behind a CDN, one that keeps a version of each image per format."
msgstr "As suas páginas ficam como estão, e o seu servidor envia a cópia WebP ou AVIF em vez da imagem a cada navegador que a lê. Isto alcança todas as imagens da pasta de carregamentos e das pastas que escolheu, incluindo os fundos em ficheiros de folhas de estilos. Precisa de regras na configuração do seu servidor, que o plugin escreve automaticamente no Apache, e, por trás de uma CDN, de uma que guarde uma versão de cada imagem por formato."

#: assets/build/settings.js:37
msgid "Your pages stay as they are: the copies are made, but no page names them."
msgstr "As suas páginas ficam como estão: as cópias são criadas, mas nenhuma página as indica."

#: assets/build/settings.js:37
msgid "For the images in your posts and those your theme shows through WordPress. Each page is the same for every visitor, so page caches and CDNs keep working, and a browser that reads neither format gets the original."
msgstr "Para as imagens dos seus artigos e as que o seu tema mostra através do WordPress. Cada página é igual para todos os visitantes, por isso as caches de página e as CDN continuam a funcionar, e um navegador que não lê nenhum dos formatos recebe o original."

#: assets/build/settings.js:37
msgid "Optimization"
msgstr "Optimização"

#: assets/build/settings.js:37
msgid "These settings are kept with the site on iminify.com, which applies them to every image the site sends."
msgstr "Estas definições ficam guardadas com o site no iminify.com, que as aplica a todas as imagens que o site envia."

#: assets/build/settings.js:37
msgid "Send each image to Iminify as it is uploaded."
msgstr "Enviar cada imagem para o Iminify quando é carregada."

#: assets/build/settings.js:37
msgid "A WebP copy of every size, served to browsers that read it. A copy larger than its image isn't kept."
msgstr "Uma cópia WebP de cada tamanho, servida aos navegadores que a suportam. Uma cópia maior do que a imagem não é guardada."

#: assets/build/settings.js:37
msgid "An AVIF copy of every size too: usually smaller than WebP, and slower to make."
msgstr "Também uma cópia AVIF de cada tamanho: normalmente mais pequena do que a WebP, e mais lenta a criar."

#: assets/build/settings.js:37
msgid "Any width"
msgstr "Qualquer largura"

#: assets/build/settings.js:37
msgid "Shrinks a wider main image to this width. Leave it empty to keep each image's width."
msgstr "Reduz uma imagem principal mais larga para esta largura. Deixe vazio para manter a largura de cada imagem."

#: assets/build/settings.js:37
msgid "Fits the main image under this size. Leave it empty for no limit."
msgstr "Ajusta a imagem principal para ficar abaixo deste tamanho. Deixe vazio para não ter limite."

#: assets/build/settings.js:37
msgid "Keeps each image's EXIF data, such as the camera and the place it was taken. Off removes it."
msgstr "Mantém os dados EXIF de cada imagem, como a câmara e o local onde foi tirada. Se desactivado, são removidos."

#: assets/build/settings.js:37
msgid "Describes each image that has no alt text. An alt text you wrote is never replaced. A small copy of the image goes to Anthropic's AI, and each one counts against your AI alt texts for the day."
msgstr "Descreve cada imagem que não tem texto alternativo. Um texto alternativo escrito por si nunca é substituído. Uma cópia pequena da imagem vai para a IA da Anthropic, e cada uma conta para os seus textos alternativos com IA do dia."

#: assets/build/settings.js:37
msgid "Language of the alt text"
msgstr "Idioma do texto alternativo"

#: assets/build/settings.js:37
msgid "Optimize every size"
msgstr "Optimizar todos os tamanhos"

#: assets/build/settings.js:37
msgid "Every size WordPress makes of an upload. Turn it off to pick the sizes."
msgstr "Todos os tamanhos que o WordPress cria a partir de um carregamento. Desactive para escolher os tamanhos."

#: assets/build/settings.js:37
msgid "On this site"
msgstr "Neste site"

#: assets/build/settings.js:37
msgid "Kept in the uploads folder under iminify-backup, so any image can be restored as it was."
msgstr "Guardadas na pasta de carregamentos em iminify-backup, para que qualquer imagem possa ser reposta como era."

#: assets/build/settings.js:37
msgid "WebP and AVIF on your pages"
msgstr "WebP e AVIF nas suas páginas"

#: assets/build/settings.js:37
msgid "Serve them with picture tags"
msgstr "Servir com etiquetas picture"

#: assets/build/settings.js:37
msgid "Serve them on the whole page"
msgstr "Servir na página inteira"

#: assets/build/settings.js:37
msgid "Serve them through server rules"
msgstr "Servir através de regras do servidor"

#: assets/build/settings.js:37
msgid "Don't change the pages"
msgstr "Não alterar as páginas"

#: assets/build/settings.js:37
msgid "Add the width, height and alt text images lack"
msgstr "Acrescentar a largura, a altura e o texto alternativo em falta nas imagens"

#: assets/build/settings.js:37
msgid "Where a page’s markup leaves them out of an image from your media library, the plugin adds its width and height, so the page doesn’t jump as it loads, and the alt text it has in the library, as each page is sent. An alt text left empty on purpose stays empty."
msgstr "Quando o código de uma página os omite numa imagem da sua biblioteca multimédia, o plugin acrescenta a largura e a altura, para que a página não salte enquanto carrega, e o texto alternativo que a imagem tem na biblioteca, à medida que cada página é enviada. Um texto alternativo deixado vazio de propósito fica vazio."

#: assets/build/settings.js:37
msgid "When you delete the plugin"
msgstr "Quando eliminar o plugin"

#: assets/build/settings.js:37
msgid "Also delete the WebP and AVIF copies"
msgstr "Eliminar também as cópias WebP e AVIF"

#: assets/build/settings.js:37
msgid "A page your cache kept with picture tags would show a broken image until the cache is cleared."
msgstr "Uma página que a sua cache guardou com etiquetas picture mostraria uma imagem partida até a cache ser limpa."

#: assets/build/settings.js:37
msgid "Also delete the backups"
msgstr "Eliminar também as cópias de segurança"

#: assets/build/settings.js:37
msgid "They're the only originals of the images Iminify optimized, so those images can't be restored afterwards. With the copies deleted too, installing the plugin again would optimize those images a second time."
msgstr "São os únicos originais das imagens que o Iminify optimizou, por isso essas imagens não podem ser repostas depois. Com as cópias também eliminadas, instalar o plugin de novo optimizaria essas imagens uma segunda vez."

#: assets/build/settings.js:37
msgid "Save changes"
msgstr "Guardar alterações"

#: assets/build/settings.js:37
msgid "Unsaved changes"
msgstr "Alterações não guardadas"

#: assets/build/settings.js:37
msgid "Needs attention"
msgstr "Requer atenção"

#: assets/build/settings.js:37
msgid "The network is connected."
msgstr "A rede está ligada."

#: assets/build/settings.js:37
msgid "The site is connected."
msgstr "O site está ligado."

#: assets/build/settings.js:37
msgid "The connection wasn't approved in time, or was turned down. Press Connect the network to try again."
msgstr "A ligação não foi aprovada a tempo, ou foi recusada. Prima Ligar a rede para tentar de novo."

#: assets/build/settings.js:37
msgid "The connection wasn't approved in time, or was turned down. Press Connect to try again."
msgstr "A ligação não foi aprovada a tempo, ou foi recusada. Prima Ligar para tentar de novo."

#: assets/build/settings.js:37
msgid "The network is disconnected here, but its key couldn't be stopped on Iminify. Disconnect it under Settings, Sites on iminify.com too."
msgstr "A rede está desligada aqui, mas não foi possível desactivar a chave dela no Iminify. Desligue-a também em Settings, Sites no iminify.com."

#: assets/build/settings.js:37
msgid "The site is disconnected here, but its key couldn't be stopped on Iminify. Disconnect it under Settings, Sites on iminify.com too."
msgstr "O site está desligado aqui, mas não foi possível desactivar a chave dele no Iminify. Desligue-o também em Settings, Sites no iminify.com."

#: assets/build/settings.js:37
msgid "The site joined the network."
msgstr "O site aderiu à rede."

#: assets/build/settings.js:37
msgid "Move the connection here"
msgstr "Mover a ligação para aqui"

#: assets/build/settings.js:37
msgid "Connect this copy as its own site"
msgstr "Ligar esta cópia como um site independente"

#. translators: %s: another image optimizer's name.
#: assets/build/settings.js:38
#, js-format
msgid "This site now uses %s’s settings."
msgstr "Este site usa agora as definições de %s."

#: assets/build/settings.js:38
msgid "The lines are removed. Reload Nginx so it stops serving them."
msgstr "As linhas foram removidas. Recarregue o Nginx para que deixe de as servir."

#: assets/build/settings.js:38
msgid "The lines are removed."
msgstr "As linhas foram removidas."

#: assets/build/settings.js:38
msgid "Settings saved."
msgstr "Opções guardadas."

#: assets/build/settings.js:38
msgid "The images waiting are on their way."
msgstr "As imagens em espera estão a caminho."

#: assets/build/settings.js:38
msgid "Your account's images for the day are still used up."
msgstr "As imagens do dia da sua conta continuam esgotadas."

#: assets/build/settings.js:38
msgid "Iminify disconnected the network, so new uploads on its sites aren't optimized. Connect it again to carry on."
msgstr "O Iminify desligou a rede, por isso os novos carregamentos nos seus sites não são optimizados. Ligue-a de novo para continuar."

#: assets/build/settings.js:38
msgid "Iminify disconnected the network, so new uploads aren't optimized. A super admin connects it again in the network admin."
msgstr "O Iminify desligou a rede, por isso os novos carregamentos não são optimizados. Um super administrador liga-a de novo na administração da rede."

#: assets/build/settings.js:38
msgid "Iminify disconnected this site, so new uploads aren't optimized. Join the network again, or connect the site on its own, to carry on."
msgstr "O Iminify desligou este site, por isso os novos carregamentos não são optimizados. Adira de novo à rede, ou ligue o site de forma independente, para continuar."

#: assets/build/settings.js:38
msgid "Iminify disconnected this site, so new uploads aren't optimized. Connect it again to carry on."
msgstr "O Iminify desligou este site, por isso os novos carregamentos não são optimizados. Ligue-o de novo para continuar."
