msgstr "Uma agência adiciona a rede em Settings, Sites no iminify.com, com “This is a multisite network” assinalado, e cola a chave aqui, ou define-a em wp-config.php como <code>IMINIFY_API_KEY</code>."

#: assets/build/settings.js:9
msgid "Each upload is optimized in the background"
msgstr "Cada carregamento é optimizado em segundo plano"

