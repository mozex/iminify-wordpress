msgstr "Retirar a regra do %s das regras de reescrita do WordPress? Todas as outras regras ficam."

#. translators: %s: another image optimizer's name.
#: assets/build/settings.js:19
#, js-format
msgid "Remove %s’s lines from this file? Everything else in it stays as it is. Nginx keeps them until it is reloaded, so reload it afterwards."
msgstr "Remover as linhas do %s deste arquivo? Todo o resto dele fica como está. O Nginx as mantém até ser recarregado, então recarregue-o depois."

#. translators: %s: another image optimizer's name.
#: assets/build/settings.js:20
#, js-format
msgid "Remove %s’s lines from this file? Everything else in it stays as it is."
msgstr "Remover as linhas do %s deste arquivo? Todo o resto dele fica como está."

#. translators: %s: the first line of another plugin's block, such as "# BEGIN EWWWIO".
#: assets/build/settings.js:21
#, js-format
msgid "<file /> holds the line %s, but the block it starts has no end of its own, or runs across another block, so the plugin leaves the file alone. Remove the block’s lines by hand."
msgstr "<file /> contém a linha %s, mas o bloco que ela inicia não tem um fim próprio, ou se estende por outro bloco, então o plugin não mexe no arquivo. Remova as linhas do bloco manualmente."

#: assets/build/settings.js:21
msgid "The plugin can’t write to <file />. Remove these lines from it by hand, then reload Nginx."
msgstr "O plugin não consegue gravar em <file />. Remova estas linhas dele manualmente e depois recarregue o Nginx."

#: assets/build/settings.js:21
msgid "The plugin can’t write to <file />. Remove these lines from it by hand."
msgstr "O plugin não consegue gravar em <file />. Remova estas linhas dele manualmente."

#: assets/build/settings.js:21
msgid "Every site of the network shares these lines, so someone who can manage the network removes them, from the network admin’s Iminify settings."
msgstr "Todos os sites da rede compartilham estas linhas, então quem pode gerenciar a rede as remove, nas configurações do Iminify do painel da rede."

#: assets/build/settings.js:21
msgid "Every site of the network shares these lines, so a super admin removes them, on this page."
msgstr "Todos os sites da rede compartilham estas linhas, então um super administrador as remove, nesta página."

#. translators: %s: another image optimizer's name.
#: assets/build/settings.js:22
#, js-format
msgid "%s’s rewrite rule"
msgstr "Regra de reescrita do %s"

#. translators: %s: another image optimizer's name.
#: assets/build/settings.js:23
#, js-format
msgid "%s’s rules"
msgstr "Regras do %s"

#: assets/build/settings.js:23
msgid "Rules another optimizer left"
msgstr "Regras deixadas por outro otimizador"

#: assets/build/settings.js:23
msgid "The rules another optimizer left are gone."
msgstr "As regras deixadas por outro otimizador foram removidas."

#: assets/build/settings.js:23
msgid "An image optimizer you had before left these rules behind when it was switched off. Iminify never removes another plugin’s rules by itself."
msgstr "Um otimizador de imagens que você usava antes deixou estas regras para trás quando foi desativado. O Iminify nunca remove as regras de outro plugin por conta própria."

#. translators: %d: how many images.
#: assets/build/settings.js:24
#, js-format
msgid "%d image is being optimized."
msgid_plural "%d images are being optimized."
msgstr[0] "%d imagem está sendo otimizada."
msgstr[1] "%d imagens estão sendo otimizadas."

#. translators: %d: how many images.
#: assets/build/settings.js:25
#, js-format
msgid "%d image is waiting for the next batch."
msgid_plural "%d images are waiting for the next batch."
msgstr[0] "%d imagem está aguardando o próximo lote."
msgstr[1] "%d imagens estão aguardando o próximo lote."

#. translators: %d: how many images.
#: assets/build/settings.js:26
#, js-format
msgid "%d image is waiting for the site to be connected. It goes out by itself once it is."
msgid_plural "%d images are waiting for the site to be connected. They go out by themselves once it is."
msgstr[0] "%d imagem está aguardando o site ser conectado. Ela será enviada automaticamente assim que ele for."
msgstr[1] "%d imagens estão aguardando o site ser conectado. Elas serão enviadas automaticamente assim que ele for."

#. translators: %s: the date and time the next batch opens.
#: assets/build/settings.js:27
#, js-format
msgid "The next batch opens on %s. New uploads go first, by themselves."
msgstr "O próximo lote abre em %s. Os novos envios vão primeiro, automaticamente."

#: assets/build/settings.js:27
msgid "Queue"
msgstr "Fila"

#: assets/build/settings.js:27
msgid "The server is low on disk space, so Iminify has stopped optimizing images here. Free some up, then optimize the images marked \"Not optimized\"."
msgstr "O servidor está com pouco espaço em disco, então o Iminify parou de otimizar imagens aqui. Libere espaço e depois otimize as imagens marcadas como \"Não otimizada\"."

#: assets/build/settings.js:27
msgid "Your server answered with an error once the rules were in, so the plugin took them out again and your images load as before. Ask your host whether .htaccess files may set rewrite rules and file types, or choose picture tags."
msgstr "Seu servidor respondeu com um erro assim que as regras foram aplicadas, então o plugin as retirou e suas imagens carregam como antes. Pergunte à sua hospedagem se arquivos .htaccess podem definir regras de reescrita e tipos de arquivo, ou escolha tags picture."

#. translators: %s: the date and time of the last check.
#: assets/build/settings.js:28
#, js-format
msgid "Your server sends the WebP and AVIF copies. Checked %s."
msgstr "Seu servidor envia as cópias WebP e AVIF. Verificado em %s."

#. translators: %s: the date and time of the last check.
#: assets/build/settings.js:30
#, js-format
msgid "Your server still sends the originals: something answers for images before these rules are read, often Nginx in front of Apache. Add the Nginx lines below to its configuration, or choose picture tags. Checked %s."
msgstr "Seu servidor ainda envia os originais: algo responde pelas imagens antes que estas regras sejam lidas, muitas vezes o Nginx na frente do Apache. Adicione as linhas do Nginx abaixo à configuração dele, ou escolha tags picture. Verificado em %s."

#. translators: %s: the date and time of the last check.
#: assets/build/settings.js:32
#, js-format
msgid "Your server still sends the originals. Add the lines below to its configuration and reload Nginx, then save again. Checked %s."
msgstr "Seu servidor ainda envia os originais. Adicione as linhas abaixo à configuração dele e recarregue o Nginx, depois salve novamente. Verificado em %s."

#. translators: %s: the date and time of the last check.
#: assets/build/settings.js:34
#, js-format
msgid "Cloudflare answered with the original, so a visitor may never get a copy through these rules. Choose picture tags, which work behind Cloudflare. Checked %s."
msgstr "A Cloudflare respondeu com o original, então um visitante pode nunca receber uma cópia por meio destas regras. Escolha tags picture, que funcionam atrás da Cloudflare. Verificado em %s."

#. translators: %s: the date and time of the last check.
#: assets/build/settings.js:35
#, js-format
msgid "The plugin couldn't ask your site for an image to see whether the rules work, which happens when a site can't reach its own address. Open one of your images with a browser's developer tools: its type should read image/avif or image/webp. Tried %s."
msgstr "O plugin não conseguiu pedir uma imagem ao seu site para ver se as regras funcionam, o que acontece quando um site não consegue acessar o próprio endereço. Abra uma das suas imagens com as ferramentas de desenvolvedor de um navegador: o tipo dela deve ser image/avif ou image/webp. Tentativa em %s."

#: assets/build/settings.js:35
msgid "The rules are in <file />."
msgstr "As regras estão em <file />."

#. translators: <file /> is the file's path, <begin /> and <end /> the first and last lines of the plugin's block in it (such as "# BEGIN Iminify"), <closing /> the line </IfModule>.
#: assets/build/settings.js:36
msgid "<file /> holds the line <begin /> without its <end /> line, so the plugin leaves the file alone. Put the line <end /> back after the block’s last <closing />, or delete every line of the block, then save again."
msgstr "<file /> contém a linha <begin /> sem a linha <end />, então o plugin não mexe no arquivo. Coloque a linha <end /> de volta depois da última linha <closing /> do bloco, ou exclua todas as linhas do bloco, e depois salve novamente."

#: assets/build/settings.js:36
msgid "Your uploads folder isn't inside the folder that holds the site's .htaccess file, so no rule there can name it. Choose picture tags."
msgstr "Sua pasta de uploads não está dentro da pasta que contém o arquivo .htaccess do site, então nenhuma regra ali pode apontar para ela. Escolha tags picture."

#: assets/build/settings.js:36
msgid "There’s no <file /> yet. Create it with these lines, then save again."
msgstr "Ainda não existe <file />. Crie-o com estas linhas e depois salve novamente."

#: assets/build/settings.js:36
msgid "<file /> doesn’t turn on rewriting, so the plugin leaves it alone. If your server reads rewrite rules there, paste these lines into it, then save again."
msgstr "<file /> não ativa a reescrita, então o plugin não mexe nele. Se o seu servidor lê regras de reescrita ali, cole estas linhas nele e depois salve novamente."

#: assets/build/settings.js:36
msgid "The plugin can’t write to <file />. Paste these lines into it, above the rules WordPress gave the network, then save again."
msgstr "O plugin não consegue gravar em <file />. Cole estas linhas nele, acima das regras que o WordPress deu à rede, e depois salve novamente."

#: assets/build/settings.js:36
msgid "The plugin can’t write to <file />. Paste these lines at its end, then save again."
msgstr "O plugin não consegue gravar em <file />. Cole estas linhas no final dele e depois salve novamente."

#: assets/build/settings.js:36
msgid "Your server reads neither .htaccess files nor Nginx's configuration, so the plugin has no rules to give it. Choose picture tags."
msgstr "Seu servidor não lê arquivos .htaccess nem a configuração do Nginx, então o plugin não tem regras para dar a ele. Escolha tags picture."

#: assets/build/settings.js:36
msgid "Your site runs on Nginx, which doesn't read .htaccess. Put the first lines at the top of the site's server block, before any if or rewrite, and the location above any other location for images, then reload Nginx. Copy into the location any expires, Cache-Control or add_header lines your images need, since its add_header replaces the server block's:"
msgstr "Seu site roda no Nginx, que não lê .htaccess. Coloque as primeiras linhas no topo do bloco server do site, antes de qualquer if ou rewrite, e o location acima de qualquer outro location para imagens, e depois recarregue o Nginx. Copie para dentro do location as linhas expires, Cache-Control ou add_header de que suas imagens precisam, já que o add_header dele substitui o do bloco server:"

#: assets/build/settings.js:36
msgid "For Nginx, put the first lines at the top of the site's server block, before any if or rewrite, and the location above any other location for images, then reload Nginx. Copy into the location any expires, Cache-Control or add_header lines your images need, since its add_header replaces the server block's:"
msgstr "Para o Nginx, coloque as primeiras linhas no topo do bloco server do site, antes de qualquer if ou rewrite, e o location acima de qualquer outro location para imagens, e depois recarregue o Nginx. Copie para dentro do location as linhas expires, Cache-Control ou add_header de que suas imagens precisam, já que o add_header dele substitui o do bloco server:"

#. translators: %s: the folders the rules cover, separated by commas.
#: assets/build/settings.js:37
#, js-format
msgid "They cover: %s."
msgstr "Elas cobrem: %s."

#: assets/build/settings.js:37
msgid "They serve any WebP or AVIF copy named after an image beside it, so a copy another optimizer left there is served too until Iminify makes its own. Iminify never deletes another plugin’s copies."
msgstr "Elas servem qualquer cópia WebP ou AVIF com o nome de uma imagem ao lado dela, então uma cópia que outro otimizador deixou ali também é servida até que o Iminify faça a própria. O Iminify nunca exclui as cópias de outro plugin."

#: assets/build/settings.js:37
msgid "Cloudflare answers for your site. It keeps one version of each image whatever the browser reads, so a browser that can't show AVIF could get the AVIF copy. Choose picture tags, which work behind any CDN."
msgstr "A Cloudflare responde pelo seu site. Ela mantém uma versão de cada imagem, independentemente do que o navegador lê, então um navegador que não consegue exibir AVIF poderia receber a cópia AVIF. Escolha tags picture, que funcionam atrás de qualquer CDN."

#: assets/build/settings.js:37
msgid "WP Offload Media serves your images from its bucket, which these rules never reach, so those keep their originals. With its “Remove Local Media” on, the rules serve nothing."
msgstr "O WP Offload Media serve suas imagens a partir do bucket dele, que estas regras nunca alcançam, então essas imagens mantêm os originais. Com o “Remove Local Media” dele ativado, as regras não servem nada."

#: assets/build/settings.js:37
msgid "Also reaches the images in raw HTML, page builders and your theme's own markup, the backgrounds set in the page itself, and the images in the folders you chose, by reading each page as it's sent. A background set in a stylesheet file keeps its original. A page your cache hasn't kept takes a little longer."
msgstr "Também alcança as imagens em HTML puro, em construtores de página e na marcação do próprio tema, os fundos definidos na própria página e as imagens das pastas que você escolheu, lendo cada página ao ser servida. Um fundo definido em um arquivo de folha de estilo mantém o original. Uma página que seu cache não armazenou demora um pouco mais."

#: assets/build/settings.js:37
msgid "Your pages stay as they are, and your server sends the WebP or AVIF copy in place of the image to each browser that reads it. That reaches every image in the uploads folder and the folders you chose, backgrounds in stylesheet files too. Needs rules in your server’s configuration, written for you on Apache, and behind a CDN, one that keeps a version of each image per format."
msgstr "Suas páginas ficam como estão, e seu servidor envia a cópia WebP ou AVIF no lugar da imagem a cada navegador que a lê. Isso alcança todas as imagens da pasta de uploads e das pastas que você escolheu, inclusive fundos em arquivos de folha de estilo. Exige regras na configuração do seu servidor, escritas para você no Apache, e, atrás de uma CDN, uma que mantenha uma versão de cada imagem por formato."

#: assets/build/settings.js:37
msgid "Your pages stay as they are: the copies are made, but no page names them."
msgstr "Suas páginas ficam como estão: as cópias são geradas, mas nenhuma página as usa."

#: assets/build/settings.js:37
msgid "For the images in your posts and those your theme shows through WordPress. Each page is the same for every visitor, so page caches and CDNs keep working, and a browser that reads neither format gets the original."
msgstr "Para as imagens dos seus posts e as que seu tema mostra por meio do WordPress. Cada página é igual para todos os visitantes, então caches de página e CDNs continuam funcionando, e um navegador que não lê nenhum dos dois formatos recebe o original."

#: assets/build/settings.js:37
msgid "Optimization"
msgstr "Otimização"

#: assets/build/settings.js:37
msgid "These settings are kept with the site on iminify.com, which applies them to every image the site sends."
msgstr "Estas configurações ficam com o site no iminify.com, que as aplica a cada imagem que o site envia."

#: assets/build/settings.js:37
msgid "Send each image to Iminify as it is uploaded."
msgstr "Manda cada imagem para o Iminify assim que ela é enviada."

#: assets/build/settings.js:37
msgid "A WebP copy of every size, served to browsers that read it. A copy larger than its image isn't kept."
msgstr "Uma cópia WebP de cada tamanho, servida aos navegadores que a leem. Uma cópia maior que a imagem não é mantida."

#: assets/build/settings.js:37
msgid "An AVIF copy of every size too: usually smaller than WebP, and slower to make."
msgstr "Também uma cópia AVIF de cada tamanho: geralmente menor que a WebP, e mais lenta para gerar."

#: assets/build/settings.js:37
msgid "Any width"
msgstr "Qualquer largura"

#: assets/build/settings.js:37
msgid "Shrinks a wider main image to this width. Leave it empty to keep each image's width."
msgstr "Reduz uma imagem principal mais larga para esta largura. Deixe em branco para manter a largura de cada imagem."

#: assets/build/settings.js:37
msgid "Fits the main image under this size. Leave it empty for no limit."
msgstr "Reduz a imagem principal até caber neste tamanho. Deixe em branco para não ter limite."

#: assets/build/settings.js:37
msgid "Keeps each image's EXIF data, such as the camera and the place it was taken. Off removes it."
msgstr "Mantém os dados EXIF de cada imagem, como a câmera e o local onde ela foi tirada. Desativado, eles são removidos."

#: assets/build/settings.js:37
msgid "Describes each image that has no alt text. An alt text you wrote is never replaced. A small copy of the image goes to Anthropic's AI, and each one counts against your AI alt texts for the day."
msgstr "Descreve cada imagem que não tem texto alternativo. Um texto alternativo escrito por você nunca é substituído. Uma versão reduzida da imagem vai para a IA da Anthropic, e cada uma conta para os seus textos alternativos com IA do dia."

#: assets/build/settings.js:37
msgid "Language of the alt text"
msgstr "Idioma do texto alternativo"

#: assets/build/settings.js:37
msgid "Optimize every size"
msgstr "Otimizar todos os tamanhos"

#: assets/build/settings.js:37
msgid "Every size WordPress makes of an upload. Turn it off to pick the sizes."
msgstr "Todos os tamanhos que o WordPress gera de um envio. Desative para escolher os tamanhos."

#: assets/build/settings.js:37
msgid "On this site"
msgstr "Neste site"

#: assets/build/settings.js:37
msgid "Kept in the uploads folder under iminify-backup, so any image can be restored as it was."
msgstr "Mantidos na pasta de uploads, em iminify-backup, para que qualquer imagem possa ser restaurada como era."

#: assets/build/settings.js:37
msgid "WebP and AVIF on your pages"
msgstr "WebP e AVIF nas suas páginas"

#: assets/build/settings.js:37
msgid "Serve them with picture tags"
msgstr "Servir com tags picture"

#: assets/build/settings.js:37
msgid "Serve them on the whole page"
msgstr "Servir na página inteira"

#: assets/build/settings.js:37
msgid "Serve them through server rules"
msgstr "Servir por regras do servidor"

#: assets/build/settings.js:37
msgid "Don't change the pages"
msgstr "Não alterar as páginas"

#: assets/build/settings.js:37
msgid "Add the width, height and alt text images lack"
msgstr "Adicionar a largura, a altura e o texto alternativo que faltam nas imagens"

#: assets/build/settings.js:37
msgid "Where a page’s markup leaves them out of an image from your media library, the plugin adds its width and height, so the page doesn’t jump as it loads, and the alt text it has in the library, as each page is sent. An alt text left empty on purpose stays empty."
msgstr "Quando a marcação de uma página os deixa de fora em uma imagem da sua biblioteca de mídia, o plugin adiciona a largura e a altura dela, para que a página não pule ao carregar, e o texto alternativo que ela tem na biblioteca, ao servir cada página. Um texto alternativo deixado vazio de propósito continua vazio."

#: assets/build/settings.js:37
msgid "When you delete the plugin"
msgstr "Ao excluir o plugin"

#: assets/build/settings.js:37
msgid "Also delete the WebP and AVIF copies"
msgstr "Também excluir as cópias WebP e AVIF"

#: assets/build/settings.js:37
msgid "A page your cache kept with picture tags would show a broken image until the cache is cleared."
msgstr "Uma página que seu cache armazenou com tags picture mostraria uma imagem quebrada até o cache ser limpo."

#: assets/build/settings.js:37
msgid "Also delete the backups"
msgstr "Também excluir os backups"

#: assets/build/settings.js:37
msgid "They're the only originals of the images Iminify optimized, so those images can't be restored afterwards. With the copies deleted too, installing the plugin again would optimize those images a second time."
msgstr "Eles são os únicos originais das imagens que o Iminify otimizou, então essas imagens não poderão ser restauradas depois. Com as cópias também excluídas, instalar o plugin novamente otimizaria essas imagens uma segunda vez."

#: assets/build/settings.js:37
msgid "Save changes"
msgstr "Salvar alterações"

#: assets/build/settings.js:37
msgid "Unsaved changes"
msgstr "Alterações não salvas"

#: assets/build/settings.js:37
msgid "Needs attention"
msgstr "Requer atenção"

#: assets/build/settings.js:37
msgid "The network is connected."
msgstr "A rede está conectada."

#: assets/build/settings.js:37
msgid "The site is connected."
msgstr "O site está conectado."

#: assets/build/settings.js:37
msgid "The connection wasn't approved in time, or was turned down. Press Connect the network to try again."
msgstr "A conexão não foi aprovada a tempo, ou foi recusada. Clique em Conectar a rede para tentar novamente."

#: assets/build/settings.js:37
msgid "The connection wasn't approved in time, or was turned down. Press Connect to try again."
msgstr "A conexão não foi aprovada a tempo, ou foi recusada. Clique em Conectar para tentar novamente."

#: assets/build/settings.js:37
msgid "The network is disconnected here, but its key couldn't be stopped on Iminify. Disconnect it under Settings, Sites on iminify.com too."
msgstr "A rede foi desconectada aqui, mas não foi possível desativar a chave dela no Iminify. Desconecte-a também em Settings, Sites no iminify.com."

#: assets/build/settings.js:37
msgid "The site is disconnected here, but its key couldn't be stopped on Iminify. Disconnect it under Settings, Sites on iminify.com too."
msgstr "O site foi desconectado aqui, mas não foi possível desativar a chave dele no Iminify. Desconecte-o também em Settings, Sites no iminify.com."

#: assets/build/settings.js:37
msgid "The site joined the network."
msgstr "O site entrou na rede."

#: assets/build/settings.js:37
msgid "Move the connection here"
msgstr "Mover a conexão para cá"

#: assets/build/settings.js:37
msgid "Connect this copy as its own site"
msgstr "Conectar este clone como um site próprio"

#. translators: %s: another image optimizer's name.
#: assets/build/settings.js:38
#, js-format
msgid "This site now uses %s’s settings."
msgstr "Este site agora usa as configurações do %s."

#: assets/build/settings.js:38
msgid "The lines are removed. Reload Nginx so it stops serving them."
msgstr "As linhas foram removidas. Recarregue o Nginx para que ele pare de servi-las."

#: assets/build/settings.js:38
msgid "The lines are removed."
msgstr "As linhas foram removidas."

#: assets/build/settings.js:38
msgid "Settings saved."
msgstr "Configurações salvas."

#: assets/build/settings.js:38
msgid "The images waiting are on their way."
msgstr "As imagens em espera estão a caminho."

#: assets/build/settings.js:38
msgid "Your account's images for the day are still used up."
msgstr "As imagens do dia da sua conta continuam esgotadas."

#: assets/build/settings.js:38
msgid "Iminify disconnected the network, so new uploads on its sites aren't optimized. Connect it again to carry on."
msgstr "O Iminify desconectou a rede, então os novos envios nos sites dela não são otimizados. Conecte-a novamente para continuar."

#: assets/build/settings.js:38
msgid "Iminify disconnected the network, so new uploads aren't optimized. A super admin connects it again in the network admin."
msgstr "O Iminify desconectou a rede, então os novos envios não são otimizados. Um super administrador a conecta novamente no painel da rede."

#: assets/build/settings.js:38
msgid "Iminify disconnected this site, so new uploads aren't optimized. Join the network again, or connect the site on its own, to carry on."
msgstr "O Iminify desconectou este site, então os novos envios não são otimizados. Entre na rede novamente, ou conecte o site individualmente, para continuar."

#: assets/build/settings.js:38
msgid "Iminify disconnected this site, so new uploads aren't optimized. Connect it again to carry on."
msgstr "O Iminify desconectou este site, então os novos envios não são otimizados. Conecte-o novamente para continuar."
