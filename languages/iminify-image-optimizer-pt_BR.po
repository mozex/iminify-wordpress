msgstr[1] "Varreduras de página restantes hoje: %1$s de %2$s. Cada auditoria conta como uma."

#. translators: %s: the date and time more page scans come.
#: assets/build/audit.js:6
#, js-format
msgid "Your page scans for today are used up. More come on %s."
msgstr "Suas varreduras de página de hoje acabaram. Novas varreduras ficam disponíveis em %s."

