#: includes/admin/class-media-view.php:707
#, php-format
msgid "Saved %1$s (%2$s) across %3$s file."
msgid_plural "Saved %1$s (%2$s) across %3$s files."
msgstr[0] "Ušetřeno %1$s (%2$s) za %3$s soubor."
msgstr[1] "Ušetřeno %1$s (%2$s) za %3$s soubory."
msgstr[2] "Ušetřeno %1$s (%2$s) za %3$s souborů."

#: includes/admin/class-media-view.php:714
msgid "The originals were already smaller, so they were kept."
msgstr "Originály už byly menší, takže zůstaly zachovány."

#. translators: %s: the formats made, such as "WebP, AVIF".
#: includes/admin/class-media-view.php:723
#, php-format
msgid "Copies: %s"
msgstr "Kopie: %s"

#. translators: %s: the formats missing, such as "AVIF".
#: includes/admin/class-media-view.php:737
#, php-format
msgid "Missing formats: %s"
msgstr "Chybějící formáty: %s"

#. translators: %s: the sizes missing, by their names.
#: includes/admin/class-media-view.php:749
#, php-format
msgid "Missing sizes: %s"
msgstr "Chybějící velikosti: %s"

#. translators: %s: how many copies.
#: includes/admin/class-media-view.php:761
#, php-format
msgid "%s WebP or AVIF copy another tool made was kept as it is."
msgid_plural "%s WebP or AVIF copies another tool made were kept as they are."
msgstr[0] "%s kopie WebP nebo AVIF vytvořená jiným nástrojem zůstala beze změny."
msgstr[1] "%s kopie WebP nebo AVIF vytvořené jiným nástrojem zůstaly beze změny."
msgstr[2] "%s kopií WebP nebo AVIF vytvořených jiným nástrojem zůstalo beze změny."

#. translators: %s: how many files.
#: includes/admin/class-media-view.php:771
#, php-format
msgid "%s file couldn't be written."
msgid_plural "%s files couldn't be written."
msgstr[0] "%s soubor se nepodařilo zapsat."
msgstr[1] "%s soubory se nepodařilo zapsat."
msgstr[2] "%s souborů se nepodařilo zapsat."

#. translators: 1: another image optimizer's name, 2: the percentage saved, such as 34%, 3: the bytes saved, such as 1.2 MB.
#: includes/admin/class-media-view.php:815
#, php-format
msgid "%1$s saved %2$s (%3$s), as it recorded it."
msgstr "Podle záznamů pluginu %1$s ušetřeno %2$s (%3$s)."

#: includes/admin/class-media-view.php:824
msgid "Its original is kept. Iminify leaves the image as it is, and it costs nothing."
msgstr "Jeho originál zůstal zachován. Iminify obrázek ponechá, jak je, a nic vás to nestojí."

#: includes/admin/class-media-view.php:825
msgid "No original of it was kept, so Iminify leaves it as it is rather than compress it a second time."
msgstr "Jeho originál se nezachoval, a proto ho Iminify ponechá, jak je, místo aby ho komprimovalo podruhé."

#: includes/admin/class-media-view.php:841
msgid "Queued"
msgstr "Ve frontě"

#: includes/admin/class-media-view.php:843
msgid "Being optimized"
msgstr "Optimalizuje se"

#: includes/admin/class-media-view.php:845
#: assets/build/bulk.js:7
#: assets/build/folders.js:8
