#: includes/class-reasons.php:187
msgid "Kept as it is: this site leaves this image out."
msgstr "Ponecháno beze změny: tento web tento obrázek vynechává."

#: includes/class-reasons.php:189
msgid "The image couldn't be read."
msgstr "Obrázek se nepodařilo přečíst."

#: includes/class-reasons.php:191
msgid "The image isn't in the uploads folder."
msgstr "Obrázek není ve složce uploads."

#: includes/class-reasons.php:193
msgid "Not sent: the image's file isn't in the uploads folder."
msgstr "Neodesláno: soubor obrázku není ve složce uploads."

#: includes/class-reasons.php:195
msgid "Not sent: the image's file isn't there, or is a link to another place."
msgstr "Neodesláno: soubor obrázku chybí, nebo je to odkaz na jiné místo."

#: includes/class-reasons.php:197
msgid "The image's file or its backup went missing while it was on its way."
msgstr "Soubor obrázku nebo jeho záloha zmizely, zatímco byl obrázek na cestě."

#: includes/class-reasons.php:199
msgid "Not sent: the image is no longer in a folder Iminify optimizes."
msgstr "Neodesláno: obrázek už není ve složce, kterou Iminify optimalizuje."

#: includes/class-reasons.php:201
msgid "Not written: the image is no longer in a folder Iminify optimizes."
msgstr "Nezapsáno: obrázek už není ve složce, kterou Iminify optimalizuje."

#: includes/class-reasons.php:203
msgid "Changed since Iminify optimized it, so it can be optimized again."
msgstr "Od optimalizace v Iminify se změnil, takže ho lze optimalizovat znovu."

#: includes/class-reasons.php:205
msgid "The image changed while Iminify was optimizing it, so it's sent again."
msgstr "Obrázek se změnil, zatímco ho Iminify optimalizovalo, takže se odešle znovu."

#. translators: %d: the id of the attachment whose files this one shares.
#: includes/class-reasons.php:209
#, php-format
msgid "Its files are attachment #%d's, as a translation's are, so Iminify optimizes them there."
msgstr "Jeho soubory patří příloze #%d, jak je to u překladů běžné, takže je Iminify optimalizuje tam."

#: includes/class-reasons.php:224
msgid "The backup of this image couldn't be saved, so it wasn't optimized. Check that WordPress can write to the uploads folder, or turn backups off in the Iminify settings."
msgstr "Zálohu tohoto obrázku se nepodařilo uložit, takže nebyl optimalizován. Zkontrolujte, že WordPress může zapisovat do složky uploads, nebo vypněte zálohy v nastavení Iminify."

#: includes/class-reasons.php:226
msgid "The image changed since its backup was made, and the old backup couldn't be moved aside, so it wasn't optimized."
msgstr "Obrázek se od vytvoření zálohy změnil a starou zálohu se nepodařilo odsunout stranou, takže nebyl optimalizován."

#: includes/class-reasons.php:228
msgid "The image couldn't be copied back from WP Offload Media's bucket to send it."
msgstr "Obrázek se nepodařilo zkopírovat zpět z bucketu WP Offload Media, aby se mohl odeslat."

#: includes/class-reasons.php:230
msgid "Iminify couldn't finish this image after several tries."
msgstr "Iminify nedokázalo tento obrázek dokončit ani po několika pokusech."

#: includes/class-reasons.php:232
msgid "Restored: the original is back."
msgstr "Obnoveno: originál je zpět."

#: includes/class-reasons.php:234
msgid "The image couldn't be restored."
msgstr "Obrázek se nepodařilo obnovit."

#: includes/class-reasons.php:236
msgid "The original couldn't be copied back from WP Offload Media's bucket, so the image stays as it was. Try again."
msgstr "Originál se nepodařilo zkopírovat zpět z bucketu WP Offload Media, takže obrázek zůstává, jak byl. Zkuste to znovu."

#: includes/class-reasons.php:238
msgid "The original couldn't be put back, so the image stays as it was."
msgstr "Originál se nepodařilo vrátit, takže obrázek zůstává, jak byl."

#: includes/class-reasons.php:240
msgid "WordPress couldn't read the original, so the image's sizes stay as they were. Try again."
msgstr "WordPress nemohl přečíst originál, takže velikosti obrázku zůstávají, jak byly. Zkuste to znovu."

#: includes/class-reasons.php:246
msgid "Iminify hasn't changed this image, so there's nothing to restore."
msgstr "Iminify tento obrázek nezměnilo, takže není co obnovit."

#: includes/class-reasons.php:248
msgid "Iminify changed nothing in this image, so it already is as it was."
msgstr "Iminify na tomto obrázku nic nezměnilo, takže už je takový, jaký byl."

#: includes/class-reasons.php:250
msgid "This image has changed since Iminify optimized it, so restoring it would overwrite the new one."
msgstr "Tento obrázek se od optimalizace v Iminify změnil, takže by jeho obnovení přepsalo ten nový."

#: includes/class-reasons.php:252
msgid "This image has changed since Iminify optimized it, so its backup is no longer its original."
msgstr "Tento obrázek se od optimalizace v Iminify změnil, takže jeho záloha už není jeho originálem."

#: includes/class-reasons.php:254
msgid "The image's file isn't there any more, or isn't in a folder Iminify optimizes."
msgstr "Soubor obrázku už neexistuje, nebo není ve složce, kterou Iminify optimalizuje."

#: includes/class-reasons.php:256
msgid "No original of this image was kept, so it can't be restored. Backups were off when it was optimized, or the backup was deleted."
msgstr "Originál tohoto obrázku se nezachoval, takže ho nelze obnovit. Při jeho optimalizaci byly zálohy vypnuté, nebo byla záloha smazána."

#: includes/class-reasons.php:258
msgid "No original of this image was kept, so it can't be restored."
msgstr "Originál tohoto obrázku se nezachoval, takže ho nelze obnovit."

#. translators: %s: another image optimizer's name, such as Imagify.
#: includes/class-reasons.php:262
#, php-format
msgid "%s kept no original of this image that Iminify can check, so it can't be restored here."
msgstr "Plugin %s si neponechal žádný originál tohoto obrázku, který by Iminify mohlo zkontrolovat, takže ho tu nelze obnovit."

#. translators: %s: the reason the connection failed.
#: includes/class-reasons.php:268
#, php-format
msgid "Iminify couldn't be reached: %s"
msgstr "Iminify nebylo dostupné: %s"

#. translators: %d: the HTTP status Iminify answered.
#: includes/class-reasons.php:274
#, php-format
msgid "Iminify answered with an error (HTTP %d)."
msgstr "Iminify odpovědělo chybou (HTTP %d)."

#: includes/class-reasons.php:280
msgid "This server doesn't have the memory to send an image this large."
msgstr "Tento server nemá dost paměti na odeslání tak velkého obrázku."

#: includes/class-reasons.php:282
msgid "The image couldn't be read from the uploads folder."
msgstr "Obrázek se nepodařilo přečíst ze složky uploads."

#: includes/class-reasons.php:284
msgid "WordPress couldn't store the site key. Press Join the network to try again."
msgstr "WordPress nemohl uložit klíč webu. Klikněte na Připojit se k síti a zkuste to znovu."

#: includes/delivery/class-rules.php:412
msgid "The uploads folder"
msgstr "Složka uploads"

#: includes/folders/class-folders.php:175
msgid "Name a folder inside wp-content, such as themes/your-theme."
msgstr "Uveďte složku uvnitř wp-content, například themes/vase-sablona."

#: includes/folders/class-folders.php:181
msgid "There is no folder at that path inside wp-content."
msgstr "Na této cestě uvnitř wp-content žádná složka není."

#: includes/folders/class-folders.php:185
msgid "That folder is a link to another place, so Iminify leaves it out."
msgstr "Tato složka je odkazem na jiné místo, takže ji Iminify vynechá."

#: includes/folders/class-folders.php:208
msgid "That's the media library's folder: its images are optimized from the media library."
msgstr "To je složka knihovny médií: její obrázky se optimalizují z knihovny médií."

#: includes/folders/class-folders.php:214
msgid "That's the Iminify plugin's own folder, which every update replaces."
msgstr "To je vlastní složka pluginu Iminify, kterou každá aktualizace přepíše."

#: includes/folders/class-folders.php:220
msgid "Other tools keep copies, caches or backups in that folder, so its images aren't the site's own."
msgstr "Jiné nástroje v této složce uchovávají kopie, mezipaměti nebo zálohy, takže její obrázky nejsou vlastními obrázky webu."

#: includes/folders/class-folders.php:225
msgid "That folder holds the media library's files or their backups, which Iminify handles from the media library."
msgstr "Tato složka obsahuje soubory knihovny médií nebo jejich zálohy, které Iminify zpracovává z knihovny médií."

#: includes/folders/class-folders.php:229
msgid "That folder holds hidden files or a project's dependencies, which Iminify leaves alone."
msgstr "Tato složka obsahuje skryté soubory nebo závislosti projektu, které Iminify nechává být."

#: includes/folders/class-folders.php:268
msgid "On a network, other folders are chosen on the main site."
msgstr "V síti webů se další složky volí na hlavním webu."

#. translators: %s: a folder's path inside wp-content.
#: includes/folders/class-folders.php:285
#, php-format
msgid "That folder is already in the list, inside %s."
msgstr "Tato složka už v seznamu je, uvnitř %s."

#: includes/folders/class-folders.php:298
msgid "The list holds as many folders as it can. Remove one, or choose the folder that holds several of them."
msgstr "Seznam už obsahuje tolik složek, kolik může. Jednu odstraňte, nebo zvolte složku, která jich obsahuje několik."

#: includes/folders/class-optimizer.php:151
#: includes/media/class-optimizer.php:298
msgid "Update the Iminify plugin first."
msgstr "Nejdřív aktualizujte plugin Iminify."

#. translators: %s: the date and time the next batch opens.
#: includes/folders/class-optimizer.php:161
#: includes/media/class-optimizer.php:308
#, php-format
msgid "Your account's images for the day are used up. The next batch opens on %s."
msgstr "Dnešní obrázky vašeho účtu jsou vyčerpané. Další dávka se uvolní %s."

#: includes/folders/class-optimizer.php:169
#: includes/media/class-optimizer.php:320
#: includes/media/class-optimizer.php:335
msgid "The server is low on disk space. Free some up, then optimize this image."
msgstr "Na serveru dochází místo na disku. Uvolněte trochu místa a pak tento obrázek optimalizujte."

#: includes/folders/class-optimizer.php:176
#: includes/media/class-optimizer.php:316
msgid "No original of this image was kept, so it can't be optimized again."
msgstr "Originál tohoto obrázku se nezachoval, takže ho nelze znovu optimalizovat."

#: includes/folders/class-optimizer.php:182
msgid "This image is too large to send: past your plan's file size, or more than this server's memory can hold."
msgstr "Tento obrázek je příliš velký k odeslání: přesahuje velikost souboru povolenou vaším tarifem nebo je větší, než pojme paměť tohoto serveru."

#: includes/media/class-alt-text.php:246
msgid "This image already has alt text, or its text is on the way."
msgstr "Tento obrázek už má alternativní text, nebo se jeho text právě připravuje."

#: includes/media/class-bulk.php:224
msgid "A bulk run is already going. Stop it first."
msgstr "Hromadné zpracování už probíhá. Nejdřív ho zastavte."

#: includes/media/class-bulk.php:229
msgid "The files in other folders are optimized, sent again or restored, all of them at once."
msgstr "Soubory v dalších složkách se optimalizují, znovu odesílají nebo obnovují všechny najednou."

#: includes/media/class-bulk.php:233
msgid "Iminify is still looking through your folders. Start again once it has finished."
msgstr "Iminify ještě prochází vaše složky. Začněte znovu, až skončí."

#: includes/media/class-bulk.php:251
msgid "The server is low on disk space. Free some up, then start again."
msgstr "Na serveru dochází místo na disku. Uvolněte trochu místa a pak začněte znovu."

#: includes/media/class-bulk.php:1228
msgid "Choose a folder first."
msgstr "Nejdřív zvolte složku."

#: includes/media/class-bulk.php:1233
msgid "No optimized file is left to restore in your folders."
msgstr "Ve vašich složkách nezbyl žádný optimalizovaný soubor k obnovení."

#: includes/media/class-bulk.php:1235
msgid "No file in your folders failed."
msgstr "Žádný soubor ve vašich složkách neselhal."

#: includes/media/class-bulk.php:1237
msgid "Every file in your folders is already optimized or on its way."
msgstr "Všechny soubory ve vašich složkách jsou už optimalizované, nebo se zpracovávají."

#: includes/media/class-bulk.php:1242
msgid "No optimized image is left to restore."
msgstr "Nezbyl žádný optimalizovaný obrázek k obnovení."

#: includes/media/class-bulk.php:1246
msgid "No image another plugin optimized has an original left to optimize it again from."
msgstr "Žádný obrázek optimalizovaný jiným pluginem nemá originál, ze kterého by šel znovu optimalizovat."

#: includes/media/class-bulk.php:1250
msgid "Every image already has alt text, or its text is on the way."
msgstr "Všechny obrázky už mají alternativní text, nebo se jejich text právě připravuje."

#: includes/media/class-bulk.php:1253
msgid "No optimized image lacks anything your site asks for now."
msgstr "Žádnému optimalizovanému obrázku nechybí nic, co teď váš web požaduje."

#: includes/media/class-bulk.php:1253
msgid "Every image is already optimized or on its way."
msgstr "Všechny obrázky jsou už optimalizované, nebo se zpracovávají."

#: includes/media/class-optimizer.php:219
msgid "This image has changed since Iminify optimized it, so optimize it again instead."
msgstr "Tento obrázek se od optimalizace v Iminify změnil, takže ho místo toho znovu optimalizujte."

#: includes/media/class-optimizer.php:223
msgid "This image lacks nothing your site asks for now."
msgstr "Tomuto obrázku nechybí nic, co teď váš web požaduje."

#: includes/media/class-optimizer.php:330
msgid "This image's original is too large to send: past your plan's file size, or more than this server's memory can hold."
msgstr "Originál tohoto obrázku je příliš velký k odeslání: přesahuje velikost souboru povolenou vaším tarifem nebo je větší, než pojme paměť tohoto serveru."

#: includes/switching/class-converter.php:52
msgid "Deactivate Converter for Media, or turn off \"Conversion of new images\" in its General Settings, under Settings, Converter for Media."
msgstr "Deaktivujte Converter for Media, nebo vypněte „Conversion of new images“ v jeho General Settings v části Nastavení, Converter for Media."

#: includes/switching/class-elementor.php:70
msgid "Deactivate Image Optimizer by Elementor, or turn off \"Optimize new uploads\" under Elementor, Image Optimization, Settings."
msgstr "Deaktivujte Image Optimizer by Elementor, nebo vypněte „Optimize new uploads“ v části Elementor, Image Optimization, Settings."

#: includes/switching/class-elementor.php:194
msgid "Image Optimizer by Elementor converted this image, giving it a new address that your posts now link to, and kept its original beside it. Its own Restore puts the original back, with its address, while that plugin is installed; Iminify doesn't rewrite your posts, so it doesn't restore this image."
msgstr "Image Optimizer by Elementor tento obrázek převedl, dal mu novou adresu, na kterou teď odkazují vaše příspěvky, a jeho originál ponechal vedle něj. Jeho vlastní funkce Restore vrátí originál i s jeho adresou, dokud je ten plugin nainstalovaný. Iminify vaše příspěvky nepřepisuje, a proto tento obrázek neobnoví."

#: includes/switching/class-ewww.php:53
msgid "Deactivate EWWW Image Optimizer."
msgstr "Deaktivujte EWWW Image Optimizer."

#: includes/switching/class-ewww.php:254
msgid "EWWW Image Optimizer kept this image's original on its own servers, for 30 days. Restore it in EWWW Image Optimizer while its key and those days last; Iminify can't fetch it."
msgstr "EWWW Image Optimizer uchoval originál tohoto obrázku na svých serverech po dobu 30 dní. Obnovte ho v EWWW Image Optimizer, dokud platí jeho klíč a neuplyne těch 30 dní; Iminify ho stáhnout nemůže."

#: includes/switching/class-imagify.php:44
msgid "Deactivate Imagify, or turn off \"Auto-Optimize images on upload\" in its settings."
msgstr "Deaktivujte Imagify, nebo v jeho nastavení vypněte „Auto-Optimize images on upload“."

#: includes/switching/class-leftovers.php:160
msgid "Those lines are gone already, or their plugin is on again."
msgstr "Tyto řádky už jsou pryč, nebo je jejich plugin znovu zapnutý."

#: includes/switching/class-leftovers.php:164
msgid "Only someone who can manage the network removes lines every site shares."
msgstr "Řádky, které sdílejí všechny weby, může odstranit jen ten, kdo smí spravovat síť webů."

#: includes/switching/class-leftovers.php:183
msgid "The plugin can’t take these lines out. Remove them by hand."
msgstr "Plugin tyto řádky nedokáže odstranit. Odstraňte je ručně."

#. translators: %s: another image optimizer's name.
#: includes/switching/class-leftovers.php:412
#, php-format
msgid "%s no longer uses them, yet they still answer a browser that reads WebP or AVIF with the copy it made of an image in its own folder, in place of the image, so a visitor can get a copy made before Iminify optimized it."
msgstr "Plugin %s je už nepoužívá, přesto dál odpovídají prohlížeči, který umí WebP nebo AVIF, kopií, kterou plugin vytvořil z obrázku ve své vlastní složce, místo samotného obrázku. Návštěvník tak může dostat kopii vytvořenou předtím, než Iminify obrázek optimalizovalo."

#. translators: %s: another image optimizer's name.
#: includes/switching/class-leftovers.php:414
#, php-format
msgid "%s no longer uses them, yet they still answer a browser that reads WebP or AVIF with whatever WebP or AVIF file is named after an image, however old, in place of the image, so a visitor can get a copy made before Iminify optimized it."
msgstr "Plugin %s je už nepoužívá, přesto dál odpovídají prohlížeči, který umí WebP nebo AVIF, jakýmkoli souborem WebP nebo AVIF pojmenovaným podle obrázku, ať je jakkoli starý, místo samotného obrázku. Návštěvník tak může dostat kopii vytvořenou předtím, než Iminify obrázek optimalizovalo."

#: includes/switching/class-leftovers.php:418
msgid "Nginx keeps them until it is reloaded, so reload it once they are gone."
msgstr "Server Nginx je drží, dokud se znovu nenačte, takže ho po jejich odstranění znovu načtěte."

#: includes/switching/class-leftovers.php:450
msgid "Smush added this rule for the PNG images it turned into JPEG, and it is still among WordPress’s rewrite rules: a request for such a PNG, no longer there, ends on your home page in place of a “not found” answer."
msgstr "Smush přidal toto pravidlo pro obrázky PNG, které převedl na JPEG, a pravidlo je stále mezi pravidly přepisování WordPressu: požadavek na takový PNG, který už neexistuje, skončí na vaší úvodní stránce místo odpovědi „nenalezeno“."

#: includes/switching/class-litespeed.php:65
msgid "Turn off \"Auto Request Cron\" under LiteSpeed Cache, Image Optimization, and \"Auto Rescale Original Images\" under Page Optimization, Media Settings, and let the images it already sent come back, or deactivate LiteSpeed Cache."
msgstr "Vypněte „Auto Request Cron“ v části LiteSpeed Cache, Image Optimization a „Auto Rescale Original Images“ v části Page Optimization, Media Settings a počkejte, až se obrázky, které už plugin odeslal, vrátí, nebo deaktivujte LiteSpeed Cache."

#: includes/switching/class-modern-formats.php:54
msgid "Deactivate Modern Image Formats: no setting of its own stops it."
msgstr "Deaktivujte Modern Image Formats: nemá žádné vlastní nastavení, které by ho zastavilo."

#: includes/switching/class-modern-formats.php:203
msgid "Modern Image Formats replaced this image's files with modern-format ones made from its original, which WordPress keeps. Putting the original back would change the image's addresses and break the posts that link to them, so Iminify doesn't restore it."
msgstr "Modern Image Formats nahradil soubory tohoto obrázku soubory v moderním formátu, vytvořenými z jeho originálu, který WordPress uchovává. Vrácení originálu by změnilo adresy obrázku a rozbilo příspěvky, které na ně odkazují, a proto ho Iminify neobnoví."

#: includes/switching/class-optimole.php:35
msgid "Deactivate Optimole, or choose \"Optimole Cloud and your website\" under Optimole, Settings, Image Storage."
msgstr "Deaktivujte Optimole, nebo zvolte „Optimole Cloud and your website“ v části Optimole, Settings, Image Storage."

#: includes/switching/class-optimole.php:85
msgid "Optimole moved this image to its cloud and deleted its files here. Roll it back in Optimole first (it needs Optimole active and connected), and Iminify can optimize it then."
msgstr "Optimole přesunul tento obrázek do svého cloudu a jeho soubory tady smazal. Nejdřív ho v Optimole vraťte zpět (Optimole musí být aktivní a připojený) a pak ho Iminify může optimalizovat."

#. translators: 1: another image optimizer's name, 2: what to switch off in it, a sentence.
#: includes/switching/class-others.php:169
#, php-format
msgid "%1$s is active and optimizes your uploads itself, so Iminify optimizes nothing while it does, to keep any image from being compressed twice. %2$s"
msgstr "Plugin %1$s je aktivní a sám optimalizuje vaše nahrané obrázky, takže Iminify mezitím nic neoptimalizuje, aby se žádný obrázek nekomprimoval dvakrát. %2$s"

#. translators: %s: another image optimizer's name, such as Imagify.
#: includes/switching/class-others.php:485
#, php-format
msgid "Optimized by %s"
msgstr "Optimalizováno pluginem %s"

#: includes/switching/class-shortpixel.php:63
msgid "Deactivate ShortPixel, or turn off \"Optimize media on upload\" in its settings, under Processing."
msgstr "Deaktivujte ShortPixel, nebo v jeho nastavení v části Processing vypněte „Optimize media on upload“."

#: includes/switching/class-smush.php:45
msgid "Deactivate Smush, or turn off \"Automatic compression\" in its settings."
msgstr "Deaktivujte Smush, nebo v jeho nastavení vypněte „Automatic compression“."

#: includes/switching/class-tinypng.php:47
msgid "Deactivate TinyPNG, or set it to compress new images manually in its settings."
msgstr "Deaktivujte TinyPNG, nebo v jeho nastavení zvolte ruční kompresi nových obrázků."

#. translators: said by screen readers after a link's words.
#: assets/build/audit.js:2
#: assets/build/bulk.js:2
#: assets/build/settings.js:2
