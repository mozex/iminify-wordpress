msgstr "(otevře se na nové záložce)"

#: assets/build/audit.js:2
#: assets/build/bulk.js:2
#: assets/build/folders.js:1
#: assets/build/settings.js:2
msgid "Loading…"
msgstr "Načítání…"

#: assets/build/audit.js:2
#: assets/build/bulk.js:2
#: assets/build/folders.js:1
#: assets/build/settings.js:2
#: assets/build/settings.js:38
msgid "Try again"
msgstr "Zkusit znovu"

#: assets/build/audit.js:2
#: assets/build/folders.js:1
#: assets/build/settings.js:2
msgid "Dismiss"
msgstr "Zavřít"

#: assets/build/audit.js:2
msgid "Iminify is scanning the page."
msgstr "Iminify skenuje stránku."

#: assets/build/audit.js:2
msgid "Your pages now get the missing width, height and alt text as they’re sent. Scan the page again to see it."
msgstr "Vaše stránky teď při odesílání dostávají chybějící šířku, výšku a alternativní text. Uvidíte to, když stránku naskenujete znovu."

#: assets/build/audit.js:2
msgid "Every page, every week"
msgstr "Každá stránka, každý týden"

#: assets/build/audit.js:2
