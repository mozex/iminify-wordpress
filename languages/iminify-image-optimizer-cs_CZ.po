#: assets/build/settings.js:9
msgid "This site's Iminify account is set in wp-config.php."
msgstr "Účet Iminify tohoto webu je nastaven ve wp-config.php."

#: assets/build/settings.js:9
msgid "Your plan on iminify.com"
msgstr "Váš tarif na iminify.com"

#: assets/build/settings.js:9
msgid "The network's key is set in wp-config.php as <code>IMINIFY_API_KEY</code>. To disconnect, remove it there, and disconnect the network under Settings, Sites on iminify.com."
msgstr "Klíč sítě je nastaven ve wp-config.php jako <code>IMINIFY_API_KEY</code>. Chcete-li síť odpojit, odstraňte ho tam a odpojte síť na iminify.com v části Settings, Sites."

#: assets/build/settings.js:9
msgid "The site's key is set in wp-config.php as <code>IMINIFY_API_KEY</code>. To disconnect, remove it there, and disconnect the site under Settings, Sites on iminify.com."
msgstr "Klíč webu je nastaven ve wp-config.php jako <code>IMINIFY_API_KEY</code>. Chcete-li web odpojit, odstraňte ho tam a odpojte web na iminify.com v části Settings, Sites."

#: assets/build/settings.js:9
msgid "Connect your network"
msgstr "Připojte svou síť"

#: assets/build/settings.js:9
msgid "Iminify compresses the images uploaded to every site of this network and makes WebP and AVIF copies of them. Connect the network to your Iminify account once, or create a free account on the way, and each site joins by itself the first time it needs Iminify."
msgstr "Iminify komprimuje obrázky nahrané na všechny weby této sítě a vytváří jejich kopie WebP a AVIF. Připojte síť ke svému účtu Iminify jednou, nebo si cestou vytvořte bezplatný účet, a každý web se připojí sám, jakmile bude Iminify poprvé potřebovat."

#: assets/build/settings.js:9
msgid "Nothing is sent to Iminify until you connect. Connect opens iminify.com in a new tab, where you approve the network."
msgstr "Dokud se nepřipojíte, do Iminify se nic neodesílá. Tlačítko Připojit otevře iminify.com na nové záložce, kde síť schválíte."

#: assets/build/settings.js:9
msgid "Connect the network"
msgstr "Připojit síť"

#: assets/build/settings.js:9
msgid "Connect this site on its own"
msgstr "Připojit tento web samostatně"

#: assets/build/settings.js:9
msgid "This site can connect to an Iminify account of its own instead, and then never uses the network's connection."
msgstr "Tento web se místo toho může připojit k vlastnímu účtu Iminify a pak už připojení sítě nikdy nepoužívá."

#: assets/build/settings.js:9
msgid "Connect opens iminify.com in a new tab, where you approve this site."
msgstr "Tlačítko Připojit otevře iminify.com na nové záložce, kde tento web schválíte."

#: assets/build/settings.js:9
msgid "Connect your site"
msgstr "Připojte svůj web"

#: assets/build/settings.js:9
msgid "Iminify compresses the images you upload and makes WebP and AVIF copies of them. Connect this site to your Iminify account, or create a free account on the way, to start."
msgstr "Iminify komprimuje obrázky, které nahrajete, a vytváří jejich kopie WebP a AVIF. Pro začátek připojte tento web ke svému účtu Iminify, nebo si cestou vytvořte bezplatný účet."

#: assets/build/settings.js:9
msgid "Nothing is sent to Iminify until you connect. Connect opens iminify.com in a new tab, where you approve this site."
msgstr "Dokud se nepřipojíte, do Iminify se nic neodesílá. Tlačítko Připojit otevře iminify.com na nové záložce, kde tento web schválíte."

#: assets/build/settings.js:9
msgid "A super admin can connect the whole network from the network admin instead, and every site joins it by itself."
msgstr "Správce sítě webů může místo toho připojit celou síť z administrace sítě webů a každý web se k ní připojí sám."

#: assets/build/settings.js:9
msgid "How connecting works"
msgstr "Jak funguje připojení"

#: assets/build/settings.js:9
#: assets/build/settings.js:37
msgid "Waiting for your approval"
msgstr "Čeká na vaše schválení"

#: assets/build/settings.js:9
msgid "Approve the connection on iminify.com, in the tab that opened. This page connects by itself once you do, and the site carries on connecting if you close it."
msgstr "Schvalte připojení na iminify.com na záložce, která se otevřela. Jakmile to uděláte, tato stránka se připojí sama, a pokud ji zavřete, web se bude připojovat dál."

#: assets/build/settings.js:9
msgid "Open the page on iminify.com again"
msgstr "Znovu otevřít stránku na iminify.com"

#: assets/build/settings.js:9
msgid "An agency can add the site under <a>Settings, Sites</a> on iminify.com and paste its key here, or set it in wp-config.php as <code>IMINIFY_API_KEY</code>."
msgstr "Agentura může web přidat na iminify.com v části <a>Settings, Sites</a> a vložit sem jeho klíč, nebo ho nastavit ve wp-config.php jako <code>IMINIFY_API_KEY</code>."

#: assets/build/settings.js:9
msgid "An agency can add the site under Settings, Sites on iminify.com and paste its key here, or set it in wp-config.php as <code>IMINIFY_API_KEY</code>."
msgstr "Agentura může web přidat na iminify.com v části Settings, Sites a vložit sem jeho klíč, nebo ho nastavit ve wp-config.php jako <code>IMINIFY_API_KEY</code>."

#: assets/build/settings.js:9
msgid "An agency adds the network under <a>Settings, Sites</a> on iminify.com, with This is a multisite network ticked, and pastes its key here, or sets it in wp-config.php as <code>IMINIFY_API_KEY</code>."
msgstr "Agentura přidá síť na iminify.com v části <a>Settings, Sites</a> se zaškrtnutou volbou This is a multisite network a vloží sem její klíč, nebo ho nastaví ve wp-config.php jako <code>IMINIFY_API_KEY</code>."

#: assets/build/settings.js:9
msgid "An agency adds the network under Settings, Sites on iminify.com, with This is a multisite network ticked, and pastes its key here, or sets it in wp-config.php as <code>IMINIFY_API_KEY</code>."
msgstr "Agentura přidá síť na iminify.com v části Settings, Sites se zaškrtnutou volbou This is a multisite network a vloží sem její klíč, nebo ho nastaví ve wp-config.php jako <code>IMINIFY_API_KEY</code>."

#: assets/build/settings.js:9
msgid "Each upload is optimized in the background"
msgstr "Každý nahraný obrázek se optimalizuje na pozadí"

#: assets/build/settings.js:9
msgid "WordPress finishes the upload first, then Iminify compresses the image and every size WordPress made of it."
msgstr "WordPress nejdřív dokončí nahrávání, pak Iminify zkomprimuje obrázek a všechny velikosti, které z něj WordPress vytvořil."

#: assets/build/settings.js:9
msgid "An upload counts as one image"
msgstr "Nahraný obrázek se počítá jako jeden obrázek"

#: assets/build/settings.js:9
msgid "The sizes WordPress made of it and its WebP and AVIF copies come with it as files, never as more images."
msgstr "Velikosti, které z něj WordPress vytvořil, a jeho kopie WebP a AVIF se k němu počítají jako soubory, nikdy jako další obrázky."

#: assets/build/settings.js:9
msgid "Your originals stay on this site"
msgstr "Vaše originály zůstávají na tomto webu"

#: assets/build/settings.js:9
msgid "A backup of each one is kept in the uploads folder, so any image can be put back as it was."
msgstr "Záloha každého z nich se uchovává ve složce uploads, takže jakýkoli obrázek lze vrátit do původního stavu."

#: assets/build/settings.js:9
msgid "Your library goes when you say so"
msgstr "Vaše knihovna přijde na řadu, až řeknete"

#: assets/build/settings.js:9
msgid "Images already in the media library wait until you start them under Media, Bulk Optimization."
msgstr "Obrázky, které už jsou v knihovně médií, počkají, dokud je nespustíte v části Média, Hromadná optimalizace."

#: assets/build/settings.js:9
msgid "Once you connect"
msgstr "Jakmile se připojíte"

#: assets/build/settings.js:9
msgid "Connect with the network's key"
msgstr "Připojit pomocí klíče sítě"

#: assets/build/settings.js:9
msgid "Connect with a site key"
msgstr "Připojit pomocí klíče webu"

#: assets/build/settings.js:9
msgid "Network key"
msgstr "Klíč sítě"

#: assets/build/settings.js:9
msgid "Site key"
msgstr "Klíč webu"

#: assets/build/settings.js:9
msgid "Connect with this key"
msgstr "Připojit s tímto klíčem"

#: assets/build/settings.js:9
msgid "becomes"
msgstr "se změní na"

#: assets/build/settings.js:9
msgid "no change"
msgstr "beze změny"

#. translators: %s: another image optimizer's name.
#: assets/build/settings.js:10
#, js-format
msgid "%s’s settings"
msgstr "Nastavení pluginu %s"

#. translators: %s: another image optimizer's name.
#: assets/build/settings.js:11
#, js-format
msgid "Iminify found %s’s settings on this site. It can set this site’s settings to match them, as far as Iminify has the same settings: the compression level, the maximum width, metadata, WebP and AVIF copies, the sizes and backups. You see what changes before anything does."
msgstr "Iminify na tomto webu našlo nastavení pluginu %s. Může podle nich upravit nastavení tohoto webu, pokud má Iminify stejná nastavení: úroveň komprese, maximální šířku, metadata, kopie WebP a AVIF, velikosti a zálohy. Co se změní, uvidíte dřív, než se cokoli změní."

#. translators: %s: another image optimizer's name.
#: assets/build/settings.js:12
#, js-format
msgid "Use %s’s settings"
msgstr "Použít nastavení pluginu %s"

#: assets/build/settings.js:12
msgid "No thanks"
msgstr "Ne, děkuji"

#. translators: %s: another image optimizer's name.
#: assets/build/settings.js:13
#, js-format
msgid "This site already uses what %s’s settings match."
msgstr "Tento web už používá to, čemu odpovídá nastavení pluginu %s."

#. translators: %s: another image optimizer's name.
#: assets/build/settings.js:14
#, js-format
msgid "From %s’s settings, Iminify would set these. Nothing changes until you use them, and using them replaces the changes you haven’t saved in the settings below."
msgstr "Podle nastavení pluginu %s by Iminify nastavilo toto. Nic se nezmění, dokud je nepoužijete, a jejich použití nahradí změny, které jste v nastavení níže neuložili."

#. translators: %s: another image optimizer's name.
#: assets/build/settings.js:15
#, js-format
msgid "From %s’s settings, Iminify would set these. Nothing changes until you use them."
msgstr "Podle nastavení pluginu %s by Iminify nastavilo toto. Nic se nezmění, dokud je nepoužijete."

#. translators: %s: another image optimizer's name.
#: assets/build/settings.js:16
#, js-format
msgid "None of %s’s settings has a match in Iminify, so this site keeps its own."
msgstr "Žádné z nastavení pluginu %s nemá v Iminify obdobu, takže si tento web ponechá svá vlastní."

#: assets/build/settings.js:16
msgid "Use these settings"
msgstr "Použít tato nastavení"

#: assets/build/settings.js:16
msgid "OK"
msgstr "OK"

#: assets/build/settings.js:16
msgid "Open the network's Iminify settings"
msgstr "Otevřít nastavení Iminify pro síť"

#: assets/build/settings.js:16
msgid "The network's connection"
msgstr "Připojení sítě"

#: assets/build/settings.js:16
msgid "This is the network's main site, so it uses the network's connection to Iminify. A super admin connects and disconnects the network in the network admin."
msgstr "Toto je hlavní web sítě, takže používá připojení sítě k Iminify. Síť připojuje a odpojuje správce sítě webů v administraci sítě webů."

#: assets/build/settings.js:16
msgid "This is the network's main site, so it uses the network's connection to Iminify, which isn't made yet. A super admin connects the network in the network admin, and every site joins it by itself."
msgstr "Toto je hlavní web sítě, takže používá připojení sítě k Iminify, které ještě není vytvořené. Správce sítě webů připojí síť v administraci sítě webů a každý web se k ní připojí sám."

#: assets/build/settings.js:16
msgid "The network's sites"
msgstr "Weby sítě"

#: assets/build/settings.js:16
msgid "This key was made for a single site, so the network's sites can't join with it. Disconnect, then connect the network again, or make a key under Settings, Sites on iminify.com with This is a multisite network ticked."
msgstr "Tento klíč byl vytvořen pro jeden web, takže se s ním weby sítě nemohou připojit. Odpojte síť a pak ji připojte znovu, nebo vytvořte klíč na iminify.com v části Settings, Sites se zaškrtnutou volbou This is a multisite network."

#: assets/build/settings.js:16
msgid "Each site of the network joins by itself the first time it needs Iminify, with a key of its own, and starts with the main site's settings. Each counts as a site of its own on your account. A site disconnected on its own page, or under Settings, Sites on iminify.com, doesn't join again by itself."
msgstr "Každý web sítě se připojí sám s vlastním klíčem, jakmile bude poprvé potřebovat Iminify, a začne s nastavením hlavního webu. Každý se na vašem účtu počítá jako samostatný web. Web odpojený na své vlastní stránce nebo na iminify.com v části Settings, Sites se sám znovu nepřipojí."

#: assets/build/settings.js:16
msgid "Each site's settings are on its own Settings, Iminify page. The images in themes and other folders are the main site's to optimize, once for the whole network."
msgstr "Nastavení každého webu je na jeho vlastní stránce Nastavení, Iminify. Obrázky v šablonách a dalších složkách optimalizuje hlavní web, jednou pro celou síť."

#: assets/build/settings.js:16
msgid "The main site's settings"
msgstr "Nastavení hlavního webu"

#: assets/build/settings.js:16
msgid "The main site's other folders"
msgstr "Další složky hlavního webu"

#: assets/build/settings.js:16
msgid "How a network connects"
msgstr "Jak se síť připojuje"

#: assets/build/settings.js:16
#: assets/build/settings.js:17
msgid "Join the network"
msgstr "Připojit se k síti"

#. translators: %s: the network's name.
#: assets/build/settings.js:17
#, js-format
msgid "%s is connected to Iminify. This site can join it with a key of its own, and counts as a site of its own on the account."
msgstr "Síť %s je připojena k Iminify. Tento web se k ní může připojit s vlastním klíčem a na účtu se počítá jako samostatný web."

#: assets/build/settings.js:17
msgid "In WordPress’s rewrite rules:"
msgstr "V pravidlech přepisování WordPressu:"

#: assets/build/settings.js:17
msgid "In <file />:"
msgstr "V souboru <file />:"

#. translators: %s: another image optimizer's name.
#: assets/build/settings.js:18
#, js-format
msgid "Take %s’s rule out of WordPress’s rewrite rules? Every other rule stays."
msgstr "Odstranit pravidlo pluginu %s z pravidel přepisování WordPressu? Všechna ostatní pravidla zůstanou."

#. translators: %s: another image optimizer's name.
#: assets/build/settings.js:19
#, js-format
msgid "Remove %s’s lines from this file? Everything else in it stays as it is. Nginx keeps them until it is reloaded, so reload it afterwards."
msgstr "Odstranit řádky pluginu %s z tohoto souboru? Vše ostatní v něm zůstane beze změny. Server Nginx je drží, dokud se znovu nenačte, takže ho potom znovu načtěte."

#. translators: %s: another image optimizer's name.
#: assets/build/settings.js:20
#, js-format
msgid "Remove %s’s lines from this file? Everything else in it stays as it is."
msgstr "Odstranit řádky pluginu %s z tohoto souboru? Vše ostatní v něm zůstane beze změny."

#. translators: %s: the first line of another plugin's block, such as "# BEGIN EWWWIO".
#: assets/build/settings.js:21
#, js-format
msgid "<file /> holds the line %s, but the block it starts has no end of its own, or runs across another block, so the plugin leaves the file alone. Remove the block’s lines by hand."
msgstr "Soubor <file /> obsahuje řádek %s, ale blok, který tento řádek začíná, nemá vlastní konec nebo zasahuje do jiného bloku, takže plugin soubor nechá být. Odstraňte řádky bloku ručně."

#: assets/build/settings.js:21
msgid "The plugin can’t write to <file />. Remove these lines from it by hand, then reload Nginx."
msgstr "Plugin nemůže zapisovat do souboru <file />. Odstraňte z něj tyto řádky ručně a pak znovu načtěte server Nginx."

#: assets/build/settings.js:21
msgid "The plugin can’t write to <file />. Remove these lines from it by hand."
msgstr "Plugin nemůže zapisovat do souboru <file />. Odstraňte z něj tyto řádky ručně."

#: assets/build/settings.js:21
msgid "Every site of the network shares these lines, so someone who can manage the network removes them, from the network admin’s Iminify settings."
msgstr "Tyto řádky sdílejí všechny weby sítě, takže je odstraňuje ten, kdo smí spravovat síť webů, v nastavení Iminify v administraci sítě webů."

#: assets/build/settings.js:21
msgid "Every site of the network shares these lines, so a super admin removes them, on this page."
msgstr "Tyto řádky sdílejí všechny weby sítě, takže je odstraňuje správce sítě webů na této stránce."

#. translators: %s: another image optimizer's name.
#: assets/build/settings.js:22
#, js-format
msgid "%s’s rewrite rule"
msgstr "Pravidlo přepisování pluginu %s"

#. translators: %s: another image optimizer's name.
#: assets/build/settings.js:23
#, js-format
msgid "%s’s rules"
msgstr "Pravidla pluginu %s"

#: assets/build/settings.js:23
msgid "Rules another optimizer left"
msgstr "Pravidla, která zanechal jiný optimalizátor"

#: assets/build/settings.js:23
msgid "The rules another optimizer left are gone."
msgstr "Pravidla, která zanechal jiný optimalizátor, jsou odstraněna."

#: assets/build/settings.js:23
msgid "An image optimizer you had before left these rules behind when it was switched off. Iminify never removes another plugin’s rules by itself."
msgstr "Optimalizátor obrázků, který jste dříve používali, tato pravidla po svém vypnutí zanechal. Iminify nikdy samo neodstraňuje pravidla jiného pluginu."

#. translators: %d: how many images.
#: assets/build/settings.js:24
#, js-format
msgid "%d image is being optimized."
msgid_plural "%d images are being optimized."
msgstr[0] "%d obrázek se optimalizuje."
msgstr[1] "%d obrázky se optimalizují."
msgstr[2] "%d obrázků se optimalizuje."

#. translators: %d: how many images.
#: assets/build/settings.js:25
#, js-format
msgid "%d image is waiting for the next batch."
msgid_plural "%d images are waiting for the next batch."
msgstr[0] "%d obrázek čeká na další dávku."
msgstr[1] "%d obrázky čekají na další dávku."
msgstr[2] "%d obrázků čeká na další dávku."

#. translators: %d: how many images.
#: assets/build/settings.js:26
#, js-format
msgid "%d image is waiting for the site to be connected. It goes out by itself once it is."
msgid_plural "%d images are waiting for the site to be connected. They go out by themselves once it is."
msgstr[0] "%d obrázek čeká na připojení webu. Odešle se sám, jakmile bude web připojen."
msgstr[1] "%d obrázky čekají na připojení webu. Odešlou se samy, jakmile bude web připojen."
msgstr[2] "%d obrázků čeká na připojení webu. Odešlou se samy, jakmile bude web připojen."

#. translators: %s: the date and time the next batch opens.
#: assets/build/settings.js:27
#, js-format
msgid "The next batch opens on %s. New uploads go first, by themselves."
msgstr "Další dávka se uvolní %s. Nově nahrané obrázky půjdou automaticky jako první."

#: assets/build/settings.js:27
msgid "Queue"
msgstr "Fronta"

#: assets/build/settings.js:27
msgid "The server is low on disk space, so Iminify has stopped optimizing images here. Free some up, then optimize the images marked \"Not optimized\"."
msgstr "Na serveru dochází místo na disku, takže Iminify tu přestalo optimalizovat obrázky. Uvolněte trochu místa a pak optimalizujte obrázky označené „Neoptimalizováno“."

#: assets/build/settings.js:27
msgid "Your server answered with an error once the rules were in, so the plugin took them out again and your images load as before. Ask your host whether .htaccess files may set rewrite rules and file types, or choose picture tags."
msgstr "Jakmile byla pravidla přidána, váš server odpověděl chybou, takže je plugin zase odstranil a vaše obrázky se načítají jako dřív. Zeptejte se poskytovatele hostingu, zda soubory .htaccess smějí nastavovat pravidla přepisování a typy souborů, nebo zvolte značky picture."

#. translators: %s: the date and time of the last check.
#: assets/build/settings.js:28
#, js-format
msgid "Your server sends the WebP and AVIF copies. Checked %s."
msgstr "Váš server posílá kopie WebP a AVIF. Zkontrolováno %s."

#. translators: %s: the date and time of the last check.
#: assets/build/settings.js:30
#, js-format
msgid "Your server still sends the originals: something answers for images before these rules are read, often Nginx in front of Apache. Add the Nginx lines below to its configuration, or choose picture tags. Checked %s."
msgstr "Váš server stále posílá originály: na obrázky odpovídá něco dřív, než se tato pravidla přečtou, často server Nginx před serverem Apache. Přidejte řádky pro Nginx níže do jeho konfigurace, nebo zvolte značky picture. Zkontrolováno %s."

#. translators: %s: the date and time of the last check.
#: assets/build/settings.js:32
#, js-format
msgid "Your server still sends the originals. Add the lines below to its configuration and reload Nginx, then save again. Checked %s."
msgstr "Váš server stále posílá originály. Přidejte řádky níže do jeho konfigurace a znovu načtěte server Nginx, pak znovu uložte. Zkontrolováno %s."

#. translators: %s: the date and time of the last check.
#: assets/build/settings.js:34
#, js-format
msgid "Cloudflare answered with the original, so a visitor may never get a copy through these rules. Choose picture tags, which work behind Cloudflare. Checked %s."
msgstr "Služba Cloudflare odpověděla originálem, takže návštěvník přes tato pravidla možná nikdy nedostane kopii. Zvolte značky picture, které fungují i za službou Cloudflare. Zkontrolováno %s."

#. translators: %s: the date and time of the last check.
#: assets/build/settings.js:35
#, js-format
msgid "The plugin couldn't ask your site for an image to see whether the rules work, which happens when a site can't reach its own address. Open one of your images with a browser's developer tools: its type should read image/avif or image/webp. Tried %s."
msgstr "Plugin se nemohl zeptat vašeho webu na obrázek a ověřit, zda pravidla fungují, což se stává, když web nedosáhne na vlastní adresu. Otevřete některý ze svých obrázků v nástrojích pro vývojáře v prohlížeči: jeho typ by měl být image/avif nebo image/webp. Zkoušeno %s."

#: assets/build/settings.js:35
msgid "The rules are in <file />."
msgstr "Pravidla jsou v souboru <file />."

#. translators: <file /> is the file's path, <begin /> and <end /> the first and last lines of the plugin's block in it (such as "# BEGIN Iminify"), <closing /> the line </IfModule>.
#: assets/build/settings.js:36
msgid "<file /> holds the line <begin /> without its <end /> line, so the plugin leaves the file alone. Put the line <end /> back after the block’s last <closing />, or delete every line of the block, then save again."
msgstr "Soubor <file /> obsahuje řádek <begin /> bez řádku <end />, takže plugin soubor nechá být. Vraťte řádek <end /> za poslední <closing /> bloku, nebo smažte všechny řádky bloku, a pak znovu uložte."

#: assets/build/settings.js:36
msgid "Your uploads folder isn't inside the folder that holds the site's .htaccess file, so no rule there can name it. Choose picture tags."
msgstr "Vaše složka uploads není uvnitř složky, ve které je soubor .htaccess webu, takže na ni žádné pravidlo v něm nedosáhne. Zvolte značky picture."

#: assets/build/settings.js:36
msgid "There’s no <file /> yet. Create it with these lines, then save again."
msgstr "Soubor <file /> zatím neexistuje. Vytvořte ho s těmito řádky a pak znovu uložte."

#: assets/build/settings.js:36
msgid "<file /> doesn’t turn on rewriting, so the plugin leaves it alone. If your server reads rewrite rules there, paste these lines into it, then save again."
msgstr "Soubor <file /> nezapíná přepisování, takže ho plugin nechá být. Pokud váš server čte pravidla přepisování odtud, vložte do něj tyto řádky a pak znovu uložte."

#: assets/build/settings.js:36
msgid "The plugin can’t write to <file />. Paste these lines into it, above the rules WordPress gave the network, then save again."
msgstr "Plugin nemůže zapisovat do souboru <file />. Vložte do něj tyto řádky nad pravidla, která WordPress dal síti, a pak znovu uložte."

#: assets/build/settings.js:36
msgid "The plugin can’t write to <file />. Paste these lines at its end, then save again."
msgstr "Plugin nemůže zapisovat do souboru <file />. Vložte tyto řádky na jeho konec a pak znovu uložte."

#: assets/build/settings.js:36
msgid "Your server reads neither .htaccess files nor Nginx's configuration, so the plugin has no rules to give it. Choose picture tags."
msgstr "Váš server nečte soubory .htaccess ani konfiguraci serveru Nginx, takže mu plugin nemá jaká pravidla dát. Zvolte značky picture."

#: assets/build/settings.js:36
msgid "Your site runs on Nginx, which doesn't read .htaccess. Put the first lines at the top of the site's server block, before any if or rewrite, and the location above any other location for images, then reload Nginx. Copy into the location any expires, Cache-Control or add_header lines your images need, since its add_header replaces the server block's:"
msgstr "Váš web běží na serveru Nginx, který .htaccess nečte. Vložte první řádky na začátek bloku server vašeho webu, před jakékoli if nebo rewrite, a blok location nad jakýkoli jiný location pro obrázky, pak znovu načtěte server Nginx. Do bloku location zkopírujte všechny řádky expires, Cache-Control nebo add_header, které vaše obrázky potřebují, protože jeho add_header nahrazuje ty z bloku server:"

#: assets/build/settings.js:36
msgid "For Nginx, put the first lines at the top of the site's server block, before any if or rewrite, and the location above any other location for images, then reload Nginx. Copy into the location any expires, Cache-Control or add_header lines your images need, since its add_header replaces the server block's:"
msgstr "Pro server Nginx vložte první řádky na začátek bloku server vašeho webu, před jakékoli if nebo rewrite, a blok location nad jakýkoli jiný location pro obrázky, pak znovu načtěte server Nginx. Do bloku location zkopírujte všechny řádky expires, Cache-Control nebo add_header, které vaše obrázky potřebují, protože jeho add_header nahrazuje ty z bloku server:"

#. translators: %s: the folders the rules cover, separated by commas.
#: assets/build/settings.js:37
#, js-format
msgid "They cover: %s."
msgstr "Pokrývají: %s."

#: assets/build/settings.js:37
msgid "They serve any WebP or AVIF copy named after an image beside it, so a copy another optimizer left there is served too until Iminify makes its own. Iminify never deletes another plugin’s copies."
msgstr "Doručují jakoukoli kopii WebP nebo AVIF pojmenovanou podle obrázku vedle něj, takže se doručuje i kopie, kterou tam nechal jiný optimalizátor, dokud Iminify nevytvoří vlastní. Iminify nikdy nemaže kopie jiného pluginu."

#: assets/build/settings.js:37
msgid "Cloudflare answers for your site. It keeps one version of each image whatever the browser reads, so a browser that can't show AVIF could get the AVIF copy. Choose picture tags, which work behind any CDN."
msgstr "Váš web obsluhuje služba Cloudflare. Uchovává jednu verzi každého obrázku bez ohledu na to, co prohlížeč umí, takže prohlížeč, který neumí zobrazit AVIF, může dostat kopii AVIF. Zvolte značky picture, které fungují za jakoukoli CDN."

#: assets/build/settings.js:37
msgid "WP Offload Media serves your images from its bucket, which these rules never reach, so those keep their originals. With its “Remove Local Media” on, the rules serve nothing."
msgstr "WP Offload Media doručuje vaše obrázky ze svého bucketu, kam tato pravidla nikdy nedosáhnou, takže tam zůstávají originály. Se zapnutou volbou „Remove Local Media“ pravidla nedoručují nic."

#: assets/build/settings.js:37
msgid "Also reaches the images in raw HTML, page builders and your theme's own markup, the backgrounds set in the page itself, and the images in the folders you chose, by reading each page as it's sent. A background set in a stylesheet file keeps its original. A page your cache hasn't kept takes a little longer."
msgstr "Zasáhne také obrázky v čistém HTML, page builderech a vlastním kódu vaší šablony, pozadí nastavená přímo ve stránce a obrázky ve složkách, které jste zvolili, protože čte každou stránku při jejím odesílání. Pozadí nastavené v souboru stylů zůstane u originálu. Stránka, kterou vaše mezipaměť neuchovala, se načte o trochu déle."

#: assets/build/settings.js:37
msgid "Your pages stay as they are, and your server sends the WebP or AVIF copy in place of the image to each browser that reads it. That reaches every image in the uploads folder and the folders you chose, backgrounds in stylesheet files too. Needs rules in your server’s configuration, written for you on Apache, and behind a CDN, one that keeps a version of each image per format."
msgstr "Vaše stránky zůstanou beze změny a váš server pošle každému prohlížeči, který umí WebP nebo AVIF, místo obrázku jeho kopii. Zasáhne to všechny obrázky ve složce uploads a ve složkách, které jste zvolili, včetně pozadí v souborech stylů. Vyžaduje pravidla v konfiguraci serveru, na serveru Apache napsaná za vás, a za CDN takovou, která uchovává verzi každého obrázku pro každý formát."

#: assets/build/settings.js:37
msgid "Your pages stay as they are: the copies are made, but no page names them."
msgstr "Vaše stránky zůstanou beze změny: kopie se vytvoří, ale žádná stránka je nepoužije."

#: assets/build/settings.js:37
msgid "For the images in your posts and those your theme shows through WordPress. Each page is the same for every visitor, so page caches and CDNs keep working, and a browser that reads neither format gets the original."
msgstr "Pro obrázky ve vašich příspěvcích a ty, které vaše šablona zobrazuje přes WordPress. Každá stránka je pro všechny návštěvníky stejná, takže mezipaměti stránek a CDN dál fungují, a prohlížeč, který neumí ani jeden z formátů, dostane originál."

#: assets/build/settings.js:37
msgid "Optimization"
msgstr "Optimalizace"

#: assets/build/settings.js:37
msgid "These settings are kept with the site on iminify.com, which applies them to every image the site sends."
msgstr "Tato nastavení se ukládají u webu na iminify.com, kde se použijí na každý obrázek, který web odešle."

#: assets/build/settings.js:37
msgid "Send each image to Iminify as it is uploaded."
msgstr "Odesílat každý obrázek do Iminify hned při nahrání."

#: assets/build/settings.js:37
msgid "A WebP copy of every size, served to browsers that read it. A copy larger than its image isn't kept."
msgstr "Kopie WebP každé velikosti, doručovaná prohlížečům, které ji umí přečíst. Kopie větší než její obrázek se neuchová."

#: assets/build/settings.js:37
msgid "An AVIF copy of every size too: usually smaller than WebP, and slower to make."
msgstr "Navíc kopie AVIF každé velikosti: obvykle menší než WebP a pomalejší na vytvoření."

#: assets/build/settings.js:37
msgid "Any width"
msgstr "Libovolná šířka"

#: assets/build/settings.js:37
msgid "Shrinks a wider main image to this width. Leave it empty to keep each image's width."
msgstr "Zmenší širší hlavní obrázek na tuto šířku. Pokud pole necháte prázdné, každý obrázek si ponechá svou šířku."

#: assets/build/settings.js:37
msgid "Fits the main image under this size. Leave it empty for no limit."
msgstr "Zmenší hlavní obrázek tak, aby se vešel pod tuto velikost. Pokud pole necháte prázdné, limit se nepoužije."

#: assets/build/settings.js:37
msgid "Keeps each image's EXIF data, such as the camera and the place it was taken. Off removes it."
msgstr "Zachová data EXIF každého obrázku, například fotoaparát a místo pořízení. Když je vypnuto, data se odstraní."

#: assets/build/settings.js:37
msgid "Describes each image that has no alt text. An alt text you wrote is never replaced. A small copy of the image goes to Anthropic's AI, and each one counts against your AI alt texts for the day."
msgstr "Popíše každý obrázek, který nemá alternativní text. Alternativní text, který jste napsali, se nikdy nenahradí. Zmenšená kopie obrázku se odešle AI společnosti Anthropic a každý popis se započítá do vašich dnešních alternativních textů od AI."

#: assets/build/settings.js:37
msgid "Language of the alt text"
msgstr "Jazyk alternativního textu"

#: assets/build/settings.js:37
msgid "Optimize every size"
msgstr "Optimalizovat všechny velikosti"

#: assets/build/settings.js:37
msgid "Every size WordPress makes of an upload. Turn it off to pick the sizes."
msgstr "Všechny velikosti, které WordPress vytváří z nahraného obrázku. Vypněte, chcete-li velikosti vybrat."

#: assets/build/settings.js:37
msgid "On this site"
msgstr "Na tomto webu"

#: assets/build/settings.js:37
msgid "Kept in the uploads folder under iminify-backup, so any image can be restored as it was."
msgstr "Uchovávají se ve složce uploads v adresáři iminify-backup, takže jakýkoli obrázek lze obnovit do původního stavu."

#: assets/build/settings.js:37
msgid "WebP and AVIF on your pages"
msgstr "WebP a AVIF na vašich stránkách"

#: assets/build/settings.js:37
msgid "Serve them with picture tags"
msgstr "Doručovat je pomocí značek picture"

#: assets/build/settings.js:37
msgid "Serve them on the whole page"
msgstr "Doručovat je na celé stránce"

#: assets/build/settings.js:37
msgid "Serve them through server rules"
msgstr "Doručovat je pomocí pravidel serveru"

#: assets/build/settings.js:37
msgid "Don't change the pages"
msgstr "Neměnit stránky"

#: assets/build/settings.js:37
msgid "Add the width, height and alt text images lack"
msgstr "Doplňovat chybějící šířku, výšku a alternativní text obrázků"

#: assets/build/settings.js:37
msgid "Where a page’s markup leaves them out of an image from your media library, the plugin adds its width and height, so the page doesn’t jump as it loads, and the alt text it has in the library, as each page is sent. An alt text left empty on purpose stays empty."
msgstr "Pokud kód stránky u obrázku z vaší knihovny médií vynechá šířku a výšku, plugin je při odesílání každé stránky doplní, aby stránka při načítání neposkakovala, a stejně tak doplní alternativní text, který má obrázek v knihovně. Alternativní text úmyslně ponechaný prázdný zůstane prázdný."

#: assets/build/settings.js:37
msgid "When you delete the plugin"
msgstr "Když plugin smažete"

#: assets/build/settings.js:37
msgid "Also delete the WebP and AVIF copies"
msgstr "Smazat také kopie WebP a AVIF"

#: assets/build/settings.js:37
msgid "A page your cache kept with picture tags would show a broken image until the cache is cleared."
msgstr "Stránka, kterou vaše mezipaměť uložila se značkami picture, by zobrazovala nefunkční obrázek, dokud se mezipaměť nevymaže."

#: assets/build/settings.js:37
msgid "Also delete the backups"
msgstr "Smazat také zálohy"

#: assets/build/settings.js:37
msgid "They're the only originals of the images Iminify optimized, so those images can't be restored afterwards. With the copies deleted too, installing the plugin again would optimize those images a second time."
msgstr "Jsou to jediné originály obrázků, které Iminify optimalizovalo, takže tyto obrázky už pak nepůjde obnovit. Pokud smažete i kopie, nová instalace pluginu by tyto obrázky optimalizovala podruhé."

#: assets/build/settings.js:37
msgid "Save changes"
msgstr "Uložit změny"

#: assets/build/settings.js:37
msgid "Unsaved changes"
msgstr "Neuložené změny"

#: assets/build/settings.js:37
msgid "Needs attention"
msgstr "Vyžaduje pozornost"

#: assets/build/settings.js:37
msgid "The network is connected."
msgstr "Síť je připojena."

#: assets/build/settings.js:37
msgid "The site is connected."
msgstr "Web je připojen."

#: assets/build/settings.js:37
msgid "The connection wasn't approved in time, or was turned down. Press Connect the network to try again."
msgstr "Připojení nebylo včas schváleno, nebo bylo odmítnuto. Klikněte na Připojit síť a zkuste to znovu."

#: assets/build/settings.js:37
msgid "The connection wasn't approved in time, or was turned down. Press Connect to try again."
msgstr "Připojení nebylo včas schváleno, nebo bylo odmítnuto. Klikněte na Připojit a zkuste to znovu."

#: assets/build/settings.js:37
msgid "The network is disconnected here, but its key couldn't be stopped on Iminify. Disconnect it under Settings, Sites on iminify.com too."
msgstr "Síť je tady odpojena, ale její klíč se v Iminify nepodařilo zneplatnit. Odpojte ji také na iminify.com v části Settings, Sites."

#: assets/build/settings.js:37
msgid "The site is disconnected here, but its key couldn't be stopped on Iminify. Disconnect it under Settings, Sites on iminify.com too."
msgstr "Web je tady odpojen, ale jeho klíč se v Iminify nepodařilo zneplatnit. Odpojte ho také na iminify.com v části Settings, Sites."

#: assets/build/settings.js:37
msgid "The site joined the network."
msgstr "Web se připojil k síti."

#: assets/build/settings.js:37
msgid "Move the connection here"
msgstr "Přesunout připojení sem"

#: assets/build/settings.js:37
msgid "Connect this copy as its own site"
msgstr "Připojit tuto kopii jako samostatný web"

#. translators: %s: another image optimizer's name.
#: assets/build/settings.js:38
#, js-format
msgid "This site now uses %s’s settings."
msgstr "Tento web teď používá nastavení pluginu %s."

#: assets/build/settings.js:38
msgid "The lines are removed. Reload Nginx so it stops serving them."
msgstr "Řádky jsou odstraněny. Znovu načtěte server Nginx, aby je přestal používat."

#: assets/build/settings.js:38
msgid "The lines are removed."
msgstr "Řádky jsou odstraněny."

#: assets/build/settings.js:38
msgid "Settings saved."
msgstr "Nastavení bylo uloženo."

#: assets/build/settings.js:38
msgid "The images waiting are on their way."
msgstr "Čekající obrázky se odesílají."

#: assets/build/settings.js:38
msgid "Your account's images for the day are still used up."
msgstr "Dnešní obrázky vašeho účtu jsou stále vyčerpané."

#: assets/build/settings.js:38
msgid "Iminify disconnected the network, so new uploads on its sites aren't optimized. Connect it again to carry on."
msgstr "Iminify síť odpojilo, takže se nově nahrané obrázky na jejích webech neoptimalizují. Chcete-li pokračovat, znovu ji připojte."

#: assets/build/settings.js:38
msgid "Iminify disconnected the network, so new uploads aren't optimized. A super admin connects it again in the network admin."
msgstr "Iminify síť odpojilo, takže se nově nahrané obrázky neoptimalizují. Správce sítě webů ji znovu připojí v administraci sítě webů."

#: assets/build/settings.js:38
msgid "Iminify disconnected this site, so new uploads aren't optimized. Join the network again, or connect the site on its own, to carry on."
msgstr "Iminify tento web odpojilo, takže se nově nahrané obrázky neoptimalizují. Chcete-li pokračovat, znovu se připojte k síti, nebo web připojte samostatně."

#: assets/build/settings.js:38
msgid "Iminify disconnected this site, so new uploads aren't optimized. Connect it again to carry on."
msgstr "Iminify tento web odpojilo, takže se nově nahrané obrázky neoptimalizují. Chcete-li pokračovat, znovu ho připojte."
