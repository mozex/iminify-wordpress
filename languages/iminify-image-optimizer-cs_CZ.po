#: assets/build/audit.js:11
#: assets/build/folders.js:8
msgctxt "the status of one image"
msgid "Not optimized"
msgstr "Neoptimalizováno"

#: includes/admin/class-media-view.php:889
msgid "The next batch is open, so it goes out shortly."
msgstr "Další dávka už je uvolněná, takže se obrázek brzy odešle."

#. translators: %s: the date and time the next batch opens.
#: includes/admin/class-media-view.php:891
#, php-format
msgid "It goes out by itself on %s."
msgstr "Odešle se automaticky %s."

#: includes/admin/class-media-view.php:911
#: includes/admin/class-media-view.php:912
msgid "Alt text: being written."
msgstr "Alternativní text: právě se píše."

#: includes/admin/class-media-view.php:913
msgid "Alt text: written by Iminify."
msgstr "Alternativní text: napsalo ho Iminify."

#: includes/admin/class-media-view.php:914
msgid "Alt text: yours was kept."
msgstr "Alternativní text: váš zůstal zachován."

#: includes/admin/class-media-view.php:915
msgid "Alt text: Iminify couldn't write one for this image."
msgstr "Alternativní text: Iminify ho pro tento obrázek nedokázalo napsat."

#: includes/admin/class-media-view.php:916
msgid "Alt text: not written, as the day's AI alt texts were used up."
msgstr "Alternativní text: nebyl napsán, protože dnešní alternativní texty od AI jsou vyčerpané."

#: includes/admin/class-media-view.php:942
msgid "This image carries Content Credentials, a signed record of where it came from, and its files keep them."
msgstr "Tento obrázek nese Content Credentials, podepsaný záznam o svém původu, a jeho soubory je zachovávají."

#: includes/admin/class-media-view.php:944
msgid "This image carried Content Credentials, a signed record of where it came from. The files and copies Iminify wrote leave them out, since a new file breaks their signature, and the original kept as a backup still has them."
msgstr "Tento obrázek nesl Content Credentials, podepsaný záznam o svém původu. Soubory a kopie, které Iminify zapsalo, je neobsahují, protože nový soubor jejich podpis naruší. Originál uložený jako záloha je ale stále má."

#: includes/admin/class-media-view.php:946
msgid "This image carried Content Credentials, a signed record of where it came from. The files and copies Iminify wrote leave them out, since a new file breaks their signature."
msgstr "Tento obrázek nesl Content Credentials, podepsaný záznam o svém původu. Soubory a kopie, které Iminify zapsalo, je neobsahují, protože nový soubor jejich podpis naruší."

#: includes/admin/class-media-view.php:950
msgid "They say generative AI made it, wholly or in part."
msgstr "Podle nich obrázek zcela nebo zčásti vytvořila generativní AI."

#: includes/admin/class-media-view.php:985
#: includes/admin/class-media-view.php:1005
msgid "WebP"
msgstr "WebP"

#: includes/admin/class-media-view.php:986
#: includes/admin/class-media-view.php:1006
msgid "AVIF"
msgstr "AVIF"

#. translators: 1: the formats, such as "WebP, AVIF", 2: the image optimizers that made them, such as "EWWW Image Optimizer".
#: includes/admin/class-media-view.php:1023
#, php-format
msgid "Its pages are served the %1$s copies %2$s made, until Iminify makes its own."
msgstr "Stránky s tímto obrázkem dostávají kopie %1$s od %2$s, dokud Iminify nevytvoří vlastní."

#: includes/admin/class-media-view.php:1053
#: includes/audit/class-fixes.php:149
msgid "Full Size"
msgstr "Původní velikost"

#. translators: %s: the compression level, such as Smart.
#: includes/admin/class-media-view.php:1082
#, php-format
msgid "Level: %s"
msgstr "Úroveň: %s"

#: includes/admin/class-media-view.php:1090
msgid "Size"
msgstr "Velikost"

#: includes/admin/class-media-view.php:1091
msgid "Before"
msgstr "Před"

#: includes/admin/class-media-view.php:1092
msgid "After"
msgstr "Po"

#: includes/admin/class-media-view.php:1093
msgid "Copies"
msgstr "Kopie"

#: includes/admin/class-media-view.php:1139
#: assets/build/audit.js:11
#: assets/build/bulk.js:25
#: assets/build/settings.js:37
msgid "Write alt text with AI"
msgstr "Napsat alternativní text pomocí AI"

#: includes/admin/class-media-view.php:1139
msgid "Send a small copy of this image to write its alt text? It counts as one of your AI alt texts for the day."
msgstr "Odeslat zmenšenou kopii tohoto obrázku, aby se k němu napsal alternativní text? Započítá se jako jeden z vašich dnešních alternativních textů od AI."

#: includes/admin/class-media-view.php:1139
msgid "Write alt text"
msgstr "Napsat alternativní text"

#: includes/admin/class-media-view.php:1158
msgid "Optimize again from the original at"
msgstr "Znovu optimalizovat z originálu na úrovni"

#: includes/admin/class-media-view.php:1186
msgid "Connect the site to Iminify to optimize this image."
msgstr "Připojte web k Iminify, abyste mohli tento obrázek optimalizovat."

#: includes/admin/class-media-view.php:1188
msgid "No original of this image was kept, so it can't be optimized again or restored."
msgstr "Originál tohoto obrázku se nezachoval, takže ho nelze znovu optimalizovat ani obnovit."

#: includes/admin/class-media-view.php:1190
msgid "Optimize again at"
msgstr "Znovu optimalizovat na úrovni"

#: includes/admin/class-media-view.php:1190
msgid "Optimize at"
msgstr "Optimalizovat na úrovni"

#: includes/admin/class-media-view.php:1207
msgid "Make what it lacks"
msgstr "Vytvořit, co chybí"

#: includes/admin/class-media-view.php:1216
msgid "This image has changed since Iminify optimized it, so there's nothing to restore."
msgstr "Tento obrázek se od optimalizace v Iminify změnil, takže není co obnovit."

#: includes/admin/class-media-view.php:1223
msgid "Delete the copies"
msgstr "Smazat kopie"

#: includes/admin/class-media-view.php:1223
msgid "Delete this image's WebP and AVIF copies? Its pages go back to serving the JPEG or PNG."
msgstr "Smazat kopie WebP a AVIF tohoto obrázku? Stránky s ním budou znovu dostávat JPEG nebo PNG."

#: includes/admin/class-media-view.php:1288
#: assets/build/bulk.js:23
msgid "Make the missing formats"
msgstr "Vytvořit chybějící formáty"

#: includes/admin/class-media-view.php:1292
#: assets/build/bulk.js:24
msgid "Make the missing sizes"
msgstr "Vytvořit chybějící velikosti"

#: includes/admin/class-media-view.php:1303
msgid "Send this image again to make what it lacks? This counts as one more image, and its other files stay as they are unless Iminify makes them smaller."
msgstr "Znovu odeslat tento obrázek, aby se vytvořilo, co mu chybí? Započítá se jako další obrázek a jeho ostatní soubory zůstanou beze změny, pokud je Iminify nezmenší."

#: includes/admin/class-media-view.php:1311
msgid "Optimize this image again? Iminify makes its files again from its original, keeping their format and names, and this counts as one more image."
msgstr "Znovu optimalizovat tento obrázek? Iminify znovu vytvoří jeho soubory z originálu se stejným formátem a názvy a započítá se to jako další obrázek."

#: includes/admin/class-media-view.php:1314
msgid "Optimize this image again? Its original goes back first, and this counts as one more image."
msgstr "Znovu optimalizovat tento obrázek? Nejdřív se vrátí jeho originál a započítá se to jako další obrázek."

#: includes/admin/class-media-view.php:1321
msgid "Restore the original of this image? WordPress makes its sizes again, and its WebP and AVIF copies are deleted."
msgstr "Obnovit originál tohoto obrázku? WordPress znovu vytvoří jeho velikosti. Jeho kopie WebP a AVIF se smažou."

#. translators: %s: another image optimizer's name, such as Image Optimizer by Elementor.
#: includes/admin/class-media-view.php:1336
#, php-format
msgid "Optimize this image again from the original %s kept? Iminify makes its files again from it, keeping their format and names so your posts still link to them, and keeps its own backup of the original. This counts as one more image."
msgstr "Znovu optimalizovat tento obrázek z originálu, který si ponechal plugin %s? Iminify z něj znovu vytvoří jeho soubory se stejným formátem a názvy, aby na ně vaše příspěvky dál odkazovaly, a uchová si vlastní zálohu originálu. Započítá se to jako další obrázek."

#. translators: %s: another image optimizer's name, such as Imagify.
#: includes/admin/class-media-view.php:1343
#, php-format
msgid "Optimize this image again from the original %s kept? The original goes back first and WordPress makes its sizes again, then Iminify optimizes it and keeps its own backup of the original. This counts as one more image."
msgstr "Znovu optimalizovat tento obrázek z originálu, který si ponechal plugin %s? Nejdřív se vrátí originál a WordPress znovu vytvoří jeho velikosti, pak ho Iminify optimalizuje a uchová si vlastní zálohu originálu. Započítá se to jako další obrázek."

#. translators: %s: another image optimizer's name, such as Imagify.
#: includes/admin/class-media-view.php:1358
#, php-format
msgid "Restore the original of this image from what %s kept? WordPress makes its sizes again, and that plugin's backups and copies stay where they are."
msgstr "Obnovit originál tohoto obrázku z toho, co si ponechal plugin %s? WordPress znovu vytvoří jeho velikosti. Zálohy a kopie toho pluginu zůstanou, kde jsou."

#: includes/admin/class-notice.php:132
msgid "Iminify disconnected this site, so new uploads aren't optimized."
msgstr "Iminify tento web odpojilo, takže se nově nahrané obrázky neoptimalizují."

#: includes/admin/class-notice.php:133
msgid "Connect it again"
msgstr "Znovu připojit"

#: includes/admin/class-notice.php:137
msgid "Iminify Image Optimizer is ready. Connect it to your Iminify account to start optimizing your images."
msgstr "Iminify Image Optimizer je připraven. Připojte ho ke svému účtu Iminify a začněte optimalizovat obrázky."

#: includes/admin/class-notice.php:138
#: assets/build/settings.js:9
msgid "Connect"
