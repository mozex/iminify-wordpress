msgstr "Soubory ve složkách se zpracují všechny najednou: použijte --folders samostatně."

#: includes/class-cli.php:172
msgid "Put every optimized file in your folders back as it was?"
msgstr "Vrátit všechny optimalizované soubory ve vašich složkách do původního stavu?"

#: includes/class-cli.php:181
