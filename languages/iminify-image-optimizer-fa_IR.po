msgid "Found %1$s image: %2$s new, %3$s changed."
msgid_plural "Found %1$s images: %2$s new, %3$s changed."
msgstr[0] "%1$s تصویر پیدا شد: %2$s جدید، %3$s تغییرکرده."
msgstr[1] "%1$s تصویر پیدا شد: %2$s جدید، %3$s تغییرکرده."

