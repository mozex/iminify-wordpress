#. translators: %s: how many images.
#: assets/build/bulk.js:22
#, js-format
msgid "%s image was restored, and stays as it is: a run never takes an image someone put back. Optimize it again from its panel in the media library."
msgid_plural "%s images were restored, and stay as they are: a run never takes an image someone put back. Optimize one again from its panel in the media library."
msgstr[0] "%s зображення відновлено, і воно залишається як є: обробка ніколи не бере зображення, яке хтось повернув. Оптимізуйте його повторно з його панелі в бібліотеці медіа."
msgstr[1] "%s зображення відновлено, і вони залишаються як є: обробка ніколи не бере зображення, які хтось повернув. Оптимізуйте будь-яке з них повторно з його панелі в бібліотеці медіа."
msgstr[2] "%s зображень відновлено, і вони залишаються як є: обробка ніколи не бере зображення, які хтось повернув. Оптимізуйте будь-яке з них повторно з його панелі в бібліотеці медіа."

#: assets/build/bulk.js:22
msgid "Missing files"
msgstr "Відсутні файли"

#. translators: %s: how many images.
#: assets/build/bulk.js:23
#, js-format
msgid "%s optimized image lacks a format your site asks for now."
msgid_plural "%s optimized images lack a format your site asks for now."
msgstr[0] "%s оптимізованому зображенню бракує формату, якого зараз вимагає ваш сайт."
msgstr[1] "%s оптимізованим зображенням бракує формату, якого зараз вимагає ваш сайт."
msgstr[2] "%s оптимізованим зображенням бракує формату, якого зараз вимагає ваш сайт."

#. translators: %s: how many images.
#: assets/build/bulk.js:24
#, js-format
msgid "%s optimized image may lack a size your site makes now."
msgid_plural "%s optimized images may lack a size your site makes now."
