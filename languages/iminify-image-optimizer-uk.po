#, php-format
msgid "%s WebP or AVIF copy another tool made was kept as it is."
msgid_plural "%s WebP or AVIF copies another tool made were kept as they are."
msgstr[0] "%s копію WebP або AVIF, створену іншим інструментом, залишено як є."
msgstr[1] "%s копії WebP або AVIF, створені іншим інструментом, залишено як є."
msgstr[2] "%s копій WebP або AVIF, створених іншим інструментом, залишено як є."

#. translators: %s: how many files.
#: includes/admin/class-media-view.php:769
