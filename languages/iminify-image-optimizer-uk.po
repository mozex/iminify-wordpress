msgstr[1] "Останній перегляд %1$s: %2$s зображення (нові: %3$s, змінені: %4$s)."
msgstr[2] "Останній перегляд %1$s: %2$s зображень (нові: %3$s, змінені: %4$s)."

#: assets/build/folders.js:4
msgid "Iminify looks again after a theme or plugin update. Look now after changing images by hand."
msgstr "Iminify переглядає теки знову після оновлення теми чи плагіна. Якщо ви змінювали зображення вручну, перегляньте їх зараз."

#: assets/build/folders.js:4
