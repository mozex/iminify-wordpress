msgstr "Iminify scanner siden."

#: assets/build/audit.js:2
msgid "Your pages now get the missing width, height and alt text as they’re sent. Scan the page again to see it."
msgstr "Dine sider får nu den manglende bredde, højde og alt-tekst, når de sendes. Scan siden igen for at se det."

#: assets/build/audit.js:2
msgid "Every page, every week"
msgstr "Alle sider, hver uge"

#: assets/build/audit.js:2
msgid "A weekly check audits every page in your site's sitemap once a week, compresses the images that are new or changed, and emails you what it found. You set it up on iminify.com from a crawl of your site, where you can see which plans include it."
msgstr "Et ugentligt tjek analyserer alle sider i dit websteds sitemap én gang om ugen, komprimerer de billeder, der er nye eller ændrede, og sender dig en e-mail om, hvad det fandt. Du sætter det op på iminify.com ud fra en crawl af dit websted, hvor du også kan se, hvilke planer der omfatter det."

#: assets/build/audit.js:2
msgid "Set up a weekly check"
msgstr "Opsæt et ugentligt tjek"

#: assets/build/audit.js:2
msgid "Couldn't read the page"
msgstr "Kunne ikke læse siden"

#: assets/build/audit.js:2
msgid "Waiting to scan"
msgstr "Venter på scanning"

#: assets/build/audit.js:2
msgid "Scanning"
msgstr "Scanner"

#: assets/build/audit.js:2
msgid "Done"
msgstr "Færdig"

#: assets/build/audit.js:2
msgid "No images"
msgstr "Ingen billeder"

#: assets/build/audit.js:2
#: assets/build/bulk.js:7
msgid "Stopped"
msgstr "Stoppet"

#: assets/build/audit.js:2
msgctxt "the status of a page audit"
msgid "Failed"
msgstr "Mislykket"

#: assets/build/audit.js:2
msgid "Iminify disconnected this site, so its pages can’t be audited. Connect it again to carry on."
msgstr "Iminify har afbrudt forbindelsen til dette websted, så dets sider kan ikke analyseres. Forbind det igen for at fortsætte."

#: assets/build/audit.js:2
msgid "Connect this site to Iminify to audit its pages."
msgstr "Forbind dette websted til Iminify for at analysere dets sider."

#: assets/build/audit.js:2
#: assets/build/bulk.js:17
msgid "Go to the settings"
msgstr "Gå til indstillingerne"

#: assets/build/audit.js:2
msgid "Scan a page"
msgstr "Scan en side"

#: assets/build/audit.js:2
msgid "Iminify opens the page as a visitor would and measures every image it shows."
msgstr "Iminify åbner siden, som en besøgende ville, og måler hvert billede, den viser."

#: assets/build/audit.js:2
msgid "Page"
msgstr "Side"

#: assets/build/audit.js:2
msgid "Another address on this site"
msgstr "En anden adresse på dette websted"

#: assets/build/audit.js:2
msgid "Address"
msgstr "Adresse"

#: assets/build/audit.js:2
msgid "Scan"
msgstr "Scan"

#. translators: %s: how many seconds are left before the next scan.
#: assets/build/audit.js:3
#, js-format
msgid "You can scan again in %s second."
msgid_plural "You can scan again in %s seconds."
msgstr[0] "Du kan scanne igen om %s sekund."
msgstr[1] "Du kan scanne igen om %s sekunder."

#. translators: %s: how many page scans the account used today.
#: assets/build/audit.js:4
#, js-format
msgid "%s page scan used today. Each audit counts as one."
msgid_plural "%s page scans used today. Each audit counts as one."
msgstr[0] "%s sidescanning brugt i dag. Hver analyse tæller som én."
msgstr[1] "%s sidescanninger brugt i dag. Hver analyse tæller som én."

#. translators: 1: how many page scans are left today, 2: how many the account has a day.
#: assets/build/audit.js:5
#, js-format
msgid "%1$s of %2$s page scan left today. Each audit counts as one."
msgid_plural "%1$s of %2$s page scans left today. Each audit counts as one."
msgstr[0] "%1$s af %2$s sidescanning tilbage i dag. Hver analyse tæller som én."
msgstr[1] "%1$s af %2$s sidescanninger tilbage i dag. Hver analyse tæller som én."

#. translators: %s: the date and time more page scans come.
#: assets/build/audit.js:6
#, js-format
msgid "Your page scans for today are used up. More come on %s."
msgstr "Dine sidescanninger for i dag er brugt op. Der kommer flere %s."

#: assets/build/audit.js:6
msgid "Your page scans for today are used up."
msgstr "Dine sidescanninger for i dag er brugt op."

#: assets/build/audit.js:6
msgid "Recent audits"
msgstr "Seneste analyser"

#: assets/build/audit.js:6
msgid "Images on the page"
msgstr "Billeder på siden"

#: assets/build/audit.js:6
msgid "Choose a page and press Scan. Iminify lists every image on it, each beside the image in your library it is, with what is worth fixing."
msgstr "Vælg en side, og tryk på Scan. Iminify viser alle billeder på den, hver ved siden af det billede i dit bibliotek, det svarer til, med det, der er værd at rette."

#: assets/build/audit.js:6
msgid "Iminify is opening the page and measuring its images. This usually takes less than a minute, and the page shows them as soon as they’re in."
msgstr "Iminify åbner siden og måler dens billeder. Det tager som regel under et minut, og de vises her, så snart de er klar."

#: assets/build/audit.js:6
msgid "The page showed no images."
msgstr "Siden viste ingen billeder."

#. translators: 1: how many images the page showed, 2: how many of them have something to fix.
#: assets/build/audit.js:7
#, js-format
msgid "%1$s image on the page, %2$s with something to fix."
msgid_plural "%1$s images on the page, %2$s with something to fix."
msgstr[0] "%1$s billede på siden, %2$s med noget at rette."
msgstr[1] "%1$s billeder på siden, %2$s med noget at rette."

#: assets/build/audit.js:7
msgid "Nothing to fix: every image on this page is sized, loaded and described well."
msgstr "Intet at rette: alle billeder på denne side har den rette størrelse, indlæses rigtigt og er godt beskrevet."

#: assets/build/audit.js:7
msgid "Hide the images with nothing to fix"
msgstr "Skjul billederne uden noget at rette"

#. translators: %s: how many images have nothing to fix.
#: assets/build/audit.js:8
#, js-format
msgid "Show %s image with nothing to fix"
msgid_plural "Show %s images with nothing to fix"
msgstr[0] "Vis %s billede uden noget at rette"
msgstr[1] "Vis %s billeder uden noget at rette"

#. translators: %s: how many images.
#: assets/build/audit.js:9
#, js-format
msgid "%s image from your media library is on this page without its width and height, or without the alt text it has in the library. The plugin can add what’s missing to your pages as they’re sent, from the library."
msgid_plural "%s images from your media library are on this page without their width and height, or without the alt text they have in the library. The plugin can add what’s missing to your pages as they’re sent, from the library."
msgstr[0] "%s billede fra dit mediebibliotek er på denne side uden sin bredde og højde eller uden den alt-tekst, det har i biblioteket. Pluginet kan tilføje det manglende på dine sider ud fra biblioteket, når de sendes."
msgstr[1] "%s billeder fra dit mediebibliotek er på denne side uden deres bredde og højde eller uden den alt-tekst, de har i biblioteket. Pluginet kan tilføje det manglende på dine sider ud fra biblioteket, når de sendes."

#: assets/build/audit.js:9
msgid "Fill them in on every page"
msgstr "Udfyld dem på alle sider"

#: assets/build/audit.js:9
msgid "Someone who can change the plugin’s settings can turn this on."
msgstr "En, der kan ændre pluginets indstillinger, kan slå dette til."

#. translators: 1: a size's name, such as "Medium", 2: its width in pixels, 3: its height in pixels.
#: assets/build/audit.js:10
#, js-format
msgid "Use the %1$s size (%2$s × %3$s) where this image is placed. The page’s editor doesn’t hold it: your theme, a template or a widget shows it, and the size is chosen there."
msgstr "Brug størrelsen %1$s (%2$s × %3$s) der, hvor dette billede er placeret. Sidens editor indeholder det ikke: dit tema, en skabelon eller en widget viser det, og størrelsen vælges der."

#. translators: 1: a size's name, such as "Medium", 2: its width in pixels, 3: its height in pixels.
#: assets/build/audit.js:11
#, js-format
msgid "Use the %1$s size (%2$s × %3$s) here: in the editor, select the image and choose it under Resolution."
msgstr "Brug størrelsen %1$s (%2$s × %3$s) her: vælg billedet i editoren, og vælg størrelsen under Opløsning."

#: assets/build/audit.js:11
msgid "Edit the page"
msgstr "Rediger siden"

#: assets/build/audit.js:11
msgid "The plugin adds them as the page is sent. Scan again to see it."
msgstr "Pluginet tilføjer dem, når siden sendes. Scan igen for at se det."

#: assets/build/audit.js:11
msgid "Iminify is writing the image’s alt text. Scan again once it’s in."
msgstr "Iminify skriver billedets alt-tekst. Scan igen, når den er klar."

#: assets/build/audit.js:11
msgid "Iminify can write it once AI alt text is on for this site."
msgstr "Iminify kan skrive den, når AI-alt-tekst er slået til for dette websted."

#: assets/build/audit.js:11
msgid "Turn it on in the settings"
msgstr "Slå det til i indstillingerne"

#: assets/build/audit.js:11
msgid "Its alt text is on its way. Scan again once it’s in."
msgstr "Billedets alt-tekst er på vej. Scan igen, når den er klar."

#: assets/build/audit.js:11
msgid "Translations share this image, each with an alt text in its own language: write it on the one this page shows, in its edit screen."
