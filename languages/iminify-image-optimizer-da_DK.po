#: assets/build/settings.js:16
msgid "Each site of the network joins by itself the first time it needs Iminify, with a key of its own, and starts with the main site's settings. Each counts as a site of its own on your account. A site disconnected on its own page, or under Settings, Sites on iminify.com, doesn't join again by itself."
msgstr "Hvert websted i netværket tilmelder sig af sig selv, første gang det har brug for Iminify, med sin egen nøgle, og starter med hovedwebstedets indstillinger. Hvert websted tæller som et selvstændigt websted på din konto. Et websted, hvis forbindelse er afbrudt på dets egen side eller under Settings, Sites på iminify.com, tilmelder sig ikke igen af sig selv."

#: assets/build/settings.js:16
msgid "Each site's settings are on its own Settings, Iminify page. The images in themes and other folders are the main site's to optimize, once for the whole network."
msgstr "Hvert websteds indstillinger findes på dets egen side under Indstillinger, Iminify. Billederne i temaer og andre mapper optimeres af hovedwebstedet, én gang for hele netværket."

#: assets/build/settings.js:16
msgid "The main site's settings"
msgstr "Hovedwebstedets indstillinger"

#: assets/build/settings.js:16
msgid "The main site's other folders"
msgstr "Hovedwebstedets andre mapper"

#: assets/build/settings.js:16
msgid "How a network connects"
msgstr "Sådan forbindes et netværk"

#: assets/build/settings.js:16
#: assets/build/settings.js:17
msgid "Join the network"
msgstr "Tilmeld til netværket"

#. translators: %s: the network's name.
#: assets/build/settings.js:17
#, js-format
msgid "%s is connected to Iminify. This site can join it with a key of its own, and counts as a site of its own on the account."
msgstr "%s er forbundet til Iminify. Dette websted kan tilmelde sig det med sin egen nøgle og tæller som et selvstændigt websted på kontoen."

#: assets/build/settings.js:17
msgid "In WordPress’s rewrite rules:"
msgstr "I WordPress' omskrivningsregler:"

#: assets/build/settings.js:17
msgid "In <file />:"
msgstr "I <file />:"

#. translators: %s: another image optimizer's name.
#: assets/build/settings.js:18
#, js-format
msgid "Take %s’s rule out of WordPress’s rewrite rules? Every other rule stays."
msgstr "Fjern den regel, %s tilføjede, fra WordPress' omskrivningsregler? Alle andre regler bliver."

#. translators: %s: another image optimizer's name.
#: assets/build/settings.js:19
#, js-format
msgid "Remove %s’s lines from this file? Everything else in it stays as it is. Nginx keeps them until it is reloaded, so reload it afterwards."
msgstr "Fjern de linjer, %s tilføjede, fra denne fil? Alt andet i den forbliver, som det er. Nginx beholder dem, indtil den genindlæses, så genindlæs den bagefter."

#. translators: %s: another image optimizer's name.
#: assets/build/settings.js:20
#, js-format
msgid "Remove %s’s lines from this file? Everything else in it stays as it is."
msgstr "Fjern de linjer, %s tilføjede, fra denne fil? Alt andet i den forbliver, som det er."

#. translators: %s: the first line of another plugin's block, such as "# BEGIN EWWWIO".
#: assets/build/settings.js:21
#, js-format
msgid "<file /> holds the line %s, but the block it starts has no end of its own, or runs across another block, so the plugin leaves the file alone. Remove the block’s lines by hand."
msgstr "<file /> indeholder linjen %s, men den blok, den starter, har ingen egen afslutning eller løber ind over en anden blok, så pluginet lader filen være. Fjern blokkens linjer manuelt."

#: assets/build/settings.js:21
msgid "The plugin can’t write to <file />. Remove these lines from it by hand, then reload Nginx."
msgstr "Pluginet kan ikke skrive til <file />. Fjern disse linjer fra den manuelt, og genindlæs derefter Nginx."

#: assets/build/settings.js:21
msgid "The plugin can’t write to <file />. Remove these lines from it by hand."
msgstr "Pluginet kan ikke skrive til <file />. Fjern disse linjer fra den manuelt."

#: assets/build/settings.js:21
msgid "Every site of the network shares these lines, so someone who can manage the network removes them, from the network admin’s Iminify settings."
msgstr "Alle websteder i netværket deler disse linjer, så en, der kan administrere netværket, fjerner dem fra Iminify-indstillingerne i netværksadministrationen."

#: assets/build/settings.js:21
msgid "Every site of the network shares these lines, so a super admin removes them, on this page."
msgstr "Alle websteder i netværket deler disse linjer, så en superadministrator fjerner dem på denne side."

#. translators: %s: another image optimizer's name.
#: assets/build/settings.js:22
#, js-format
msgid "%s’s rewrite rule"
msgstr "Omskrivningsregel fra %s"

#. translators: %s: another image optimizer's name.
#: assets/build/settings.js:23
#, js-format
msgid "%s’s rules"
msgstr "Regler fra %s"

#: assets/build/settings.js:23
msgid "Rules another optimizer left"
msgstr "Regler efterladt af et andet optimeringsplugin"

#: assets/build/settings.js:23
msgid "The rules another optimizer left are gone."
msgstr "Reglerne, som et andet optimeringsplugin efterlod, er væk."

#: assets/build/settings.js:23
msgid "An image optimizer you had before left these rules behind when it was switched off. Iminify never removes another plugin’s rules by itself."
msgstr "Et billedoptimeringsplugin, du havde før, efterlod disse regler, da det blev slået fra. Iminify fjerner aldrig et andet plugins regler af sig selv."

#. translators: %d: how many images.
#: assets/build/settings.js:24
#, js-format
msgid "%d image is being optimized."
msgid_plural "%d images are being optimized."
msgstr[0] "%d billede er ved at blive optimeret."
msgstr[1] "%d billeder er ved at blive optimeret."

#. translators: %d: how many images.
#: assets/build/settings.js:25
#, js-format
msgid "%d image is waiting for the next batch."
msgid_plural "%d images are waiting for the next batch."
msgstr[0] "%d billede venter på næste omgang."
msgstr[1] "%d billeder venter på næste omgang."

#. translators: %d: how many images.
#: assets/build/settings.js:26
#, js-format
msgid "%d image is waiting for the site to be connected. It goes out by itself once it is."
msgid_plural "%d images are waiting for the site to be connected. They go out by themselves once it is."
msgstr[0] "%d billede venter på, at webstedet bliver forbundet. Det sendes automatisk, når det er sket."
msgstr[1] "%d billeder venter på, at webstedet bliver forbundet. De sendes automatisk, når det er sket."

#. translators: %s: the date and time the next batch opens.
#: assets/build/settings.js:27
#, js-format
msgid "The next batch opens on %s. New uploads go first, by themselves."
msgstr "Næste omgang åbner %s. Nye uploads sendes automatisk først."

#: assets/build/settings.js:27
msgid "Queue"
msgstr "Kø"

#: assets/build/settings.js:27
msgid "The server is low on disk space, so Iminify has stopped optimizing images here. Free some up, then optimize the images marked \"Not optimized\"."
msgstr "Serveren er ved at løbe tør for diskplads, så Iminify er holdt op med at optimere billeder her. Frigør noget plads, og optimer derefter de billeder, der er markeret “Ikke optimeret”."

#: assets/build/settings.js:27
msgid "Your server answered with an error once the rules were in, so the plugin took them out again and your images load as before. Ask your host whether .htaccess files may set rewrite rules and file types, or choose picture tags."
msgstr "Din server svarede med en fejl, da reglerne var indsat, så pluginet fjernede dem igen, og dine billeder indlæses som før. Spørg din hostingudbyder, om .htaccess-filer må angive omskrivningsregler og filtyper, eller vælg picture-tags."

#. translators: %s: the date and time of the last check.
#: assets/build/settings.js:28
#, js-format
msgid "Your server sends the WebP and AVIF copies. Checked %s."
msgstr "Din server sender WebP- og AVIF-kopierne. Tjekket %s."

#. translators: %s: the date and time of the last check.
#: assets/build/settings.js:30
#, js-format
msgid "Your server still sends the originals: something answers for images before these rules are read, often Nginx in front of Apache. Add the Nginx lines below to its configuration, or choose picture tags. Checked %s."
msgstr "Din server sender stadig originalerne: noget svarer på billeder, før disse regler bliver læst, ofte Nginx foran Apache. Tilføj Nginx-linjerne nedenfor til Nginx' konfiguration, eller vælg picture-tags. Tjekket %s."

#. translators: %s: the date and time of the last check.
#: assets/build/settings.js:32
#, js-format
msgid "Your server still sends the originals. Add the lines below to its configuration and reload Nginx, then save again. Checked %s."
msgstr "Din server sender stadig originalerne. Tilføj linjerne nedenfor til dens konfiguration, genindlæs Nginx, og gem så igen. Tjekket %s."

#. translators: %s: the date and time of the last check.
#: assets/build/settings.js:34
#, js-format
msgid "Cloudflare answered with the original, so a visitor may never get a copy through these rules. Choose picture tags, which work behind Cloudflare. Checked %s."
msgstr "Cloudflare svarede med originalen, så en besøgende får måske aldrig en kopi via disse regler. Vælg picture-tags, som virker bag Cloudflare. Tjekket %s."

#. translators: %s: the date and time of the last check.
#: assets/build/settings.js:35
#, js-format
msgid "The plugin couldn't ask your site for an image to see whether the rules work, which happens when a site can't reach its own address. Open one of your images with a browser's developer tools: its type should read image/avif or image/webp. Tried %s."
msgstr "Pluginet kunne ikke bede dit websted om et billede for at se, om reglerne virker, hvilket sker, når et websted ikke kan nå sin egen adresse. Åbn et af dine billeder med en browsers udviklerværktøjer: dets type skal være image/avif eller image/webp. Forsøgt %s."

#: assets/build/settings.js:35
msgid "The rules are in <file />."
msgstr "Reglerne er i <file />."

#. translators: <file /> is the file's path, <begin /> and <end /> the first and last lines of the plugin's block in it (such as "# BEGIN Iminify"), <closing /> the line </IfModule>.
#: assets/build/settings.js:36
msgid "<file /> holds the line <begin /> without its <end /> line, so the plugin leaves the file alone. Put the line <end /> back after the block’s last <closing />, or delete every line of the block, then save again."
msgstr "<file /> indeholder linjen <begin /> uden sin afsluttende linje <end />, så pluginet lader filen være. Sæt linjen <end /> tilbage efter blokkens sidste <closing />, eller slet alle blokkens linjer, og gem derefter igen."

#: assets/build/settings.js:36
msgid "Your uploads folder isn't inside the folder that holds the site's .htaccess file, so no rule there can name it. Choose picture tags."
msgstr "Din uploads-mappe ligger ikke i den mappe, der indeholder webstedets .htaccess-fil, så ingen regel der kan angive den. Vælg picture-tags."

#: assets/build/settings.js:36
msgid "There’s no <file /> yet. Create it with these lines, then save again."
msgstr "Der er ingen <file /> endnu. Opret den med disse linjer, og gem derefter igen."

#: assets/build/settings.js:36
msgid "<file /> doesn’t turn on rewriting, so the plugin leaves it alone. If your server reads rewrite rules there, paste these lines into it, then save again."
msgstr "<file /> slår ikke omskrivning til, så pluginet lader den være. Hvis din server læser omskrivningsregler der, så indsæt disse linjer i den, og gem derefter igen."

#: assets/build/settings.js:36
msgid "The plugin can’t write to <file />. Paste these lines into it, above the rules WordPress gave the network, then save again."
msgstr "Pluginet kan ikke skrive til <file />. Indsæt disse linjer i den over de regler, WordPress gav netværket, og gem derefter igen."

#: assets/build/settings.js:36
msgid "The plugin can’t write to <file />. Paste these lines at its end, then save again."
msgstr "Pluginet kan ikke skrive til <file />. Indsæt disse linjer i slutningen af den, og gem derefter igen."

#: assets/build/settings.js:36
msgid "Your server reads neither .htaccess files nor Nginx's configuration, so the plugin has no rules to give it. Choose picture tags."
msgstr "Din server læser hverken .htaccess-filer eller Nginx' konfiguration, så pluginet har ingen regler at give den. Vælg picture-tags."

#: assets/build/settings.js:36
msgid "Your site runs on Nginx, which doesn't read .htaccess. Put the first lines at the top of the site's server block, before any if or rewrite, and the location above any other location for images, then reload Nginx. Copy into the location any expires, Cache-Control or add_header lines your images need, since its add_header replaces the server block's:"
msgstr "Dit websted kører på Nginx, som ikke læser .htaccess. Sæt de første linjer øverst i webstedets server-blok, før enhver if eller rewrite, og location over enhver anden location for billeder, og genindlæs derefter Nginx. Kopier alle expires-, Cache-Control- eller add_header-linjer, som dine billeder har brug for, ind i location, da dens add_header erstatter server-blokkens:"

#: assets/build/settings.js:36
msgid "For Nginx, put the first lines at the top of the site's server block, before any if or rewrite, and the location above any other location for images, then reload Nginx. Copy into the location any expires, Cache-Control or add_header lines your images need, since its add_header replaces the server block's:"
msgstr "Til Nginx skal du sætte de første linjer øverst i webstedets server-blok, før enhver if eller rewrite, og location over enhver anden location for billeder, og derefter genindlæse Nginx. Kopier alle expires-, Cache-Control- eller add_header-linjer, som dine billeder har brug for, ind i location, da dens add_header erstatter server-blokkens:"

#. translators: %s: the folders the rules cover, separated by commas.
#: assets/build/settings.js:37
#, js-format
msgid "They cover: %s."
msgstr "De dækker: %s."

#: assets/build/settings.js:37
msgid "They serve any WebP or AVIF copy named after an image beside it, so a copy another optimizer left there is served too until Iminify makes its own. Iminify never deletes another plugin’s copies."
msgstr "De leverer enhver WebP- eller AVIF-kopi, der er opkaldt efter et billede ved siden af det, så en kopi, som et andet optimeringsplugin har efterladt der, også leveres, indtil Iminify laver sin egen. Iminify sletter aldrig et andet plugins kopier."

#: assets/build/settings.js:37
msgid "Cloudflare answers for your site. It keeps one version of each image whatever the browser reads, so a browser that can't show AVIF could get the AVIF copy. Choose picture tags, which work behind any CDN."
msgstr "Cloudflare svarer for dit websted. Det gemmer én version af hvert billede, uanset hvad browseren kan læse, så en browser, der ikke kan vise AVIF, kan få AVIF-kopien. Vælg picture-tags, som virker bag ethvert CDN."

#: assets/build/settings.js:37
msgid "WP Offload Media serves your images from its bucket, which these rules never reach, so those keep their originals. With its “Remove Local Media” on, the rules serve nothing."
msgstr "WP Offload Media leverer dine billeder fra sin bucket, som disse regler aldrig når, så de beholder deres originaler. Med “Remove Local Media” slået til leverer reglerne intet."

#: assets/build/settings.js:37
msgid "Also reaches the images in raw HTML, page builders and your theme's own markup, the backgrounds set in the page itself, and the images in the folders you chose, by reading each page as it's sent. A background set in a stylesheet file keeps its original. A page your cache hasn't kept takes a little longer."
msgstr "Det når også billederne i rå HTML, sidebyggere og dit temas egen markup, de baggrunde, der er angivet i selve siden, og billederne i de mapper, du valgte, ved at læse hver side, når den sendes. En baggrund, der er angivet i en stylesheet-fil, beholder sin original. En side, som din cache ikke har gemt, tager lidt længere tid."

#: assets/build/settings.js:37
msgid "Your pages stay as they are, and your server sends the WebP or AVIF copy in place of the image to each browser that reads it. That reaches every image in the uploads folder and the folders you chose, backgrounds in stylesheet files too. Needs rules in your server’s configuration, written for you on Apache, and behind a CDN, one that keeps a version of each image per format."
msgstr "Dine sider forbliver, som de er, og din server sender WebP- eller AVIF-kopien i stedet for billedet til hver browser, der kan læse den. Det når alle billeder i uploads-mappen og de mapper, du valgte, også baggrunde i stylesheet-filer. Kræver regler i din servers konfiguration, som skrives for dig på Apache, og bag et CDN, at det gemmer en version af hvert billede pr. format."

#: assets/build/settings.js:37
msgid "Your pages stay as they are: the copies are made, but no page names them."
msgstr "Dine sider forbliver, som de er: kopierne laves, men ingen side henviser til dem."

#: assets/build/settings.js:37
msgid "For the images in your posts and those your theme shows through WordPress. Each page is the same for every visitor, so page caches and CDNs keep working, and a browser that reads neither format gets the original."
msgstr "Til billederne i dine indlæg og dem, dit tema viser via WordPress. Hver side er den samme for alle besøgende, så sidecacher og CDN'er fortsætter med at virke, og en browser, der hverken kan læse det ene eller det andet format, får originalen."

#: assets/build/settings.js:37
msgid "Optimization"
msgstr "Optimering"

#: assets/build/settings.js:37
msgid "These settings are kept with the site on iminify.com, which applies them to every image the site sends."
msgstr "Disse indstillinger gemmes sammen med webstedet på iminify.com, som anvender dem på hvert billede, webstedet sender."

#: assets/build/settings.js:37
msgid "Send each image to Iminify as it is uploaded."
msgstr "Send hvert billede til Iminify, når det uploades."

#: assets/build/settings.js:37
msgid "A WebP copy of every size, served to browsers that read it. A copy larger than its image isn't kept."
msgstr "En WebP-kopi af hver størrelse, leveret til browsere, der kan læse den. En kopi, der er større end sit billede, beholdes ikke."

#: assets/build/settings.js:37
msgid "An AVIF copy of every size too: usually smaller than WebP, and slower to make."
msgstr "Også en AVIF-kopi af hver størrelse: som regel mindre end WebP og langsommere at lave."

#: assets/build/settings.js:37
msgid "Any width"
msgstr "Enhver bredde"

#: assets/build/settings.js:37
msgid "Shrinks a wider main image to this width. Leave it empty to keep each image's width."
msgstr "Skalerer et bredere hovedbillede ned til denne bredde. Lad feltet være tomt for at beholde hvert billedes bredde."

#: assets/build/settings.js:37
msgid "Fits the main image under this size. Leave it empty for no limit."
msgstr "Får hovedbilledet ned under denne størrelse. Lad feltet være tomt, hvis der ikke skal være nogen grænse."

#: assets/build/settings.js:37
msgid "Keeps each image's EXIF data, such as the camera and the place it was taken. Off removes it."
msgstr "Beholder hvert billedes EXIF-data, f.eks. kameraet og stedet, hvor det blev taget. Når den er slået fra, fjernes de."

#: assets/build/settings.js:37
msgid "Describes each image that has no alt text. An alt text you wrote is never replaced. A small copy of the image goes to Anthropic's AI, and each one counts against your AI alt texts for the day."
msgstr "Beskriver hvert billede, der ikke har nogen alt-tekst. En alt-tekst, du har skrevet, bliver aldrig erstattet. En lille udgave af billedet sendes til Anthropics AI, og hver enkelt tæller med i dine AI-alt-tekster for i dag."

#: assets/build/settings.js:37
msgid "Language of the alt text"
msgstr "Alt-tekstens sprog"

#: assets/build/settings.js:37
msgid "Optimize every size"
msgstr "Optimer alle størrelser"

#: assets/build/settings.js:37
msgid "Every size WordPress makes of an upload. Turn it off to pick the sizes."
msgstr "Alle de størrelser, WordPress laver af en upload. Slå det fra for at vælge størrelserne."

#: assets/build/settings.js:37
msgid "On this site"
msgstr "På dette websted"

#: assets/build/settings.js:37
msgid "Kept in the uploads folder under iminify-backup, so any image can be restored as it was."
msgstr "Gemmes i uploads-mappen under iminify-backup, så ethvert billede kan genskabes, som det var."

#: assets/build/settings.js:37
msgid "WebP and AVIF on your pages"
msgstr "WebP og AVIF på dine sider"

#: assets/build/settings.js:37
msgid "Serve them with picture tags"
msgstr "Lever dem med picture-tags"

#: assets/build/settings.js:37
msgid "Serve them on the whole page"
msgstr "Lever dem på hele siden"

#: assets/build/settings.js:37
msgid "Serve them through server rules"
msgstr "Lever dem via serverregler"

#: assets/build/settings.js:37
msgid "Don't change the pages"
msgstr "Ændr ikke siderne"

#: assets/build/settings.js:37
msgid "Add the width, height and alt text images lack"
msgstr "Tilføj den bredde, højde og alt-tekst, billederne mangler"

#: assets/build/settings.js:37
msgid "Where a page’s markup leaves them out of an image from your media library, the plugin adds its width and height, so the page doesn’t jump as it loads, and the alt text it has in the library, as each page is sent. An alt text left empty on purpose stays empty."
msgstr "Hvor en sides markup udelader dem for et billede fra dit mediebibliotek, tilføjer pluginet billedets bredde og højde, så siden ikke hopper, mens den indlæses, og den alt-tekst, det har i biblioteket, når hver side sendes. En alt-tekst, der er ladt tom med vilje, forbliver tom."

#: assets/build/settings.js:37
msgid "When you delete the plugin"
msgstr "Når du sletter pluginet"

#: assets/build/settings.js:37
msgid "Also delete the WebP and AVIF copies"
msgstr "Slet også WebP- og AVIF-kopierne"

#: assets/build/settings.js:37
msgid "A page your cache kept with picture tags would show a broken image until the cache is cleared."
msgstr "En side, som din cache har gemt med picture-tags, vil vise et ødelagt billede, indtil cachen er ryddet."

#: assets/build/settings.js:37
msgid "Also delete the backups"
msgstr "Slet også sikkerhedskopierne"

#: assets/build/settings.js:37
msgid "They're the only originals of the images Iminify optimized, so those images can't be restored afterwards. With the copies deleted too, installing the plugin again would optimize those images a second time."
msgstr "De er de eneste originaler af de billeder, Iminify har optimeret, så de billeder kan ikke genskabes bagefter. Hvis kopierne også er slettet, vil en ny installation af pluginet optimere de billeder en gang til."

#: assets/build/settings.js:37
msgid "Save changes"
msgstr "Gem ændringer"

#: assets/build/settings.js:37
msgid "Unsaved changes"
msgstr "Ikke-gemte ændringer"

#: assets/build/settings.js:37
msgid "Needs attention"
msgstr "Kræver opmærksomhed"

#: assets/build/settings.js:37
msgid "The network is connected."
msgstr "Netværket er forbundet."

#: assets/build/settings.js:37
msgid "The site is connected."
msgstr "Webstedet er forbundet."

#: assets/build/settings.js:37
msgid "The connection wasn't approved in time, or was turned down. Press Connect the network to try again."
msgstr "Forbindelsen blev ikke godkendt i tide eller blev afvist. Tryk på Forbind netværket for at prøve igen."

#: assets/build/settings.js:37
msgid "The connection wasn't approved in time, or was turned down. Press Connect to try again."
msgstr "Forbindelsen blev ikke godkendt i tide eller blev afvist. Tryk på Forbind for at prøve igen."

#: assets/build/settings.js:37
msgid "The network is disconnected here, but its key couldn't be stopped on Iminify. Disconnect it under Settings, Sites on iminify.com too."
msgstr "Netværkets forbindelse er afbrudt her, men dets nøgle kunne ikke stoppes hos Iminify. Afbryd også forbindelsen under Settings, Sites på iminify.com."

#: assets/build/settings.js:37
msgid "The site is disconnected here, but its key couldn't be stopped on Iminify. Disconnect it under Settings, Sites on iminify.com too."
msgstr "Webstedets forbindelse er afbrudt her, men dets nøgle kunne ikke stoppes hos Iminify. Afbryd også forbindelsen under Settings, Sites på iminify.com."

#: assets/build/settings.js:37
msgid "The site joined the network."
msgstr "Webstedet tilmeldte sig netværket."

#: assets/build/settings.js:37
msgid "Move the connection here"
msgstr "Flyt forbindelsen hertil"

#: assets/build/settings.js:37
msgid "Connect this copy as its own site"
msgstr "Forbind denne kopi som et selvstændigt websted"

#. translators: %s: another image optimizer's name.
#: assets/build/settings.js:38
#, js-format
msgid "This site now uses %s’s settings."
msgstr "Dette websted bruger nu indstillingerne fra %s."

#: assets/build/settings.js:38
msgid "The lines are removed. Reload Nginx so it stops serving them."
msgstr "Linjerne er fjernet. Genindlæs Nginx, så den holder op med at levere dem."

#: assets/build/settings.js:38
msgid "The lines are removed."
msgstr "Linjerne er fjernet."

#: assets/build/settings.js:38
msgid "Settings saved."
msgstr "Indstillinger gemt."

#: assets/build/settings.js:38
msgid "The images waiting are on their way."
msgstr "De ventende billeder er på vej."

#: assets/build/settings.js:38
msgid "Your account's images for the day are still used up."
msgstr "Din kontos billeder for i dag er stadig brugt op."

#: assets/build/settings.js:38
msgid "Iminify disconnected the network, so new uploads on its sites aren't optimized. Connect it again to carry on."
msgstr "Iminify har afbrudt forbindelsen til netværket, så nye uploads på dets websteder bliver ikke optimeret. Forbind det igen for at fortsætte."

#: assets/build/settings.js:38
msgid "Iminify disconnected the network, so new uploads aren't optimized. A super admin connects it again in the network admin."
