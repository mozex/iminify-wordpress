msgstr "Iminify har afbrudt forbindelsen til dette websted, så nye uploads bliver ikke optimeret."

#: includes/admin/class-notice.php:133
msgid "Connect it again"
msgstr "Forbind det igen"

#: includes/admin/class-notice.php:137
