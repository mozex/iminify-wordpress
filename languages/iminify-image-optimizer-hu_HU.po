#, php-format
msgid "Offloaded by %s"
msgstr "Felhőbe helyezte: %s"

#. translators: 1: the percentage saved, such as 34%, 2: the bytes saved, such as 1.2 MB, 3: how many files it covers.
#: includes/admin/class-media-view.php:707
#, php-format
msgid "Saved %1$s (%2$s) across %3$s file."
msgid_plural "Saved %1$s (%2$s) across %3$s files."
msgstr[0] "Megtakarítás: %1$s (%2$s), %3$s fájlon."
msgstr[1] "Megtakarítás: %1$s (%2$s), %3$s fájlon."

#: includes/admin/class-media-view.php:714
msgid "The originals were already smaller, so they were kept."
msgstr "Az eredetiek már eleve kisebbek voltak, ezért megmaradtak."

#. translators: %s: the formats made, such as "WebP, AVIF".
#: includes/admin/class-media-view.php:723
#, php-format
