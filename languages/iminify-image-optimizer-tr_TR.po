#: includes/admin/class-media-view.php:1023
#, php-format
msgid "Its pages are served the %1$s copies %2$s made, until Iminify makes its own."
msgstr "Iminify kendi kopyalarını oluşturana kadar sayfalarında %2$s tarafından oluşturulan %1$s kopyaları sunulur."

