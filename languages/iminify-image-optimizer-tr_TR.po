#: includes/admin/class-media-view.php:824
msgid "Its original is kept. Iminify leaves the image as it is, and it costs nothing."
msgstr "Özgün hâli saklanıyor. Iminify görseli olduğu gibi bırakır ve bunun için hakkınızdan hiçbir şey düşmez."

#: includes/admin/class-media-view.php:825
msgid "No original of it was kept, so Iminify leaves it as it is rather than compress it a second time."
msgstr "Özgün hâli saklanmadığı için Iminify onu ikinci kez sıkıştırmak yerine olduğu gibi bırakır."

