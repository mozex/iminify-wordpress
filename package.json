{
  "name": "iminify-image-optimizer",
  "private": true,
  "license": "GPL-2.0-or-later",
  "scripts": {
    "build": "wp-scripts build settings=./src/settings/index.js notice=./src/notice.js media=./src/media/index.js --output-path=assets/build",
    "start": "wp-scripts start settings=./src/settings/index.js notice=./src/notice.js media=./src/media/index.js --output-path=assets/build",
    "lint:js": "wp-scripts lint-js src",
    "env": "wp-env",
    "env:test": "wp-env --config=.wp-env.test.json",
    "test:integration": "wp-env --config=.wp-env.test.json run cli --env-cwd=wp-content/plugins/iminify-image-optimizer vendor/bin/phpunit -c phpunit.integration.xml.dist"
  },
  "engines": {
    "node": ">=22.22.2"
  },
  "devDependencies": {
    "@wordpress/env": "^12.1.0",
    "@wordpress/scripts": "^37.0.0"
  }
}
