includes:
    - vendor/szepeviktor/phpstan-wordpress/extension.neon

parameters:
    level: 8
    phpVersion:
        min: 70400
        max: 80599
    paths:
        - iminify-image-optimizer.php
        - includes
        - dev/mu-plugins
        - tests
    excludePaths:
        - tests/phpstan
        - tests/Integration
        - tests/bootstrap-integration.php
        - tests/e2e
        - tests/Support/Wp_Cli_Stub.php
    bootstrapFiles:
        - tests/phpstan/bootstrap.php
    scanFiles:
        - vendor/woocommerce/action-scheduler/functions.php
        - tests/phpstan/wp-cli.php
    scanDirectories:
        - vendor/woocommerce/action-scheduler/classes
