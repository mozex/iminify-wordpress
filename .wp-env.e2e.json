{
  "$schema": "https://schemas.wp.org/trunk/wp-env.json",
  "core": null,
  "phpVersion": "8.3",
  "testsEnvironment": false,
  "port": 8890,
  "plugins": [],
  "config": {
    "DISABLE_WP_CRON": true
  },
  "mappings": {
